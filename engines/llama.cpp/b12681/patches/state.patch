+    // LLAMA_GRAPH_SLOTS=N (MTP contexts only, unset = stock): ubatches of 1..N tokens get a scheduler and graph results
+    // of their own (slot n = n_tokens; slot 0 = the reserved scheduler, all other sizes), so sizes that alternate
+    // every step (draft catch-up of n tokens, then 1-token drafts) each keep a built and allocated graph to reuse.
+    // The loaded slot lives in sched / gf_res_prev / gf_res_prev_active; the others are parked here.
+    struct graph_slot {
+        ggml_backend_sched_ptr              sched;
+        std::array<llm_graph_result_ptr, 2> res;
+        llm_graph_result *                  active = nullptr;
+        bool                                logged = false;
+    };
+    std::vector<graph_slot> gslots;
+    int gslot_cur = 0;
+    int gslot_max = 0;
+    void gslot_select(int i);
+    void gslot_invalidate(); // forget the parked slots' graphs; the loaded one is reset by the caller
+
     // host buffer for the model output (logits and embeddings)
     ggml_backend_buffer_ptr buf_output;
 
