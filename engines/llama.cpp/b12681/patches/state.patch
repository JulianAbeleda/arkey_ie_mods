+void llama_context::gslot_invalidate() {
+    for (int i = 0; i < (int) gslots.size(); ++i) {
+        if (i != gslot_cur) {
+            for (auto & res : gslots[i].res) {
+                if (res) {
+                    res->reset();
+                }
+            }
+            gslots[i].active = nullptr;
+        }
+    }
+}
