+        ggml_backend_sched_set_realloc_callback(nxt.sched.get(), sched_graph_realloc, this);
+        for (auto & res : nxt.res) {
+            res = std::make_unique<llm_graph_result>(graph_max_nodes());
+        }
+        nxt.active = nullptr;
+    }
+    std::swap(sched, nxt.sched);
+    std::swap(gf_res_prev, nxt.res);
+    gf_res_prev_active = nxt.active;
+    gslot_cur = i;
+}
