+    static std::atomic<uint64_t> n_diff{0};
+    static std::atomic<uint64_t> n_tie{0};
+    static std::atomic<uint64_t> n_pos[4] = {}; // backend pick: grammar inert, grammar accepts it; CPU: rejected, other
