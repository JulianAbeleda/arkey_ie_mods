+// LLAMA_GRAMMAR_BACKEND: kind 0 no outputs, 1 copied to the host, 2 left on the device (backend sampling took them)
+void llama_context::gsamp_note(ggml_tensor * t, int kind, int64_t n_outputs_prev, int64_t n_outputs_ub) {
+    if (kind == 0 || gsamp_state == 0) {
+        return;
+    }
+    gsamp_state = kind;
+    gsamp_t     = t;
+    gsamp_row0  = n_outputs_prev;
+    gsamp_n     = n_outputs_ub;
+}
+
+void llama_context::gsamp_spill() {
+    static const bool on = getenv("LLAMA_GRAMMAR_BACKEND") != nullptr && atoi(getenv("LLAMA_GRAMMAR_BACKEND")) > 0;
+    if (gsamp_state != 2) {
+        return;
+    }
+    if (!on || logits.data == nullptr || gsamp_t == nullptr || gsamp_t->buffer == nullptr) {
+        gsamp_state = 0;
+        return;
+    }
+    const int64_t n_vocab = model.vocab.n_tokens();
+    GGML_ASSERT(gsamp_t->ne[0] == n_vocab && gsamp_t->type == GGML_TYPE_F32 && gsamp_t->ne[1] >= gsamp_n &&
+                gsamp_t->nb[1] == n_vocab*sizeof(float));
+    GGML_ASSERT((gsamp_row0 + gsamp_n)*n_vocab <= (int64_t) logits.size);
+    synchronize();
+    ggml_backend_tensor_get(gsamp_t, logits.data + gsamp_row0*n_vocab, 0, gsamp_n*gsamp_t->nb[1]);
+    gsamp_state = 1;
+}
+
+float * llama_context::get_logits_ith_raw(int32_t i) {
+    if (gsamp_state == 1) {
+        return get_logits_ith(i);
+    }
+    if (gsamp_state != 2 || logits.data == nullptr || gsamp_t == nullptr || gsamp_t->buffer == nullptr) {
+        return nullptr;
+    }
+    try {
+        const int64_t j       = output_resolve_row(i); // no reorder pending: swaps spill to the host
+        const int64_t n_vocab = model.vocab.n_tokens();
+        float * dst = logits.data + j*n_vocab;
+        if (j >= gsamp_row0 && j < gsamp_row0 + gsamp_n) {
+            GGML_ASSERT(gsamp_t->ne[0] == n_vocab && gsamp_t->type == GGML_TYPE_F32);
+            ggml_backend_tensor_get(gsamp_t, dst, (j - gsamp_row0)*gsamp_t->nb[1], n_vocab*sizeof(float));
+        }
+        return dst;
+    } catch (const std::exception & err) {
+        LLAMA_LOG_ERROR("%s: invalid logits id %d, reason: %s\n", __func__, i, err.what());
+        return nullptr;
+    }
+}
