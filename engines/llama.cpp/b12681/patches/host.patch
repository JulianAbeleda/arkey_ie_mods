+// LLAMA_GRAMMAR_BACKEND: the backend runs the chain up to the final temp 0 and hands over its candidates; their unique max
+// is the CPU chain's pick only for a greedy chain whose earlier samplers keep the max and every tie of it
+static bool common_gsamp_exact(const common_params_sampling & params, const llama_vocab * vocab) {
+    const auto & smp = params.samplers;
+    // temp > 0 also sends the server's speculative verify to rejection sampling, which reads the candidates' probabilities
+    if (params.temp != 0.0f || params.dynatemp_range != 0.0f || params.mirostat != 0 || params.n_probs != 0 || smp.empty() ||
+        smp.back() != COMMON_SAMPLER_TYPE_TEMPERATURE ||
+        std::count(smp.begin(), smp.end(), COMMON_SAMPLER_TYPE_TEMPERATURE) != 1 ||
+        std::find(smp.begin(), smp.end(), COMMON_SAMPLER_TYPE_ADAPTIVE_P) != smp.end() ||
+        (params.top_k == 1 && std::find(smp.begin(), smp.end(), COMMON_SAMPLER_TYPE_TOP_K) != smp.end())) {
+        return false; // top-k 1 keeps one of two tied tokens
+    }
+    // top-p <= 0.5 can keep one member of a tie at the max (top-p p keeps at least ceil(p / q) of m tokens tied at q <= 1/m)
+    if (params.top_p <= 0.5f && std::find(smp.begin(), smp.end(), COMMON_SAMPLER_TYPE_TOP_P) != smp.end()) {
+        return false;
+    }
+    // penalties: the backend's arithmetic is not the CPU's; neutral penalties do nothing on either side
+    if (params.penalty_last_n != 0 && (params.penalty_repeat != 1.0f || params.penalty_freq != 0.0f || params.penalty_present != 0.0f)) {
+        return false;
+    }
+    // logit bias: the backend writes one bias per token (set_rows), the CPU adds every entry, so a token twice differs
+    std::vector<llama_token> ids;
+    for (const auto & b : params.logit_bias) {
