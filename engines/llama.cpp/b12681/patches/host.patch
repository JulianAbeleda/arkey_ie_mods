+        for (size_t i = 0; i < cur_p.size && unique; ++i) {
+            const float l = cur_p.data[i].logit;
+            if (std::isnan(l)) {
+                unique = false;
+            } else if (best < 0 || l > cur_p.data[best].logit) {
+                best = i;
+            }
+        }
