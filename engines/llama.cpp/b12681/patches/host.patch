index 000000000..6c84810c8
--- /dev/null
+++ b/src/models/qwen4exp-prefetch.cpp
@@ -0,0 +1,55 @@
+// LOCAL (ple-prefetch): kept in its own file so the mod adds no line to the architecture file
+#include "models.h"
+#include "llama-mmap.h"
+#include "llama-model.h"
+
+#include <algorithm>
+#include <vector>
+
+// LOCAL (ple-prefetch): the row ids of llm_graph_input_qwen4exp_ple::set_input, from a flat token list
+void llama_model_qwen4exp::prefetch_inputs(const llama_token * tokens, int32_t n_tokens, int32_t i_first) const {
+    if (tokens == nullptr || i_first >= n_tokens) {
+        return;
+    }
+    const ggml_tensor * ple = per_layer_tok_embd;
+    // nothing to do unless the table is lazily mapped (the same condition set_input uses for its own prefetch)
+    if (ple == nullptr || !can_prefetch.count(ple) || ple->data == nullptr) {
+        return;
+    }
+    const auto & hp = hparams;
+    const int64_t n_gram = hp.ple_ngram_size, n_heads = hp.ple_n_heads, per_gram = hp.ple_heads_per_ngram, eos = hp.ple_eos_token_id;
+    if (n_gram < 2 || n_heads <= 0) {
+        return;
+    }
+    i_first = std::max(i_first, 0);
+    const size_t row_bytes = ggml_row_size(ple->type, ple->ne[0]);
+    const auto * base = (const char *) ple->data;
+    llama_memory_ranges mr;
+    mr.reserve((size_t) (n_tokens - i_first) * n_heads);
+    std::vector<int64_t> ctx(n_gram);
+    for (int64_t i = i_first; i < n_tokens; ++i) {
+        ctx[0] = tokens[i];
+        bool cut = false;
+        for (int64_t q = 1; q < n_gram; ++q) {
+            const int64_t j = i - q;
+            const llama_token t = (cut || j < 0) ? LLAMA_TOKEN_NULL : tokens[j];
+            cut = cut || t < 0 || t == eos;
+            ctx[q] = cut ? eos : t;
+        }
+        for (int64_t n = 2; n <= n_gram; ++n) {
+            uint64_t mixed = (uint64_t) ctx[0] * hp.ple_layer_multipliers[0];
+            for (int64_t j = 1; j < n; ++j) {
+                mixed ^= (uint64_t) ctx[j] * hp.ple_layer_multipliers[j];
+            }
+            const int64_t b = (n - 2) * per_gram;
+            for (int64_t g = 0; g < per_gram; ++g) {
+                const int64_t h = b + g;
+                const int64_t row = (int64_t) (mixed % hp.ple_head_vocab_sizes[h] + hp.ple_head_offsets[h]);
+                if (row >= 0 && row < ple->ne[1]) {
+                    mr.push_back({ base + (size_t) row * ple->nb[1], row_bytes });
+                }
+            }
+        }
+    }
+    llama_prefetch_async(std::move(mr));
+}
