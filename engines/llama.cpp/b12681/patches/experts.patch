+// LLAMA_DRAFT_ROUTE_COUNT=path (diagnostic, off = stock): count the experts the draft's MoE router picks. Observes the
+// draft context's "ffn_moe_probs" tensor ([n_expert, n_tokens] F32) through the eval callback and takes the top n_used on
+// the host. Rows written: expert, hits and weight mass in 1-token passes (decode), hits and mass in larger passes (catch-up).
+struct draft_route_count {
+    std::string path; int n_used = 0; uint64_t n_tok[2] = {0, 0}; uint64_t calls = 0;
+    std::vector<uint64_t> hits[2]; std::vector<double> mass[2]; std::vector<float> buf;
+    void dump() const {
+        FILE * f = fopen(path.c_str(), "w");
+        if (!f) { return; }
+        fprintf(f, "# n_expert %zu n_used %d tokens_decode %" PRIu64 " tokens_catchup %" PRIu64 "\n", hits[0].size(), n_used, n_tok[0], n_tok[1]);
+        for (size_t e = 0; e < hits[0].size(); e++) {
+            fprintf(f, "%zu %" PRIu64 " %.6f %" PRIu64 " %.6f\n", e, hits[0][e], mass[0][e], hits[1][e], mass[1][e]);
+        }
+        fclose(f);
+    }
+    ~draft_route_count() { if (!path.empty() && calls > 0) { dump(); } }
+};
+static draft_route_count g_draft_route_count;
+static bool draft_route_count_cb(struct ggml_tensor * t, bool ask, void * ud) {
+    auto * rc = (draft_route_count *) ud;
+    const bool want = strncmp(t->name, "ffn_moe_probs-", 14) == 0;
+    if (ask || !want) { return ask ? want : true; }
+    const int64_t n_expert = t->ne[0], n_tokens = t->ne[1];
+    if (t->type != GGML_TYPE_F32 || n_expert < rc->n_used) { return true; }
+    for (int k = 0; k < 2; k++) { rc->hits[k].resize(n_expert); rc->mass[k].resize(n_expert); }
+    rc->buf.resize(n_expert*n_tokens);
+    ggml_backend_tensor_get(t, rc->buf.data(), 0, rc->buf.size()*sizeof(float));
+    const int k = n_tokens == 1 ? 0 : 1;
+    std::vector<int32_t> idx(n_expert);
+    for (int64_t j = 0; j < n_tokens; j++) {
+        const float * p = rc->buf.data() + j*n_expert;
+        for (int64_t e = 0; e < n_expert; e++) { idx[e] = (int32_t) e; }
+        std::partial_sort(idx.begin(), idx.begin() + rc->n_used, idx.end(), [p](int32_t a, int32_t b) { return p[a] > p[b] || (p[a] == p[b] && a < b); });
+        double sum = 0.0;
+        for (int u = 0; u < rc->n_used; u++) { sum += p[idx[u]]; }
+        for (int u = 0; u < rc->n_used; u++) { rc->hits[k][idx[u]]++; rc->mass[k][idx[u]] += sum > 0 ? p[idx[u]]/sum : 0.0; }
+    }
+    rc->n_tok[k] += n_tokens;
+    if (++rc->calls % 20000 == 0) { rc->dump(); }
+    return true;
+}
