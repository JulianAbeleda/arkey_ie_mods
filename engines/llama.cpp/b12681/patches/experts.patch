+        fprintf(stderr, "moe_inplace check: call %zu %s tokens %ld experts in place %zu of %ld bytes %zu diff %zu total diff %zu\n",
+            ++n_calls, src0->name, (long) ne12, n_moved, (long) ne02, nbytes, n_diff, n_diff_total);
+    }
 }
 
