+            const int qhl  = (qh >> (8*(l/2) + 4*(l%2))) & 0x0F; // 3 index bits, then the shift bit
+            const int grid = iq1s_grid_gpu[qs[l] | ((qhl & 0x07) << 8)];
+            const int off  = qhl & 0x08 ? 0x09090909 : 0x07070707; // 8*(1 + 1/8) or 8*(1 - 1/8)
