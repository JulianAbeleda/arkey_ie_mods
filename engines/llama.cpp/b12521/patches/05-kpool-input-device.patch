+// idle-growth: device tensors for pool_cells / pool_idxs, sized for every pool the cache can hold plus the padding
+void llama_memory_hybrid_idx::kpool_dev_init(const llama_model & model, bool no_alloc, uint32_t kv_size, uint32_t n_seq_max,
+        bool offload, const layer_filter_cb & filter_idx) {
+    static const bool env = getenv("LLAMA_KPOOL_INPUT_DEVICE") && atoi(getenv("LLAMA_KPOOL_INPUT_DEVICE")) != 0;
+    const uint32_t kpool = model.hparams.indexer_kpool;
+    if (!env || mem_idx == nullptr || filter_idx == nullptr || kpool == 0 || no_alloc) {
+        return;
+    }
+
+    // every indexer layer must sit on one device buffer type: a consumer elsewhere would copy the whole table each graph
+    ggml_backend_buffer_type_t buft = nullptr;
+    bool one = true;
+    for (uint32_t il = 0; il < model.hparams.n_layer_all; ++il) {
+        if (!model.hparams.has_kv(il) || !filter_idx(il)) {
+            continue;
+        }
+        ggml_backend_buffer_type_t b = offload ? ggml_backend_dev_buffer_type(model.dev_layer(il)) : ggml_backend_cpu_buffer_type();
+        one  = one && (buft == nullptr || buft == b);
+        buft = b;
+    }
+    if (n_seq_max != 1 || buft == nullptr || !one || ggml_backend_buft_is_host(buft)) {
+        LLAMA_LOG_WARN("%s: LLAMA_KPOOL_INPUT_DEVICE ignored: needs one sequence and every indexer layer on one device "
+                "(n_seq_max %u, one buffer type %d): stock host inputs\n", __func__, n_seq_max, (int) (buft != nullptr && one));
+        return;
+    }
+
+    const uint32_t cap = kpool_pad(kv_size/kpool*n_seq_max);
+
+    ggml_init_params params = { size_t(4*ggml_tensor_overhead()), NULL, true };
+    kdev_ctx.reset(ggml_init(params));
+    GGML_ASSERT(kdev_ctx != nullptr);
+    kdev.cells = ggml_new_tensor_1d(kdev_ctx.get(), GGML_TYPE_I32, cap);
+    kdev.idxs  = ggml_new_tensor_2d(kdev_ctx.get(), GGML_TYPE_I32, kpool, cap);
+    ggml_set_name(kdev.cells, "kpool_dev_cells");
+    ggml_set_name(kdev.idxs,  "kpool_dev_idxs");
+    kdev_buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(kdev_ctx.get(), buft));
+    GGML_ASSERT(kdev_buf != nullptr && "failed to allocate the device k-pool inputs");
+    ggml_backend_buffer_clear(kdev_buf.get(), 0);
+
+    kdev.sh_cells.assign(cap, 0);
+    kdev.sh_idxs.assign((size_t) kpool*cap, 0);
+    kdev.rep_cnt.assign(kv_size, 0);
+    kdev.check = getenv("LLAMA_KPOOL_INPUT_CHECK") && atoi(getenv("LLAMA_KPOOL_INPUT_CHECK")) != 0;
+
+    LLAMA_LOG_WARN("%s: LLAMA_KPOOL_INPUT_DEVICE: pool_cells / pool_idxs on the device: %u rows, %.2f MiB (%s)%s\n", __func__,
+            cap, ggml_backend_buffer_get_size(kdev_buf.get())/1024.0/1024.0, ggml_backend_buft_name(buft),
+            kdev.check ? " (check on)" : "");
+}
