diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 1d8f66d..cc25727 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -254,6 +254,20 @@ llama_context::llama_context(
         }
     }
 
+    // an MTP head loaded without its own output projection (LLAMA_MTP_SHARE_HEAD) reads the target model's.
+    // cparams.ctx_other stays nullptr: setting it would also share the target's memory
+    cparams.model_head_src = nullptr;
+    if (model.arch == LLM_ARCH_QWEN4EXP && params.ctx_type == LLAMA_CONTEXT_TYPE_MTP && model.output == nullptr) {
+        const llama_model * model_other = params.ctx_other ? llama_get_model(params.ctx_other) : nullptr;
+        if (model_other == nullptr || model_other->output == nullptr) {
+            throw std::runtime_error("LLAMA_MTP_SHARE_HEAD requires ctx_other with an output projection (this warning is normal during memory fitting)");
+        }
+        if (model_other->dev_output() != model.dev_output()) {
+            throw std::runtime_error("LLAMA_MTP_SHARE_HEAD requires the target's output projection on the MTP head's output device");
+        }
+        cparams.model_head_src = model_other;
+    }
+
     if (cparams.rope_scaling_type == LLAMA_ROPE_SCALING_TYPE_UNSPECIFIED) {
         cparams.rope_scaling_type = hparams.rope_scaling_type_train;
     }
