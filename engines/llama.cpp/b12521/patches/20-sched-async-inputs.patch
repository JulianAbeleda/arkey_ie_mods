@@ -2115,6 +2183,9 @@ static void ggml_backend_sched_copy_input(ggml_backend_sched_t sched, struct ggm
 
     if (input->flags & GGML_TENSOR_FLAG_INPUT) {
         // inputs from the user must be copied immediately to prevent the user overwriting the data before the copy is done
+        if (ggml_backend_sched_stage_copy(sched, split_backend, input_backend, input, input_cpy)) {
