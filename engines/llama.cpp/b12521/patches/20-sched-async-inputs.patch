+    for (int i = 0; i < 4; i++) {
+        ggml_backend_event_free(sched->stage_events[i]);
+    }
     ggml_gallocr_free(sched->galloc);
     ggml_free(sched->ctx);
     ggml_hash_set_free(&sched->hash_set);
