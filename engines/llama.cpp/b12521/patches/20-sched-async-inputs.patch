     sched->debug_realloc = 0;
 #ifdef GGML_SCHED_NO_REALLOC
@@ -2382,6 +2459,11 @@ void ggml_backend_sched_free(ggml_backend_sched_t sched) {
         }
         ggml_backend_event_free(sched->prefetch_events[b]);
     }
+    // no backend call here: llama_context frees its backends first. Freeing the pinned buffer waits for the device
