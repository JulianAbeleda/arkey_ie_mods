 }
 
+// GGML_SCHED_ASYNC_INPUTS=1: a split input that lives in a host buffer is snapshotted into a pinned staging ring and
+// copied with set_tensor_async on the split backend's stream. The stream orders the copy after the earlier work that
+// reads the destination and before the split that reads it, so the host syncs before and after the copy are not
+// needed; the snapshot keeps the "copied immediately" contract for the source. A ring chunk is reused only after an
+// event recorded behind its last copy has completed. =2 also reads every copy back after a sync and compares it.
+#define GGML_SCHED_STAGE_CHUNK (1u << 20)
+static bool ggml_backend_sched_stage_copy(ggml_backend_sched_t sched, ggml_backend_t backend, ggml_backend_t input_backend,
+        struct ggml_tensor * input, struct ggml_tensor * input_cpy) {
+    ggml_backend_buffer_t src_buf = input->view_src ? input->view_src->buffer : input->buffer;
+    ggml_backend_buffer_t dst_buf = input_cpy->view_src ? input_cpy->view_src->buffer : input_cpy->buffer;
+    const size_t n = ggml_nbytes(input);
+    // the source must be final on the host: written by the user or by a host (CPU) backend, which computes synchronously
+    if (sched->stage_mode == 0 || sched->n_copies != 1 || backend->iface.set_tensor_async == NULL || n > GGML_SCHED_STAGE_CHUNK ||
+        input_backend == NULL || ggml_backend_dev_type(ggml_backend_get_device(input_backend)) != GGML_BACKEND_DEVICE_TYPE_CPU ||
+        src_buf == NULL || !ggml_backend_buffer_is_host(src_buf) || dst_buf == NULL || ggml_backend_buffer_is_host(dst_buf) ||
+        !ggml_is_contiguous(input) || (sched->stage_backend != NULL && sched->stage_backend != backend)) {
+        return false;
+    }
+    if (sched->stage_buf == NULL) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+        ggml_backend_buffer_type_t host = dev ? ggml_backend_dev_host_buffer_type(dev) : NULL;
+        sched->stage_buf = host ? ggml_backend_buft_alloc_buffer(host, 4 * (size_t) GGML_SCHED_STAGE_CHUNK) : NULL;
+        sched->stage_backend = backend;
+        for (int i = 0; i < 4 && sched->stage_buf; i++) {
+            sched->stage_events[i] = ggml_backend_event_new(dev);
+            if (sched->stage_events[i] == NULL || backend->iface.event_record == NULL) {
+                sched->stage_mode = 0; // no events: stay on the stock path
+                return false;
+            }
+        }
+        if (sched->stage_buf == NULL) {
+            sched->stage_mode = 0;
+            return false;
+        }
+    }
+    if (sched->stage_off + n > GGML_SCHED_STAGE_CHUNK) { // next chunk: wait until the copies that last read it are done
+        ggml_backend_event_record(sched->stage_events[sched->stage_chunk], backend);
+        sched->stage_chunk = (sched->stage_chunk + 1) % 4;
+        ggml_backend_event_synchronize(sched->stage_events[sched->stage_chunk]);
+        sched->stage_off = 0;
+    }
+    char * stage = (char *) ggml_backend_buffer_get_base(sched->stage_buf) + (size_t) sched->stage_chunk * GGML_SCHED_STAGE_CHUNK + sched->stage_off;
+    memcpy(stage, input->data, n);
+    sched->stage_off += GGML_PAD(n, 256);
+    ggml_backend_tensor_set_async(backend, input_cpy, stage, 0, n);
+    if (sched->stage_mode == 2) {
+        std::vector<char> back(n);
+        ggml_backend_synchronize(backend);
+        ggml_backend_tensor_get(input_cpy, back.data(), 0, n);
+        sched->stage_differ += memcmp(back.data(), input->data, n) != 0;
+        if (++sched->stage_checked % 20000 == 0 || memcmp(back.data(), input->data, n) != 0) {
+            GGML_LOG_WARN("%s: GGML_SCHED_ASYNC_INPUTS check: %zu copies, %zu differ (last %s, %zu bytes)\n", __func__,
+                sched->stage_checked, sched->stage_differ, input->name, n);
+        }
+    }
+    return true;
+}
