+    __shared__ int warp_sums[nwarps];
+    __shared__ int sel_bin;
+    __shared__ int sel_rank;
+
+    ggml_cuda_pdl_lc();
+
+    const int row       = blockIdx.x / blocks_per_row;
+    const int row_block = blockIdx.x % blocks_per_row;
+    const int tid       = threadIdx.x;
+    const int lane      = tid % warp_size;
+    const int warp      = tid / warp_size;
+    const float * row_src = src + (size_t) row * ncols;
+    int *         row_dst = dst + (size_t) row * k;
+    // one histogram buffer per pass: a block that is already in pass p+1 must not overwrite the pass p histogram that a
+    // slower block of the row is still summing. Layout [pass][row][block][bin].
+    constexpr int NPASSES = 32 / RADIX_BITS;
+    const size_t pass_stride = (size_t) gridDim.x * NBINS;
