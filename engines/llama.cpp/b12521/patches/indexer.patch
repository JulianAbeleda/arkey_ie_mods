+static uint32_t top_k_float_to_ordered_host(float value) {
+    uint32_t bits;
+    memcpy(&bits, &value, sizeof(bits));
+    return bits ^ ((uint32_t) (-(int32_t) (bits >> 31)) | 0x80000000U);
+}
