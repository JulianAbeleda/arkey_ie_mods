+    LLAMA_LOG_WARN("%s: LLAMA_IDX_POOLED: indexer stores pooled keys only: %zu layers, %u pool slots + %u ring rows, %s, %.2f MiB%s\n",
+            __func__, pooled_layers.size(), pool_slots, ring_size, ggml_type_name(type_k), total/1024.0/1024.0,
+            idx_pooled_check ? " (check on)" : "");
+}
