+        ggml_tensor * pool = ggml_new_tensor_2d(it->second, type_k, idx_dim, pool_slots);
+        ggml_format_name(ring, "cache_idx_ring_l%u", il);
+        ggml_format_name(pool, "cache_idx_pool_l%u", il);
+        pooled_layers[(int32_t) il] = { ring, pool };
