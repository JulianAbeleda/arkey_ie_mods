+// zeroed row states that live as long as the process, one set per stream (captured CUDA graphs keep the pointer)
+static top_k_fused_sync * top_k_fused_sync_get(cudaStream_t stream) {
+    static std::mutex mutex;
+    static std::unordered_map<cudaStream_t, top_k_fused_sync *> map;
+    std::lock_guard<std::mutex> lock(mutex);
+    auto it = map.find(stream);
+    if (it == map.end()) {
+        // zero on a stream of its own: the caller's stream may be capturing a graph
+        const size_t size = GGML_CUDA_TOP_K_FUSED_MAX_ROWS * sizeof(top_k_fused_sync);
+        void *       ptr  = nullptr;
+        cudaStream_t init = nullptr;
+        CUDA_CHECK(cudaMalloc(&ptr, size));
+        CUDA_CHECK(cudaStreamCreate(&init));
+        CUDA_CHECK(cudaMemsetAsync(ptr, 0, size, init));
+        CUDA_CHECK(cudaStreamSynchronize(init));
+        CUDA_CHECK(cudaStreamDestroy(init));
+        it = map.emplace(stream, (top_k_fused_sync *) ptr).first;
+        GGML_LOG_WARN("top_k_fused: on, row states at %p for stream %p\n", ptr, (void *) stream);
+    }
+    return it->second;
+}
