+// stock and fused picks against a host reference: sorted picks above the threshold word for word, tie slots word for
+// word in order, and the two sorted rows against each other
+static void top_k_fused_check(
+        const float * src, const int * dst_stock, const int * dst_fused, int ncols, int nrows, int k, cudaStream_t stream) {
+    static int64_t ncalls = 0, total_diff = 0;
+    std::vector<float> s((size_t) ncols * nrows);
+    std::vector<int>   a((size_t) k * nrows), b((size_t) k * nrows);
+    CUDA_CHECK(cudaMemcpyAsync(s.data(), src,       s.size() * sizeof(float), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaMemcpyAsync(a.data(), dst_stock, a.size() * sizeof(int),   cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaMemcpyAsync(b.data(), dst_fused, b.size() * sizeof(int),   cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+
+    int64_t diff = 0;
+    int     rank_last = 0;
+    for (int r = 0; r < nrows; ++r) {
+        std::vector<uint32_t> key(ncols);
+        for (int c = 0; c < ncols; ++c) {
+            key[c] = top_k_float_to_ordered_host(s[(size_t) r * ncols + c]);
+        }
+        std::vector<uint32_t> sorted = key;
+        std::nth_element(sorted.begin(), sorted.begin() + (k - 1), sorted.end(), std::greater<uint32_t>());
+        const uint32_t threshold = sorted[k - 1];
+        std::vector<int> ref; // picks above the threshold ascending, then the lowest tie columns ascending
+        for (int c = 0; c < ncols; ++c) {
+            if (key[c] > threshold) {
+                ref.push_back(c);
+            }
+        }
+        const int ngreater = (int) ref.size();
+        for (int c = 0; c < ncols && (int) ref.size() < k; ++c) {
+            if (key[c] == threshold) {
+                ref.push_back(c);
+            }
+        }
+        rank_last = k - ngreater;
+        std::vector<int> ra(a.begin() + (size_t) r * k, a.begin() + (size_t) (r + 1) * k);
+        std::vector<int> rb(b.begin() + (size_t) r * k, b.begin() + (size_t) (r + 1) * k);
+        std::sort(ra.begin(), ra.begin() + ngreater);
+        std::sort(rb.begin(), rb.begin() + ngreater);
+        for (int i = 0; i < k; ++i) {
+            diff += (ra[i] != ref[i]) + (rb[i] != ref[i]); // head sorted, tie slots as written
+        }
+        std::sort(ra.begin(), ra.end());
+        std::sort(rb.begin(), rb.end());
+        for (int i = 0; i < k; ++i) {
+            diff += ra[i] != rb[i];
+        }
+    }
+    total_diff += diff;
+    ncalls++;
+    if (diff != 0 || ncalls <= 4 || ncalls % 1000 == 0) {
+        GGML_LOG_WARN("topk_fused check: call %lld rows %d ncols %d k %d ties(last row) %d words %lld diff %lld total diff %lld\n",
+            (long long) ncalls, nrows, ncols, k, rank_last, (long long) 3 * k * nrows, (long long) diff, (long long) total_diff);
+    }
+    GGML_ASSERT(diff == 0 && "topk_fused check: fused picks differ from stock / host reference");
+}
