+// LOCAL (ckpt-pinned): LLAMA_CKPT_PINNED=1. A context checkpoint is a new state buffer every time; stock allocates it
+// pageable and the CUDA read then pins, maps and unpins the whole span per save. The pool hands out pinned host buffers
+// (the device's host buffer type) and keeps the buffers of erased checkpoints for the next checkpoint of the same size.
+namespace {
+struct common_state_pool {
+    std::mutex mtx;
+    ggml_backend_buffer_type_t buft = nullptr;
+    std::unordered_map<void *, ggml_backend_buffer_t> live;
+    std::vector<std::pair<size_t, ggml_backend_buffer_t>> idle;
+    size_t n_reserve = 0; // buffers to pin at the first allocation; 0 once done
+    size_t max_idle  = 8;
+};
+constexpr size_t COMMON_STATE_POOL_MIN_BYTES = 1024 * 1024;
+
+common_state_pool * common_state_pool_get() {
+    static common_state_pool * pool = [] () -> common_state_pool * {
+        const char * env = getenv("LLAMA_CKPT_PINNED");
+        if (env == nullptr || atoi(env) == 0) {
+            return nullptr;
+        }
+        auto * res = new common_state_pool(); // never destroyed: checkpoints may outlive static destruction
+        for (size_t i = 0; i < ggml_backend_dev_count() && res->buft == nullptr; i++) {
+            res->buft = ggml_backend_dev_host_buffer_type(ggml_backend_dev_get(i));
+        }
+        LOG_INF("%s: LLAMA_CKPT_PINNED=1, host buffer type = %s\n", __func__, res->buft ? ggml_backend_buft_name(res->buft) : "none (stock path)");
+        return res;
+    }();
+    return pool;
+}
+}
+
+void * common_state_pool_alloc(size_t n_bytes) {
+    auto * pool = n_bytes < COMMON_STATE_POOL_MIN_BYTES ? nullptr : common_state_pool_get();
+    if (pool == nullptr || pool->buft == nullptr) {
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(pool->mtx);
+    ggml_backend_buffer_t buf = nullptr;
+    for (size_t i = 0; i < pool->idle.size(); i++) {
+        if (pool->idle[i].first == n_bytes) {
+            buf = pool->idle[i].second;
+            pool->idle.erase(pool->idle.begin() + i);
+            break;
+        }
+    }
+    if (buf == nullptr) {
+        buf = ggml_backend_buft_alloc_buffer(pool->buft, n_bytes);
+    }
+    if (buf == nullptr) {
+        return nullptr;
+    }
+    if (pool->n_reserve > 0) {
+        // pinned allocations slow the whole host side while they happen: take them all now, not one per checkpoint
+        const int64_t t_start = ggml_time_us();
+        size_t n = 1;
+        for (; n < pool->n_reserve; n++) {
+            ggml_backend_buffer_t cur = ggml_backend_buft_alloc_buffer(pool->buft, n_bytes);
+            if (cur == nullptr) {
+                break;
+            }
+            pool->idle.emplace_back(n_bytes, cur);
+        }
+        pool->max_idle  = std::max(pool->max_idle, n);
+        pool->n_reserve = 0;
+        LOG_INF("%s: LLAMA_CKPT_PINNED reserved %zu buffers of %.3f MiB in %.1f ms\n", __func__, n, n_bytes / 1024.0 / 1024.0, (ggml_time_us() - t_start) / 1000.0);
+    }
+    void * ptr = ggml_backend_buffer_get_base(buf);
+    pool->live[ptr] = buf;
+    return ptr;
+}
+
+void common_state_pool_reserve(size_t n) {
+    static bool done = false; // server thread only
+    auto * pool = done ? nullptr : common_state_pool_get();
+    done = true;
+    if (pool != nullptr) {
+        std::lock_guard<std::mutex> lock(pool->mtx);
+        pool->n_reserve = n;
+    }
+}
+
+bool common_state_pool_free(void * ptr, size_t n_bytes) {
+    auto * pool = common_state_pool_get();
+    if (pool == nullptr) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(pool->mtx);
+    const auto it = pool->live.find(ptr);
+    if (it == pool->live.end()) {
+        return false;
+    }
+    if (pool->idle.size() >= pool->max_idle) {
+        ggml_backend_buffer_free(pool->idle.front().second);
+        pool->idle.erase(pool->idle.begin());
+    }
+    pool->idle.emplace_back(n_bytes, it->second);
+    pool->live.erase(it);
+    return true;
+}
+
 size_t common_prompt_checkpoint::size() const {
     return data_tgt.size() + data_dft.size() + data_spec.size();
 }
