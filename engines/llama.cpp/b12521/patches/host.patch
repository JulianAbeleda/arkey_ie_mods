+            GGML_ABORT("LLAMA_TOKENIZE_INCR_CHECK: piecewise tokens differ from the full tokenization (%zu vs %zu tokens)\n", out.size(), full.size());
+        }
+        fprintf(stderr, "tokenize_incr check: %zu tokens equal, pieces new %zu reused %zu, incr %.2f ms, full %.2f ms\n",
+            out.size(), n_new, n_reused, (t1 - t0)/1e3, (ggml_time_us() - t1)/1e3);
+    }
+    return out;
+}
