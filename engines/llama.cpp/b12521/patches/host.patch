+// LOCAL (tokenize-incr): LLAMA_TOKENIZE_INCR=1 - the prompt string is cut before every occurrence of a control token's text (from
+// the vocab; no strip attributes). The tokenizer splits the text at special tokens before it runs BPE on the text between them, so
+// the pieces tokenize independently: tokens(prompt) == concat(tokens(piece)). Pieces seen in the previous call (the conversation
+// history) reuse their tokens; only new pieces are tokenized. Literals: 256 = one bucket per first byte value. No size threshold:
+// the piecewise path is exact at any size. LLAMA_TOKENIZE_INCR_CHECK=1 also tokenizes the whole string and aborts on any difference.
+// Unset = stock.
+static llama_tokens tokenize_incr(const llama_vocab * vocab, const std::string & s, bool add_special, bool parse_special) {
+    static const bool on  = getenv("LLAMA_TOKENIZE_INCR") != nullptr && atoi(getenv("LLAMA_TOKENIZE_INCR")) > 0;
+    static const bool chk = getenv("LLAMA_TOKENIZE_INCR_CHECK") != nullptr && atoi(getenv("LLAMA_TOKENIZE_INCR_CHECK")) > 0;
+    // EOS added by add_special would land after the first piece instead of the end: stock path for such vocabs
+    if (!on || !parse_special || (add_special && llama_vocab_get_add_eos(vocab))) {
+        return common_tokenize(vocab, s, add_special, parse_special);
+    }
+    // cut points = every occurrence of a control token's text (no strip attributes), taken from the vocab once per vocab and
+    // bucketed by first byte, longest first: the tokenizer splits the text at special tokens before BPE, so the pieces between
+    // them tokenize independently. No control token in the text -> stock path.
+    static std::mutex mtx_d;
+    static std::unordered_map<const llama_vocab *, std::vector<std::vector<std::string>>> ctrl;
+    const std::vector<std::vector<std::string>> * buckets = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(mtx_d);
+        auto it = ctrl.find(vocab);
+        if (it == ctrl.end()) {
+            std::vector<std::vector<std::string>> b(256);
+            const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+            for (llama_token t = 0; t < n_vocab; ++t) {
+                const auto attr = llama_vocab_get_attr(vocab, t);
+                if ((attr & LLAMA_TOKEN_ATTR_CONTROL) && !(attr & (LLAMA_TOKEN_ATTR_LSTRIP | LLAMA_TOKEN_ATTR_RSTRIP))) {
+                    std::string piece = common_token_to_piece(vocab, t, true);
+                    if (!piece.empty()) {
+                        b[(unsigned char) piece[0]].push_back(std::move(piece));
+                    }
+                }
+            }
+            for (auto & v : b) {
+                std::sort(v.begin(), v.end(), [](const std::string & x, const std::string & y) { return x.size() > y.size(); });
+            }
+            it = ctrl.emplace(vocab, std::move(b)).first;
+        }
+        buckets = &it->second;
+    }
+    std::vector<size_t> cuts; // start offsets of the pieces
+    cuts.push_back(0);
+    for (size_t pos = 0; pos < s.size(); ) {
+        size_t len = 0;
+        for (const auto & c : (*buckets)[(unsigned char) s[pos]]) {
+            if (s.compare(pos, c.size(), c) == 0) {
+                len = c.size();
+                break;
+            }
+        }
+        if (len == 0) {
+            pos++;
+            continue;
+        }
+        if (pos > 0) {
+            cuts.push_back(pos);
+        }
+        pos += len;
+    }
+    if (cuts.size() == 1) {
+        return common_tokenize(vocab, s, add_special, parse_special);
+    }
+    cuts.push_back(s.size());
+
+    const int64_t t0 = ggml_time_us();
+    // the pieces of the previous call (one prompt's text + tokens: memory bounded by one prompt); per process, so interleaved
+    // conversations (-np > 1) reuse less but stay exact (every piece is either tokenized or an exact string match)
+    static std::mutex mtx;
+    static std::unordered_map<std::string, llama_tokens> prev;
+    std::unordered_map<std::string, llama_tokens> next;
+    llama_tokens out;
+    size_t n_new = 0, n_reused = 0;
+    std::lock_guard<std::mutex> lock(mtx);
+    for (size_t k = 0; k + 1 < cuts.size(); ++k) {
+        const bool first = k == 0;
+        std::string piece = s.substr(cuts[k], cuts[k + 1] - cuts[k]);
+        // the first piece carries add_special (BOS); a marker byte keeps it apart from the same text elsewhere
+        std::string key = first && add_special ? std::string("\x01") + piece : piece;
+        llama_tokens toks;
+        if (auto it = prev.find(key); it != prev.end()) {
+            toks = it->second;
+            n_reused++;
+        } else if (auto jt = next.find(key); jt != next.end()) {
+            toks = jt->second;
+            n_reused++;
+        } else {
+            toks = common_tokenize(vocab, piece, first && add_special, true);
+            n_new++;
+        }
+        out.insert(out.end(), toks.begin(), toks.end());
+        next.emplace(std::move(key), std::move(toks));
+    }
+    prev.swap(next);
+    const int64_t t1 = ggml_time_us();
+    if (chk) {
+        const llama_tokens full = common_tokenize(vocab, s, add_special, parse_special);
