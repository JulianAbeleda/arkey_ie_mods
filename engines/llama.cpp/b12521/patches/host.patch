+// LOCAL (ple-prefetch-step): LLAMA_PLE_PREFETCH_STEP=1 - hint the target's lazily mapped input rows of each token the next
+// verify will read as soon as the token is known (id_last when drafting starts, each draft token when it is sampled), on
+// host/ple-prefetch's background thread, so the verify's gather finds them cached instead of waiting on the disk. A hint
+// changes no byte that is read. Unset = stock.
+static void spec_ple_prefetch(llama_context * ctx_tgt, const llama_tokens * prompt, llama_token id_last, const llama_tokens * drafted) {
+    static const bool on = [] { const char * e = getenv("LLAMA_PLE_PREFETCH_STEP"); return e != nullptr && atoi(e) > 0; }();
+    if (!on || ctx_tgt == nullptr) {
+        return;
+    }
+    const size_t n_pred = 16; // predecessors kept: more than any n-gram an input row is keyed on
+    llama_tokens toks;
+    if (prompt != nullptr) {
+        toks.assign(prompt->begin() + (prompt->size() > n_pred ? prompt->size() - n_pred : 0), prompt->end());
+    }
+    toks.push_back(id_last);
+    if (drafted != nullptr) {
+        toks.insert(toks.end(), drafted->begin(), drafted->end());
+    }
+    llama_model_prefetch_inputs(llama_get_model(ctx_tgt), toks.data(), (int32_t) toks.size(), (int32_t) toks.size() - 1);
+}
