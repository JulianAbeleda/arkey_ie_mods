diff --git a/ggml/src/ggml-cuda/ext-kernels.cpp b/ggml/src/ggml-cuda/ext-kernels.cpp
new file mode 100644
index 000000000..2ee075118
--- /dev/null
+++ b/ggml/src/ggml-cuda/ext-kernels.cpp
@@ -0,0 +1,846 @@
+// Opt-in mod: GGML_CUDA_EXT_KERNELS=<manifest.json> runs kernels named in a boltbeam.kernel_manifest.v1/v2 file in place
+// of the engine's own, for graph nodes that match an entry's ops, types and shapes (never a model or tensor name).
+// v2: an entry may take a WINDOW of N consecutive nodes (a region) with its wiring; one launch replaces all N, or a
+// sequence of launches (launches + scratch: values cut between launches that are not live outputs live in scratch),
+// with run-time extents ({"ne": [node, src, dim]} args, -1 in ne / nb: any), op_params bytes (op_params_hex) and a
+// kv-stream step (kv_stream: a streamed K/V cache resolved into VRAM for the launches after it).
+// Unset = the stock engine. This file holds no kernels: they arrive as cubin / PTX files, verified by sha256.
+// Anything that does not match or does not load falls back to the engine's own path for that node.
+// GGML_CUDA_EXT_KERNELS_CHECK=1 (with GGML_CUDA_DISABLE_GRAPHS=1) runs both and compares every live output at the
+// entry's tolerance.
+#include "ggml-impl.h"
+
+#include <cuda.h>
+#include <nlohmann/json.hpp>
+extern "C" {
+#include <sha256/sha256.h>
+}
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <deque>
+#include <fstream>
+#include <functional>
+#include <iterator>
+#include <mutex>
+#include <string>
+#include <vector>
+
+int ggml_cuda_ext_kernels_run(void * stream, ggml_cgraph * cgraph, int i, bool (*stock)(void *, ggml_tensor *), void * stock_ctx);
+
+// the kv module's kv-stream (kv-stream.cuh), weak: a build without that module has no streamed cache, the step is a no-op.
+// The mask struct is that header's layout (kv-stream.cuh includes device code a host compiler cannot read)
+struct ggml_cuda_kvs_mask {
+    const void * data = nullptr;
+    int64_t      stride = 0, ne01 = 0;
+    int          ncols1 = 1;
+    int32_t *    cells = nullptr;
+    void *       scratch = nullptr;
+    bool         swapped = false;
+    int64_t      out_stride = 0;
+};
+static_assert(sizeof(ggml_cuda_kvs_mask) == 64, "the layout of kv-stream.cuh's ggml_cuda_kvs_mask");
+#if defined(__GNUC__)
+#define EXT_KVS 1
+__attribute__((weak)) int64_t ggml_cuda_kvs_resolve_cells(const ggml_tensor * K, int64_t n_kv, int64_t n_lists, int64_t n_kv_max, int64_t ne01);
+__attribute__((weak)) bool ggml_cuda_kvs_attn(CUstream stream, const ggml_tensor * K, const ggml_tensor * V, int64_t n_kv, bool sparse_direct,
+                                              int32_t * indices, const int32_t * counts, int64_t n_lists, int64_t n_kv_max,
+                                              ggml_cuda_kvs_mask * mask, const char ** K_data, const char ** V_data);
+#endif
+
+namespace {
+
+using json = nlohmann::json;
+typedef std::array<int64_t, GGML_MAX_DIMS> ext_ne;
+
+struct ext_op {
+    ggml_op                op;
+    int                    unary = -1;     // GGML_OP_UNARY: the unary op, else -1
+    ggml_type              type;
+    ext_ne                 ne, ne_max = {};   // ne -1 (launches entries only): any extent up to ne_max (the kernel's bound)
+    std::vector<ggml_type> src_types;
+    std::vector<ext_ne>    src_ne, src_ne_max;
+    std::vector<ext_ne>    src_ne_min;     // per src: a -1 extent's lower bound (0: none), e.g. where the engine's own path changes
+    std::vector<int>       src_node;       // per src: the window node it is (0..), or -1 = a tensor from outside
+    std::vector<std::string> src_ext;      // per outside src: its manifest name; one name = one tensor across the window
+    int                    uses = 0;       // in-window uses (filled at load)
+    std::vector<float>     params;         // the op's leading op_params as f32, matched bitwise (a scale's factor and bias)
+    std::vector<uint8_t>   params_raw;     // op_params_hex: the leading op_params bytes, matched exactly
+    std::vector<int64_t>   nb;             // a strided node (a view): its byte strides, matched exactly (-1: dense in that dim); empty = contiguous
+    std::vector<std::vector<int64_t>> src_nb;  // the same per outside src
+    int64_t                view_offs = 0;  // an interior view of a window node: its byte offset in that node's buffer
+};
+
+struct ext_arg {
+    int      node;  // window node, or -1: a constant
+    int      src;   // -1: the node's output, 0..: its src
+    uint64_t bits;  // the constant (i32 / u32 / f32 in the low 4 bytes, i64 in 8)
+    int      scratch = -1;  // a scratch slot's address (node -1)
+    int      dim = -1;      // >= 0: the extent ne[dim] of the node / src as i32 (not its address)
+    bool     kv = false;    // after a kv-stream step: an arg at K's / V's address takes the step's pointer
+};
+
+struct ext_kvs {               // a kv-stream step: K, V, mask (node, src); the index lists and counts (scratch slots)
+    ext_arg  k, v, mask;
+    int      lists, counts;
+    int64_t  n_lists, n_kv_max, ncols1;
+};
+
+struct ext_launch {
+    CUfunction           fn;
+    unsigned             grid[3], block[3], shmem;
+    bool                 pdl = false;   // the kernel waits (griddepcontrol.wait) before it reads or writes any argument
+    bool                 state = false; // it writes outside state (a SET_ROWS output, or an output while alias_ok is set)
+    std::vector<ext_arg> args;
+    bool                 is_kvs = false;  // a kv-stream step, not a kernel
+    ext_kvs              kvs;
+};
+
+struct ext_mem {                // per engine stream: the scratch block and the kv-stream step's mask scratch
+    void *      stream;
+    CUdeviceptr base = 0, kvs = 0;
+    size_t      kvs_bytes = 0;   // SIZE_MAX: the kv-stream buffer failed (said once, never retried)
+};
+
+struct ext_entry {
+    std::string                      id;
+    std::vector<ext_op>              ops;
+    std::vector<int>                 outputs;   // window nodes read outside the window
+    std::vector<std::pair<int, int>> alias_ok;  // (node, src) inputs a live output may occupy exactly (same address, size)
+    std::vector<ext_launch>          launches;  // one, or a sequence run in order (all loaded before any runs)
+    std::vector<size_t>              scratch;   // per slot: its byte offset in the scratch block; back(): the block's size
+    std::deque<ext_mem>              scratch_mem;  // per engine stream: allocated once (a deque: references stay valid)
+    bool                             inplace = false;  // an output is a write into an outside tensor (SET_ROWS): no early start
+    double                           tol;  // check mode: largest allowed |ext - stock|, 0 = bit-identical
+    bool                             rel = false;  // tol is relative to max|stock| of each output (tolerance_mode rel_max)
+    uint64_t                         n_match = 0, n_check = 0, n_diff = 0, n_refused = 0;
+    double                           worst = 0;
+};
+
+bool ext_is_view(ggml_op op) {   // no bytes of its own
+    return op == GGML_OP_RESHAPE || op == GGML_OP_VIEW || op == GGML_OP_TRANSPOSE || op == GGML_OP_PERMUTE;
+}
+
+ggml_type ext_type(const std::string & s) {
+    for (int t = 0; t < GGML_TYPE_COUNT; ++t) {
+        const char * name = ggml_type_name((ggml_type) t);
+        if (name != nullptr && s == name) {
+            return (ggml_type) t;
+        }
+    }
+    throw std::runtime_error("unknown type " + s);
+}
+
+ggml_op ext_op_of(const std::string & s) {
+    for (int o = 0; o < GGML_OP_COUNT; ++o) {
+        if (s == std::string("GGML_OP_") + ggml_op_name((ggml_op) o)) {
+            return (ggml_op) o;
+        }
+    }
+    throw std::runtime_error("unknown op " + s);
+}
+
+int ext_unary_of(const std::string & s) {
+    for (int u = 0; u < GGML_UNARY_OP_COUNT; ++u) {
+        if (s == std::string("GGML_UNARY_OP_") + ggml_unary_op_name((ggml_unary_op) u)) {
+            return u;
+        }
+    }
+    throw std::runtime_error("unknown unary op " + s);
+}
+
+ext_ne ext_shape(const json & j) {
+    ext_ne ne;
+    ne.fill(1);
+    for (size_t d = 0; d < j.size(); ++d) {
+        ne.at(d) = j[d].get<int64_t>();
+    }
+    return ne;
+}
+
+std::string ext_sha256(const std::string & blob) {
+    unsigned char digest[SHA256_DIGEST_SIZE];
+    char          hex[2*SHA256_DIGEST_SIZE + 1];
+    sha256_hash(digest, (const unsigned char *) blob.data(), blob.size());
+    for (int b = 0; b < SHA256_DIGEST_SIZE; ++b) {
+        snprintf(hex + 2*b, 3, "%02x", digest[b]);
+    }
+    return hex;
+}
+
+void ext_ok(CUresult r, const char * what) {
+    if (r != CUDA_SUCCESS) {
+        throw std::runtime_error(std::string(what) + " failed: " + std::to_string((int) r));
+    }
+}
+
+ext_entry ext_load_entry(const json & j, const std::string & dir, const std::string & chip, bool v2, int nsm) {
+    ext_entry e;
+    e.id = j.at("id").get<std::string>();
+    if (j.at("target") != chip) {
+        throw std::runtime_error("built for " + j.at("target").get<std::string>() + ", this device is " + chip);
+    }
+    if (j.contains("sm_count") && j.at("sm_count").get<int>() != nsm) {   // an order derived from the SM count (a stream-K split)
+        throw std::runtime_error("made for " + std::to_string(j.at("sm_count").get<int>()) + " SMs, this device has " + std::to_string(nsm));
+    }
+    const int sm_lo = j.value("sm_count_min", 1), sm_hi = j.value("sm_count_max", 1 << 30);   // the engine picks its kernel by SM count
+    if (nsm < sm_lo || nsm > sm_hi) {
+        throw std::runtime_error("made for " + std::to_string(sm_lo) + " to " + std::to_string(sm_hi) + " SMs, this device has " + std::to_string(nsm));
+    }
+    const json & ops   = j.at("match").at("ops");
+    const bool   multi = j.contains("launches");
+    if (ops.empty() || (!v2 && ops.size() != 1)) {
+        throw std::runtime_error("a v1 entry takes a window of one op, a v2 entry at least one");
+    }
+    for (size_t k = 0; k < ops.size(); ++k) {
+        const json & o = ops[k];
+        ext_op       op;
+        op.op   = ext_op_of(o.at("op").get<std::string>());
+        op.type = ext_type(o.at("type").get<std::string>());
+        op.ne   = ext_shape(o.at("ne"));
+        if (o.contains("unary")) {
+            op.unary = ext_unary_of(o.at("unary").get<std::string>());
+        }
+        for (const json & v : o.value("op_params_f32", json::array())) {
+            op.params.push_back(v.get<float>());
+        }
+        // these op_params are the op: never match on shape alone (scale: factor, bias; arange: start, stop, step; concat: dim)
+        if (op.params.size() < (op.op == GGML_OP_SCALE ? 2u : op.op == GGML_OP_ARANGE ? 3u : op.op == GGML_OP_CONCAT ? 1u : 0u)) {
+            throw std::runtime_error("a GGML_OP_SCALE / ARANGE / CONCAT op needs its op_params_f32 (2 / 3 / 1 values)");
+        }
+        const std::string hex = o.value("op_params_hex", std::string());
+        if ((!hex.empty() && !v2) || hex.size() % 2 != 0 || hex.size() / 2 > GGML_MAX_OP_PARAMS || hex.find_first_not_of("0123456789abcdef") != std::string::npos) {
+            throw std::runtime_error("op_params_hex: whole bytes in lower-case hex, at most GGML_MAX_OP_PARAMS");
+        }
+        for (size_t c = 0; c < hex.size(); c += 2) {
+            op.params_raw.push_back((uint8_t) std::stoul(hex.substr(c, 2), nullptr, 16));
+        }
+        op.nb        = o.value("nb", std::vector<int64_t>());
+        op.view_offs = o.value("view_offs", (int64_t) 0);
+        if ((op.op == GGML_OP_UNARY) != (op.unary >= 0)) {
+            throw std::runtime_error("a GGML_OP_UNARY op needs its unary, and only it");
+        }
+        for (const json & t : o.at("src_types")) {
+            op.src_types.push_back(ext_type(t.get<std::string>()));
+        }
+        for (const json & s : o.at("src_ne")) {
+            op.src_ne.push_back(ext_shape(s));
+        }
+        op.src_nb = o.value("src_nb", std::vector<std::vector<int64_t>>(op.src_types.size()));
+        op.ne_max = ext_shape(o.value("ne_max", json::array()));
+        const json src_max = o.value("src_ne_max", json::array());
+        for (size_t s = 0; s < op.src_types.size(); ++s) {
+            op.src_ne_max.push_back(ext_shape(s < src_max.size() ? src_max[s] : json::array()));
+        }
+        const json src_min = o.value("src_ne_min", json::array());
+        for (size_t s = 0; s < op.src_types.size(); ++s) {
+            op.src_ne_min.push_back(ext_shape(s < src_min.size() ? src_min[s] : json::array()));
+        }
+
+        bool nb_ok = op.src_nb.size() == op.src_types.size() && (op.nb.empty() || op.nb.size() == GGML_MAX_DIMS);
+        for (const std::vector<int64_t> & nb : op.src_nb) {
+            nb_ok = nb_ok && (nb.empty() || nb.size() == GGML_MAX_DIMS);
+        }
+        // contiguous: true, or the node's strides (nb): a strided tensor is matched only on its exact layout
+        if (o.value("contiguous", false) != op.nb.empty() || !nb_ok || op.src_ne.size() != op.src_types.size() || op.src_types.size() > GGML_MAX_SRC) {
