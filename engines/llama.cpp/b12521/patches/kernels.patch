+// Opt-in mod: GGML_CUDA_EXT_KERNELS=<manifest.json> runs kernels named in a boltbeam.kernel_manifest.v1/v2 file in place
+// of the engine's own, for graph nodes that match an entry's ops, types and shapes (never a model or tensor name).
+// v2: an entry may take a WINDOW of N consecutive nodes (a region) with its wiring; one launch replaces all N.
+// Unset = the stock engine. This file holds no kernels: they arrive as cubin / PTX files, verified by sha256.
+// Anything that does not match or does not load falls back to the engine's own path for that node.
+// GGML_CUDA_EXT_KERNELS_CHECK=1 (with GGML_CUDA_DISABLE_GRAPHS=1) runs both and compares every live output at the
+// entry's tolerance.
+#include "ggml-impl.h"
+
+#include <cuda.h>
+#include <nlohmann/json.hpp>
+extern "C" {
+#include <sha256/sha256.h>
+}
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+int ggml_cuda_ext_kernels_run(void * stream, ggml_cgraph * cgraph, int i, bool (*stock)(void *, ggml_tensor *), void * stock_ctx);
+
+namespace {
+
+using json = nlohmann::json;
+typedef std::array<int64_t, GGML_MAX_DIMS> ext_ne;
+
+struct ext_op {
+    ggml_op                op;
+    int                    unary = -1;     // GGML_OP_UNARY: the unary op, else -1
+    ggml_type              type;
+    ext_ne                 ne;
+    std::vector<ggml_type> src_types;
+    std::vector<ext_ne>    src_ne;
+    std::vector<int>       src_node;       // per src: the window node it is (0..), or -1 = a tensor from outside
+    std::vector<std::string> src_ext;      // per outside src: its manifest name; one name = one tensor across the window
+    int                    uses = 0;       // in-window uses (filled at load)
+    std::vector<float>     params;         // the op's leading op_params as f32, matched bitwise (a scale's factor and bias)
+};
+
+struct ext_arg {
+    int      node;  // window node, or -1: a constant
+    int      src;   // -1: the node's output, 0..: its src
+    uint64_t bits;  // the constant (i32 / u32 / f32 in the low 4 bytes, i64 in 8)
+};
+
+struct ext_entry {
+    std::string                      id;
+    std::vector<ext_op>              ops;
+    std::vector<int>                 outputs;   // window nodes read outside the window
+    std::vector<std::pair<int, int>> alias_ok;  // (node, src) inputs a live output may occupy exactly (same address, size)
+    CUfunction                       fn;
+    unsigned                         grid[3], block[3], shmem;
+    bool                             pdl;  // the kernel waits (griddepcontrol.wait) before it reads a node input
+    double                           tol;  // check mode: largest allowed |ext - stock|, 0 = bit-identical
+    std::vector<ext_arg>             args;
+    uint64_t                         n_match = 0, n_check = 0, n_diff = 0, n_refused = 0;
+    double                           worst = 0;
+};
+
+ggml_type ext_type(const std::string & s) {
+    for (int t = 0; t < GGML_TYPE_COUNT; ++t) {
+        const char * name = ggml_type_name((ggml_type) t);
+        if (name != nullptr && s == name) {
+            return (ggml_type) t;
+        }
+    }
+    throw std::runtime_error("unknown type " + s);
+}
+
+ggml_op ext_op_of(const std::string & s) {
+    for (int o = 0; o < GGML_OP_COUNT; ++o) {
+        if (s == std::string("GGML_OP_") + ggml_op_name((ggml_op) o)) {
+            return (ggml_op) o;
+        }
+    }
+    throw std::runtime_error("unknown op " + s);
+}
+
+int ext_unary_of(const std::string & s) {
+    for (int u = 0; u < GGML_UNARY_OP_COUNT; ++u) {
+        if (s == std::string("GGML_UNARY_OP_") + ggml_unary_op_name((ggml_unary_op) u)) {
+            return u;
+        }
+    }
+    throw std::runtime_error("unknown unary op " + s);
+}
+
+ext_ne ext_shape(const json & j) {
+    ext_ne ne;
+    ne.fill(1);
+    for (size_t d = 0; d < j.size(); ++d) {
+        ne.at(d) = j[d].get<int64_t>();
+    }
+    return ne;
+}
+
+std::string ext_sha256(const std::string & blob) {
+    unsigned char digest[SHA256_DIGEST_SIZE];
+    char          hex[2*SHA256_DIGEST_SIZE + 1];
+    sha256_hash(digest, (const unsigned char *) blob.data(), blob.size());
+    for (int b = 0; b < SHA256_DIGEST_SIZE; ++b) {
+        snprintf(hex + 2*b, 3, "%02x", digest[b]);
+    }
+    return hex;
+}
+
+void ext_ok(CUresult r, const char * what) {
+    if (r != CUDA_SUCCESS) {
+        throw std::runtime_error(std::string(what) + " failed: " + std::to_string((int) r));
+    }
+}
+
+ext_entry ext_load_entry(const json & j, const std::string & dir, const std::string & chip, bool v2) {
+    ext_entry e;
+    e.id = j.at("id").get<std::string>();
+    if (j.at("target") != chip) {
+        throw std::runtime_error("built for " + j.at("target").get<std::string>() + ", this device is " + chip);
+    }
+    const json & ops = j.at("match").at("ops");
+    if (ops.empty() || (!v2 && ops.size() != 1)) {
+        throw std::runtime_error("a v1 entry takes a window of one op, a v2 entry at least one");
+    }
+    for (size_t k = 0; k < ops.size(); ++k) {
+        const json & o = ops[k];
+        ext_op       op;
+        op.op   = ext_op_of(o.at("op").get<std::string>());
+        op.type = ext_type(o.at("type").get<std::string>());
+        op.ne   = ext_shape(o.at("ne"));
+        if (o.contains("unary")) {
+            op.unary = ext_unary_of(o.at("unary").get<std::string>());
+        }
+        for (const json & v : o.value("op_params_f32", json::array())) {
+            op.params.push_back(v.get<float>());
+        }
+        if (op.op == GGML_OP_SCALE && op.params.size() < 2) {   // its factor and bias are the op: never match on shape alone
+            throw std::runtime_error("a GGML_OP_SCALE op needs op_params_f32 [scale, bias]");
+        }
+        if ((op.op == GGML_OP_UNARY) != (op.unary >= 0)) {
+            throw std::runtime_error("a GGML_OP_UNARY op needs its unary, and only it");
+        }
+        for (const json & t : o.at("src_types")) {
+            op.src_types.push_back(ext_type(t.get<std::string>()));
+        }
+        for (const json & s : o.at("src_ne")) {
+            op.src_ne.push_back(ext_shape(s));
+        }
+        if (!o.value("contiguous", false) || op.src_ne.size() != op.src_types.size() || op.src_types.size() > GGML_MAX_SRC) {
+            throw std::runtime_error("needs contiguous: true and one src_ne per src_types");
+        }
+        op.src_node.assign(op.src_types.size(), -1);
+        op.src_ext.assign(op.src_types.size(), "");
+        if (o.contains("src")) {   // v2 wiring: {"node": j} (an earlier window node) or {"ext": n} (from outside)
+            if (o.at("src").size() != op.src_types.size()) {
+                throw std::runtime_error("one src wiring per src_types");
+            }
+            for (size_t s = 0; s < op.src_types.size(); ++s) {
+                const json & w = o.at("src")[s];
+                if (w.contains("ext")) {
+                    op.src_ext[s] = w.at("ext").is_string() ? w.at("ext").get<std::string>() : w.at("ext").dump();
+                }
+                if (w.contains("node")) {
+                    const int n = w.at("node").get<int>();
+                    if (n < 0 || n >= (int) k) {
+                        throw std::runtime_error("a src names a window node that is not earlier");
+                    }
+                    op.src_node[s] = n;
+                    e.ops[n].uses++;
+                }
+            }
+        }
+        e.ops.push_back(op);
+    }
+    for (const json & o : j.at("match").value("outputs", json::array({(int) ops.size() - 1}))) {
+        const int n = o.get<int>();
+        if (n < 0 || n >= (int) ops.size()) {
+            throw std::runtime_error("an output names a node outside the window");
+        }
+        e.outputs.push_back(n);
+    }
+    for (size_t k = 0; k < e.ops.size(); ++k) {   // a node no window node reads must be read outside: a live output
+        if (e.ops[k].uses == 0 && std::find(e.outputs.begin(), e.outputs.end(), (int) k) == e.outputs.end()) {
+            throw std::runtime_error("node " + std::to_string(k) + " is read by no one: it must be a listed output");
+        }
+    }
+    for (const json & a : j.at("match").value("alias_ok", json::array())) {
+        e.alias_ok.emplace_back(a.at("node").get<int>(), a.at("src").get<int>());
+    }
+    const json & k = j.at("kernel");
+    std::ifstream f(dir + k.at("file").get<std::string>(), std::ios::binary);
+    std::string   blob((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+    if (!f || k.at("format") == "hsaco" || ext_sha256(blob) != k.at("sha256")) {
+        throw std::runtime_error("kernel file missing, wrong format or wrong sha256");
+    }
+    CUmodule mod;
+    ext_ok(cuModuleLoadData(&mod, blob.c_str()), "cuModuleLoadData");  // cubin or PTX, into the current (primary) context
+    ext_ok(cuModuleGetFunction(&e.fn, mod, k.at("symbol").get<std::string>().c_str()), "cuModuleGetFunction");
+    const json & l = j.at("launch");
+    for (int d = 0; d < 3; ++d) {
+        e.grid[d]  = l.at("grid").at(d).get<unsigned>();
+        e.block[d] = l.at("block").at(d).get<unsigned>();
+    }
+    e.shmem = l.value("shared_bytes", 0u);
+    e.pdl   = l.value("pdl", false);
+    e.tol   = j.value("tolerance", 0.0);
+    for (const json & a : j.at("args")) {
+        ext_arg arg = { -1, -1, 0 };
+        if (a.contains("node")) {
+            arg.node = a.at("node").get<int>();
+            arg.src  = a.at("src").get<int>();
+            if (arg.node < 0 || arg.node >= (int) e.ops.size() || arg.src < -1 || arg.src >= (int) e.ops[arg.node].src_types.size()) {
+                throw std::runtime_error("argument names a tensor outside the window");
+            }
+        } else if (a.at("type") == "f32") {
+            const float v = a.at("scalar").get<float>();
+            memcpy(&arg.bits, &v, sizeof(v));
+        } else {
+            arg.bits = (uint64_t) a.at("scalar").get<int64_t>();
+        }
+        e.args.push_back(arg);
+    }
+    return e;
+}
+
+std::vector<ext_entry> ext_load() {
+    std::vector<ext_entry> entries;
+    const std::string      path = getenv("GGML_CUDA_EXT_KERNELS");
+    try {
+        const json m = json::parse(std::ifstream(path));
+        const bool v2 = m.at("schema") == "boltbeam.kernel_manifest.v2";
+        if (!v2 && m.at("schema") != "boltbeam.kernel_manifest.v1") {
+            throw std::runtime_error("unknown schema");
+        }
+        std::string commit = ggml_commit();
+        commit             = commit.substr(0, commit.find('-'));
+        bool build_ok      = false;
+        for (const json & b : m.at("engine").at("builds")) {
+            const std::string s = b.get<std::string>();
+            const size_t      n = std::min(s.size(), commit.size());
+            build_ok            = build_ok || (n >= 7 && s.compare(0, n, commit, 0, n) == 0);
+        }
+        if (!build_ok) {
+            throw std::runtime_error("this build (" + commit + ") is not one the manifest was checked on");
+        }
+        CUdevice dev;
+        int      major = 0, minor = 0;
+        ext_ok(cuCtxGetDevice(&dev), "cuCtxGetDevice");
+        ext_ok(cuDeviceGetAttribute(&major, CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MAJOR, dev), "cuDeviceGetAttribute");
+        ext_ok(cuDeviceGetAttribute(&minor, CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MINOR, dev), "cuDeviceGetAttribute");
+        const std::string chip = "nvidia_sm" + std::to_string(10*major + minor);
+        const std::string dir  = path.substr(0, path.find_last_of('/') + 1);
+        for (const json & j : m.at("entries")) {
+            try {
+                entries.push_back(ext_load_entry(j, dir, chip, v2));
+                GGML_LOG_WARN("%s: loaded %s (%zu ops)\n", __func__, entries.back().id.c_str(), entries.back().ops.size());
+            } catch (const std::exception & err) {
+                GGML_LOG_WARN("%s: entry %s dropped, the engine's own kernel runs: %s\n", __func__, j.value("id", "?").c_str(), err.what());
+            }
+        }
+    } catch (const std::exception & err) {
+        GGML_LOG_WARN("%s: %s not used, the engine's own kernels run: %s\n", __func__, path.c_str(), err.what());
+    }
+    if (getenv("GGML_CUDA_EXT_KERNELS_CHECK") != nullptr && getenv("GGML_CUDA_DISABLE_GRAPHS") == nullptr) {
+        GGML_LOG_WARN("%s: GGML_CUDA_EXT_KERNELS_CHECK checks only uncaptured runs: set GGML_CUDA_DISABLE_GRAPHS=1\n", __func__);
+    }
+    return entries;
+}
+
+bool ext_same(const ggml_tensor * t, ggml_type type, const ext_ne & ne) {
+    return t != nullptr && t->type == type && memcmp(t->ne, ne.data(), sizeof(t->ne)) == 0 && ggml_is_contiguous(t) &&
+           (uintptr_t) t->data % 16 == 0;
+}
+
+std::vector<uint8_t> ext_read(void * stream, const ggml_tensor * t) {
+    std::vector<uint8_t> v(ggml_nbytes(t));
+    ext_ok(cuStreamSynchronize((CUstream) stream), "cuStreamSynchronize");
+    ext_ok(cuMemcpyDtoH(v.data(), (CUdeviceptr) t->data, v.size()), "cuMemcpyDtoH");
+    return v;
+}
+
+// an interior node may be a view only of an earlier window node at offset 0 (a RESHAPE / VIEW: same bytes, new shape)
+bool ext_window_view(const std::vector<ggml_tensor *> & w, int k) {
+    const ggml_tensor * t = w[k];
+    return t->view_src == nullptr || ((t->op == GGML_OP_RESHAPE || t->op == GGML_OP_VIEW) && t->view_offs == 0 &&
+                                      std::find(w.begin(), w.begin() + k, t->view_src) != w.begin() + k);
+}
+
+// the window at i for entry e, or empty: ops, types, shapes, wiring; interior nodes dead outside; no partial aliasing
+std::vector<ggml_tensor *> ext_match(ext_entry & e, ggml_cgraph * cgraph, int i) {
+    const int n = (int) e.ops.size();
+    if (i + n > cgraph->n_nodes) {
+        return {};
+    }
+    std::vector<ggml_tensor *> w(n);
+    for (int k = 0; k < n; ++k) {
+        ggml_tensor * node = cgraph->nodes[i + k];
+        const ext_op & op  = e.ops[k];
+        if (node->op != op.op || !ext_same(node, op.type, op.ne) || (op.unary >= 0 && (int) ggml_get_unary_op(node) != op.unary) ||
+            (k > 0 && (node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) ||
+            (!op.params.empty() && memcmp(node->op_params, op.params.data(), op.params.size() * sizeof(float)) != 0)) {
+            return {};
+        }
+        if (op.src_types.size() < GGML_MAX_SRC && node->src[op.src_types.size()] != nullptr) {
+            return {};
+        }
+        for (size_t s = 0; s < op.src_types.size(); ++s) {
+            if (op.src_node[s] >= 0 ? node->src[s] != w[op.src_node[s]] : !ext_same(node->src[s], op.src_types[s], op.src_ne[s])) {
+                return {};
+            }
+        }
+        w[k] = node;
+    }
+    for (int k = 0; k < n; ++k) {   // interior: read only inside the window, not a graph output, a view only of a window node
+        if (std::find(e.outputs.begin(), e.outputs.end(), k) != e.outputs.end()) {
+            continue;
+        }
+        if ((w[k]->flags & GGML_TENSOR_FLAG_OUTPUT) || !ext_window_view(w, k) || ggml_node_get_use_count(cgraph, i + k) != e.ops[k].uses) {
+            return {};
+        }
+    }
+    for (int k = 0; k < n; ++k) {   // inputs the manifest names alike (two gemvs on one activation) are one tensor
+        for (size_t s = 0; s < e.ops[k].src_ext.size(); ++s) {
+            for (int q = 0; q <= k && !e.ops[k].src_ext[s].empty(); ++q) {
+                for (size_t r = 0; r < e.ops[q].src_ext.size() && (q < k || r < s); ++r) {
+                    if (e.ops[q].src_ext[r] == e.ops[k].src_ext[s] && w[q]->src[r] != w[k]->src[s]) {
+                        return {};
+                    }
+                }
+            }
+        }
+    }
+    for (int o : e.outputs) {       // written ranges against every input from outside: disjoint, or exactly one allowed input
+        const char * a0 = (const char *) w[o]->data, * a1 = a0 + ggml_nbytes(w[o]);
+        for (int k = 0; k < n; ++k) {
+            for (size_t s = 0; s < e.ops[k].src_types.size(); ++s) {
+                if (e.ops[k].src_node[s] >= 0) {
+                    continue;
+                }
+                const ggml_tensor * x  = w[k]->src[s];
+                const char *        b0 = (const char *) x->data, * b1 = b0 + ggml_nbytes(x);
+                if (b1 <= a0 || a1 <= b0) {
+                    continue;
+                }
+                const bool exact = a0 == b0 && a1 == b1 &&
+                                   std::find(e.alias_ok.begin(), e.alias_ok.end(), std::make_pair(k, (int) s)) != e.alias_ok.end();
+                if (!exact) {
+                    if (e.n_refused++ == 0) {
+                        GGML_LOG_WARN("%s: %s refused at node %d: output %d overlaps input (%d, %zu); the engine's own kernels run\n",
+                                      __func__, e.id.c_str(), i, o, k, s);
+                    }
+                    return {};
+                }
+            }
+        }
+    }
+    return w;
+}
+
+// GGML_CUDA_EXT_KERNELS_DUMP=<file>: append each graph shape the hook sees once (JSON lines: per node its op, unary,
+// type, ne, contiguity, use count, output flag and sources as a node index or an outside tensor's type/ne). The input
+// of the region finder: windows come from the engine's own graph, never from a hand table.
+void ext_dump(const ggml_cgraph * cgraph) {
+    static const char *          path = getenv("GGML_CUDA_EXT_KERNELS_DUMP");
+    static std::vector<uint64_t> seen;
+    static const ggml_cgraph *   last = nullptr;
+    static int                   last_n = -1;
+    if (path == nullptr || (cgraph == last && cgraph->n_nodes == last_n) || seen.size() >= 4096) {
+        return;
+    }
+    last = cgraph; last_n = cgraph->n_nodes;
+    uint64_t h = 1469598103934665603ull;   // the graph's shape: ops and output shapes (FNV-1a)
+    for (int k = 0; k < cgraph->n_nodes; ++k) {
+        const ggml_tensor * t = cgraph->nodes[k];
+        for (uint64_t v : { (uint64_t) t->op, (uint64_t) t->ne[0], (uint64_t) t->ne[1], (uint64_t) t->ne[2] }) {
+            h = (h ^ v) * 1099511628211ull;
+        }
+    }
+    if (std::find(seen.begin(), seen.end(), h) != seen.end()) {
+        return;
+    }
+    seen.push_back(h);
+    json nodes = json::array();
+    for (int k = 0; k < cgraph->n_nodes; ++k) {
+        const ggml_tensor * t = cgraph->nodes[k];
+        json n = {{"i", k}, {"op", std::string("GGML_OP_") + ggml_op_name(t->op)}, {"type", ggml_type_name(t->type)},
+                  {"ne", {t->ne[0], t->ne[1], t->ne[2], t->ne[3]}}, {"contiguous", ggml_is_contiguous(t)}, {"view", t->view_src != nullptr},
+                  {"uses", ggml_node_get_use_count(cgraph, k)}, {"output", (t->flags & GGML_TENSOR_FLAG_OUTPUT) != 0}, {"name", t->name}};
+        if (t->op == GGML_OP_UNARY) {
+            n["unary"] = std::string("GGML_UNARY_OP_") + ggml_unary_op_name(ggml_get_unary_op(t));
+        }
+        json src = json::array();
+        for (int s = 0; s < GGML_MAX_SRC && t->src[s] != nullptr; ++s) {
+            int j = -1;
+            for (int q = k - 1; q >= 0 && j < 0; --q) {
+                j = cgraph->nodes[q] == t->src[s] ? q : -1;
+            }
+            const ggml_tensor * x = t->src[s];
+            src.push_back(j >= 0 ? json{{"node", j}} : json{{"type", ggml_type_name(x->type)}, {"ne", {x->ne[0], x->ne[1], x->ne[2], x->ne[3]}},
+                                                          {"contiguous", ggml_is_contiguous(x)}});
+        }
+        n["src"] = src;
+        nodes.push_back(n);
+    }
+    std::ofstream(path, std::ios::app) << json{{"schema", "boltbeam.engine_graph_dump.v1"}, {"n_nodes", cgraph->n_nodes}, {"nodes", nodes}}.dump() << "\n";
+}
+
+}  // namespace
+
+// Returns the number of nodes the external kernel replaced (the window's length), or 0: the engine's own path runs.
+int ggml_cuda_ext_kernels_run(void * stream, ggml_cgraph * cgraph, int i, bool (*stock)(void *, ggml_tensor *), void * stock_ctx) {
+    static std::vector<ext_entry> entries = ext_load();
+    static const bool             check   = getenv("GGML_CUDA_EXT_KERNELS_CHECK") != nullptr;
+    static const bool             pdl_on  = getenv("GGML_CUDA_PDL") == nullptr || atoi(getenv("GGML_CUDA_PDL")) != 0;
+    ext_dump(cgraph);   // once per graph shape, only with GGML_CUDA_EXT_KERNELS_DUMP set
+
+    for (ext_entry & e : entries) {
+        const std::vector<ggml_tensor *> w = ext_match(e, cgraph, i);
+        if (w.empty()) {
+            continue;
+        }
+        std::vector<uint64_t> values;
+        std::vector<void *>   params;
+        for (const ext_arg & a : e.args) {
+            values.push_back(a.node < 0 ? a.bits : (uint64_t) (uintptr_t) (a.src == -1 ? w[a.node] : w[a.node]->src[a.src])->data);
+        }
+        for (uint64_t & v : values) {
+            params.push_back(&v);
+        }
+        CUstreamCaptureStatus capture = CU_STREAM_CAPTURE_STATUS_NONE;
+        const bool do_check = check && cuStreamIsCapturing((CUstream) stream, &capture) == CUDA_SUCCESS &&
+                              capture == CU_STREAM_CAPTURE_STATUS_NONE;
+        std::vector<std::pair<const ggml_tensor *, std::vector<uint8_t>>> saved;  // inputs a live output occupies
+        if (do_check) {
+            for (const auto & [k, s] : e.alias_ok) {
+                for (int o : e.outputs) {
+                    if (w[o]->data == w[k]->src[s]->data) {
+                        saved.emplace_back(w[k]->src[s], ext_read(stream, w[k]->src[s]));
+                    }
+                }
+            }
+        }
+        CUlaunchAttribute attr;
+        attr.id                                         = CU_LAUNCH_ATTRIBUTE_PROGRAMMATIC_STREAM_SERIALIZATION;
+        attr.value.programmaticStreamSerializationAllowed = 1;
+        CUlaunchConfig cfg = {};
+        cfg.gridDimX       = e.grid[0];
+        cfg.gridDimY       = e.grid[1];
+        cfg.gridDimZ       = e.grid[2];
+        cfg.blockDimX      = e.block[0];
+        cfg.blockDimY      = e.block[1];
+        cfg.blockDimZ      = e.block[2];
+        cfg.sharedMemBytes = e.shmem;
+        cfg.hStream        = (CUstream) stream;
+        cfg.attrs          = &attr;
+        cfg.numAttrs       = e.pdl && pdl_on ? 1 : 0;
+        if (const CUresult r = cuLaunchKernelEx(&cfg, e.fn, params.data(), nullptr); r != CUDA_SUCCESS) {
+            GGML_LOG_WARN("%s: %s launch failed (%d), the engine's own kernel runs\n", __func__, e.id.c_str(), (int) r);
+            return 0;
+        }
+        if (e.n_match++ == 0) {
+            GGML_LOG_WARN("%s: %s first match at node %d (%s), %zu nodes\n", __func__, e.id.c_str(), i, w[0]->name, w.size());
+        }
+        if (do_check) {
+            std::vector<std::vector<uint8_t>> ext;
+            for (int o : e.outputs) {
+                ext.push_back(ext_read(stream, w[o]));
+            }
+            for (const auto & [t, bytes] : saved) {   // put back what the external kernel overwrote, then run stock
+                ext_ok(cuMemcpyHtoD((CUdeviceptr) t->data, bytes.data(), bytes.size()), "cuMemcpyHtoD");
+            }
+            for (ggml_tensor * node : w) {
+                GGML_ASSERT(stock(stock_ctx, node));
+            }
+            double worst = 0;
+            for (size_t q = 0; q < e.outputs.size(); ++q) {
+                const ggml_tensor *        t   = w[e.outputs[q]];
+                const std::vector<uint8_t> ref = ext_read(stream, t);  // the engine's result stays in the node
+                for (size_t b = 0; b < ref.size(); b += 4) {
+                    if (memcmp(&ext[q][b], &ref[b], 4) != 0) {  // bitwise first: a NaN or a signed zero counts
+                        float x, y;
+                        memcpy(&x, &ext[q][b], 4);
+                        memcpy(&y, &ref[b], 4);
+                        const double d = t->type == GGML_TYPE_F32 ? fabs((double) x - y) : INFINITY;
+                        worst          = d > 0 ? std::max(worst, d) : INFINITY;
+                    }
+                }
+            }
+            e.worst = std::max(e.worst, worst);
+            if (worst > e.tol) {
+                e.n_diff++;
+                GGML_LOG_WARN("GGML_CUDA_EXT_KERNELS_CHECK differs: %s worst |ext - stock| %g > %g\n", e.id.c_str(), worst, e.tol);
+            }
+            if (e.n_check++ % 256 == 0) {
+                GGML_LOG_WARN("GGML_CUDA_EXT_KERNELS_CHECK %s: %s checks %llu, differ %llu, worst %g\n", e.n_diff ? "DIFF" : "ok",
+                              e.id.c_str(), (unsigned long long) e.n_check, (unsigned long long) e.n_diff, e.worst);
+            }
+        }
+        return (int) w.size();
+    }
+    return 0;
+}
