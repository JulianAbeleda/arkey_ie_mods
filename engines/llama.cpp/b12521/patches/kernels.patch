+        }
+        for (size_t s = 0; s <= op.src_types.size(); ++s) {   // a wildcard (the node, then each src): a launches entry, bounded
+            const bool                   self = s == op.src_types.size();
+            const ext_ne &               ne = self ? op.ne : op.src_ne[s], & mx = self ? op.ne_max : op.src_ne_max[s];
+            const std::vector<int64_t> & nb = self ? op.nb : op.src_nb[s];
+            for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+                if ((ne[d] < 0 && (!multi || ne[d] != -1 || mx[d] <= 1)) || (!nb.empty() && nb[d] < 0 && (!multi || nb[d] != -1))) {
+                    throw std::runtime_error("-1 (any) in ne / nb: a launches entry only, an ne -1 with its bound in ne_max / src_ne_max");
+                }
+            }
+        }
+        op.src_node.assign(op.src_types.size(), -1);
+        op.src_ext.assign(op.src_types.size(), "");
+        if (o.contains("src")) {   // v2 wiring: {"node": j} (an earlier window node) or {"ext": n} (from outside)
+            if (o.at("src").size() != op.src_types.size()) {
+                throw std::runtime_error("one src wiring per src_types");
+            }
+            for (size_t s = 0; s < op.src_types.size(); ++s) {
+                const json & w = o.at("src")[s];
+                if (w.contains("ext")) {
+                    op.src_ext[s] = w.at("ext").is_string() ? w.at("ext").get<std::string>() : w.at("ext").dump();
+                }
+                if (w.contains("node")) {
+                    const int n = w.at("node").get<int>();
+                    const bool self = n == (int) k && op.op == GGML_OP_CPY && s == 1;   // a cast: its src 1 is the node itself
+                    if (n < 0 || (n >= (int) k && !self)) {
+                        throw std::runtime_error("a src names a window node that is not earlier");
+                    }
+                    op.src_node[s] = n;
+                    (self ? op : e.ops[n]).uses++;
+                }
+            }
+        }
+        e.ops.push_back(op);
+    }
+    for (const json & o : j.at("match").value("outputs", json::array({(int) ops.size() - 1}))) {
+        const int n = o.get<int>();
+        if (n < 0 || n >= (int) ops.size()) {
+            throw std::runtime_error("an output names a node outside the window");
+        }
+        e.outputs.push_back(n);
+    }
+    for (size_t k = 0; k < e.ops.size(); ++k) {   // a node no window node reads must be read outside: a live output
+        if (e.ops[k].uses == 0 && std::find(e.outputs.begin(), e.outputs.end(), (int) k) == e.outputs.end()) {
+            throw std::runtime_error("node " + std::to_string(k) + " is read by no one: it must be a listed output");
+        }
+    }
+    std::vector<bool> fixed(e.ops.size());   // a node whose value the entry fixes: every src a fixed window node (an ARANGE has none)
+    for (size_t k = 0; k < e.ops.size(); ++k) {   // a SET_ROWS writes into its src 2: a listed output; its rows fixed, its destination a window view
+        const ext_op & op = e.ops[k];
+        fixed[k]          = op.op == GGML_OP_ARANGE || (!op.src_node.empty() && (op.op == GGML_OP_SCALE || op.op == GGML_OP_CPY || op.op == GGML_OP_VIEW || op.op == GGML_OP_RESHAPE));
+        for (size_t s = 0; s < op.src_node.size(); ++s) {
+            fixed[k] = fixed[k] && op.src_node[s] >= 0 && (op.src_node[s] == (int) k || fixed[op.src_node[s]]);
+        }
+        if (op.op == GGML_OP_SET_ROWS && (std::find(e.outputs.begin(), e.outputs.end(), (int) k) == e.outputs.end() || op.src_node.size() != 3 ||
+                                          op.src_node[1] < 0 || !fixed[op.src_node[1]] || op.src_node[2] < 0 || e.ops[op.src_node[2]].src_node.empty() ||
+                                          e.ops[op.src_node[2]].src_node[0] >= 0 || e.ops[op.src_node[2]].uses != 1)) {
+            throw std::runtime_error("a GGML_OP_SET_ROWS must be a listed output, its rows (src 1) fixed by the window, its destination (src 2) a window view of an outside tensor");
+        }
+        e.inplace = e.inplace || op.op == GGML_OP_SET_ROWS;
+    }
+    for (const json & a : j.at("match").value("alias_ok", json::array())) {
+        e.alias_ok.emplace_back(a.at("node").get<int>(), a.at("src").get<int>());
+        if (ext_is_view(e.ops.at(e.alias_ok.back().first).op)) {   // a view reads no bytes: an output on its src is a state write
+            throw std::runtime_error("alias_ok names a view's src");
+        }
+    }
+    if (multi && (!v2 || j.contains("kernel") || j.contains("launch") || j.contains("args") || j.at("launches").empty())) {
+        throw std::runtime_error("launches: a v2 entry only, non-empty, in place of kernel / launch / args");
+    }
+    e.launches.reserve(multi ? j.at("launches").size() : 1);
+    for (const json & s : j.value("scratch", json::array())) {   // slots 0..n-1, each 256-byte aligned in one block
+        if (!multi || s.at("slot").get<size_t>() != e.scratch.size() || s.at("bytes").get<int64_t>() <= 0) {
+            throw std::runtime_error("scratch: slots 0..n-1 in order, bytes > 0, with launches only");
+        }
+        e.scratch.push_back(e.scratch.empty() ? 0 : e.scratch.back());
+        e.scratch.back() += (s.at("bytes").get<size_t>() + 255) / 256 * 256;
+    }
+    e.scratch.insert(e.scratch.begin(), 0);   // e.scratch[s]: slot s's offset; back(): the block's bytes
+    std::vector<bool> named(e.scratch.size() - 1), written(e.ops.size());   // written: by an earlier launch
+    // a node's bytes are held: an outside tensor, written by an earlier launch, or a view of a held node
+    std::function<bool(int)> held = [&](int m) { return m < 0 || written[m] || (ext_is_view(e.ops[m].op) && held(e.ops[m].src_node[0])); };
+    auto node_ref = [&](const json & r, bool dim) {   // {"node": k, "src": s} or [node, src, dim]: a tensor of the window
+        ext_arg a = { r.is_array() ? r.at(0).get<int>() : r.at("node").get<int>(), r.is_array() ? r.at(1).get<int>() : r.at("src").get<int>(), 0 };
+        a.dim = dim ? r.at(2).get<int>() : -1;
+        if (a.node < 0 || a.node >= (int) e.ops.size() || a.src < -1 || a.src >= (int) e.ops[a.node].src_types.size() || (dim && (a.dim < 0 || a.dim >= GGML_MAX_DIMS))) {
+            throw std::runtime_error("argument names a tensor outside the window");
+        }
+        return a;
+    };
+    const ext_kvs * kvs = nullptr;   // the kv-stream step, once it has run: later args naming its K / V take its pointers
+    for (const json & q : multi ? j.at("launches") : json::array({j})) {
+        ext_launch L;
+        std::vector<int> writes;
+        if (multi && q.contains("kv_stream")) {   // K, V, mask (node, src); lists / counts (scratch slots, written before)
+            const json & kq = q.at("kv_stream");
+            L.is_kvs = true;
+            L.kvs    = { node_ref(kq.at("k"), false), node_ref(kq.at("v"), false), node_ref(kq.at("mask"), false), kq.at("lists").get<int>(),
+                         kq.at("counts").get<int>(), kq.at("n_lists").get<int64_t>(), kq.at("n_kv_max").get<int64_t>(), kq.value("ncols1", (int64_t) 1) };
+            const ext_kvs & K = L.kvs;
+            if (kvs != nullptr || K.k.src < 0 || K.v.src < 0 || K.mask.src < 0 || !held(e.ops[K.k.node].src_node[K.k.src]) ||
+                !held(e.ops[K.v.node].src_node[K.v.src]) || !held(e.ops[K.mask.node].src_node[K.mask.src]) || K.n_lists <= 0 || K.n_kv_max <= 0 || K.ncols1 <= 0 || K.lists < 0 || K.counts < 0 || K.lists == K.counts ||
+                K.lists >= (int) named.size() || K.counts >= (int) named.size() || e.scratch[K.lists + 1] - e.scratch[K.lists] < (size_t) (K.n_lists*K.n_kv_max*4) ||
+                e.scratch[K.counts + 1] - e.scratch[K.counts] < (size_t) (K.n_lists*4) || !named[K.lists] || !named[K.counts]) {
+                throw std::runtime_error("kv_stream: one step; k / v / mask inputs; lists and counts two slots an earlier launch names, of n_lists x n_kv_max / n_lists i32");
+            }
+            e.launches.push_back(L);
+            kvs = &e.launches.back().kvs;   // reserved below: no reallocation while launches are parsed
+            continue;
+        }
+        const json & k = q.at("kernel");
+        std::ifstream f(dir + k.at("file").get<std::string>(), std::ios::binary);
+        std::string   blob((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+        if (!f || k.at("format") == "hsaco" || ext_sha256(blob) != k.at("sha256")) {
+            throw std::runtime_error("kernel file missing, wrong format or wrong sha256");
+        }
+        CUmodule mod;
+        ext_ok(cuModuleLoadData(&mod, blob.c_str()), "cuModuleLoadData");  // cubin or PTX, into the current (primary) context
+        ext_ok(cuModuleGetFunction(&L.fn, mod, k.at("symbol").get<std::string>().c_str()), "cuModuleGetFunction");
+        const json & l = q.at("launch");
+        for (int d = 0; d < 3; ++d) {
+            L.grid[d]  = l.at("grid").at(d).get<unsigned>();
+            L.block[d] = l.at("block").at(d).get<unsigned>();
+        }
+        L.shmem = l.value("shared_bytes", 0u);
+        L.pdl   = l.value("pdl", false) && !e.inplace;   // a state write never starts before the kernel ahead of it has ended
+        if (multi) {   // what would fail at launch fails here: no sequence stops half way on a launch error
+            int max_threads = 0;
+            ext_ok(cuFuncGetAttribute(&max_threads, CU_FUNC_ATTRIBUTE_MAX_THREADS_PER_BLOCK, L.fn), "cuFuncGetAttribute");
+            int grid_max[3], smem_static = 0, smem_max = 0;
+            CUdevice dev;
+            ext_ok(cuCtxGetDevice(&dev), "cuCtxGetDevice");
+            for (int d = 0; d < 3; ++d) {
+                ext_ok(cuDeviceGetAttribute(&grid_max[d], (CUdevice_attribute) (CU_DEVICE_ATTRIBUTE_MAX_GRID_DIM_X + d), dev), "cuDeviceGetAttribute");
+            }
+            ext_ok(cuDeviceGetAttribute(&smem_max, CU_DEVICE_ATTRIBUTE_MAX_SHARED_MEMORY_PER_BLOCK_OPTIN, dev), "cuDeviceGetAttribute");
+            ext_ok(cuFuncGetAttribute(&smem_static, CU_FUNC_ATTRIBUTE_SHARED_SIZE_BYTES, L.fn), "cuFuncGetAttribute");
+            bool ok = (int64_t) L.block[0] * L.block[1] * L.block[2] <= max_threads && (int64_t) smem_static + L.shmem <= smem_max;
+            for (int d = 0; d < 3; ++d) {
+                ok = ok && L.grid[d] >= 1 && L.block[d] >= 1 && L.grid[d] <= (unsigned) grid_max[d];
+            }
+            if (!ok) {
+                throw std::runtime_error("a launch's grid, block or shared memory is outside what its kernel and this device allow");
+            }
+            if (L.shmem > 48*1024) {
+                ext_ok(cuFuncSetAttribute(L.fn, CU_FUNC_ATTRIBUTE_MAX_DYNAMIC_SHARED_SIZE_BYTES, (int) L.shmem), "cuFuncSetAttribute");
+            }
+        }
+        for (const json & a : q.at("args")) {
+            ext_arg arg = { -1, -1, 0 };
+            if (multi && a.contains("scratch") && !a.contains("node")) {
+                arg.scratch = a.at("scratch").get<int>();
+                if (arg.scratch < 0 || arg.scratch >= (int) named.size()) {
+                    throw std::runtime_error("argument names a scratch slot the entry does not declare");
+                }
+                named[arg.scratch] = true;
+            } else if (multi && a.contains("ne") && !a.contains("node")) {   // a run-time extent: metadata, no bytes read
+                arg = node_ref(a.at("ne"), true);
+            } else if (a.contains("node")) {
+                arg = node_ref(a, false);
+                const std::string & x = arg.src >= 0 ? e.ops[arg.node].src_ext[arg.src] : "";
+                if (kvs != nullptr && ((arg.node == kvs->mask.node && arg.src == kvs->mask.src) || (!x.empty() && x == e.ops[kvs->mask.node].src_ext[kvs->mask.src]))) {
+                    throw std::runtime_error("a launch after the kv_stream step reads its mask (its columns no longer match the rewritten lists)");
+                }
+                arg.kv = kvs != nullptr;   // K / V by address at run time: any route to them takes the step's pointers
+                if (arg.src == 0 && ext_is_view(e.ops[arg.node].op) && e.ops[arg.node].src_node[0] < 0) {   // its offset is a run-time value
+                    throw std::runtime_error("argument names the tensor a view is of: pass the view (src -1)");
+                }
+                const bool out = std::find(e.outputs.begin(), e.outputs.end(), arg.node) != e.outputs.end();
+                if (multi && arg.src == -1 && !out) {   // the allocator may alias interior tensors: a cut value goes to scratch
+                    throw std::runtime_error("a launch writes node " + std::to_string(arg.node) + ", not a listed output: pass a scratch slot");
+                }
+                const int m = arg.src >= 0 ? e.ops[arg.node].src_node[arg.src] : -1;   // a cast's src 1 is the node itself
+                if (multi && m != arg.node && !held(m)) {   // a cut value no earlier launch wrote
+                    throw std::runtime_error("a launch reads node " + std::to_string(m) + ", which no earlier launch wrote: pass a scratch slot");
+                }
+                if (arg.src == -1 && out) {
+                    writes.push_back(arg.node);
+                    L.state = L.state || !e.alias_ok.empty() || e.ops[arg.node].op == GGML_OP_SET_ROWS;
+                }
+            } else if (a.at("type") == "f32") {
+                const float v = a.at("scalar").get<float>();
+                memcpy(&arg.bits, &v, sizeof(v));
+            } else {
+                arg.bits = (uint64_t) a.at("scalar").get<int64_t>();
+            }
+            L.args.push_back(arg);
+        }
+        for (int m : writes) {   // a full view (RESHAPE / TRANSPOSE / PERMUTE) of a window node writes that node's bytes
+            for (; m >= 0 && !written[m]; m = ext_is_view(e.ops[m].op) && e.ops[m].op != GGML_OP_VIEW ? e.ops[m].src_node[0] : -1) {
+                written[m] = true;
+            }
+        }
+        e.launches.push_back(L);
+    }
+    for (size_t s = 0; s < named.size(); ++s) {
+        if (!named[s]) {
+            throw std::runtime_error("scratch slot " + std::to_string(s) + " is named by no launch");
+        }
+    }
+    for (int o : e.outputs) {   // a view's bytes are those of the node it views
+        if (multi && !held(o)) {
+            throw std::runtime_error("output " + std::to_string(o) + " is written by no launch");
+        }
+    }
+    for (size_t q = 1; q < e.launches.size(); ++q) {   // a launch after a state write waits for it: no early start
+        e.launches[q].state = e.launches[q].state || e.launches[q - 1].state;
