+    }
+    e.tol = j.value("tolerance", 0.0);
+    if (j.value("tolerance_mode", "abs") != "abs" && j.value("tolerance_mode", "abs") != "rel_max") {
+        throw std::runtime_error("tolerance_mode: abs or rel_max");
+    }
+    e.rel = j.value("tolerance_mode", "abs") == "rel_max";
+    return e;
+}
