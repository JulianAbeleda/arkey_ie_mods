+// GGML_CUDA_GRAPH_MAX_KEYS=K (local mod, off by default): at most K cached graphs (keys) per context hold CUDA graph
+// executables. A sched reserve (e.g. a sampler change) moves the ggml graph to new addresses, so its key changes and the
+// old key is dead; stock keeps dead keys and their executables for 10 s. Before a new key creates its first executable,
+// whole graphs other than it are destroyed, least recently used first, until fewer than K hold executables. Device
+// memory in executables is then bounded per context by K x chunks per graph x the size of one. Unset or 0 = stock.
+// GGML_CUDA_GRAPH_STATS=1 logs each executable created, updated or re-instantiated: live executables, cached graphs,
+// evictions and free device memory (it synchronizes the stream around each: diagnostics only).
+static size_t ggml_cuda_graph_live(const ggml_backend_cuda_context * cuda_ctx) {
+    size_t n = 0;
+    for (const auto & [key, g] : cuda_ctx->cuda_graphs) {
+        n += g->instances.size();
+    }
+    return n;
+}
+
+static int64_t ggml_cuda_graph_env(const char * name) {
+    const char * e = getenv(name);
+    return e ? atoll(e) : 0;
+}
+
+static size_t ggml_cuda_graph_evicted = 0;
+
+static void ggml_cuda_graph_cap(ggml_backend_cuda_context * cuda_ctx, const ggml_cuda_graph * keep) {
+    static const int64_t max_keys = ggml_cuda_graph_env("GGML_CUDA_GRAPH_MAX_KEYS");
+    if (max_keys <= 0) {
+        return;
+    }
+    for (;;) {
+        int64_t n_keys = 0;
+        auto lru = cuda_ctx->cuda_graphs.end();
+        for (auto it = cuda_ctx->cuda_graphs.begin(); it != cuda_ctx->cuda_graphs.end(); ++it) {
+            if (it->second.get() == keep || it->second->instances.empty()) {
+                continue;
+            }
+            n_keys++;
+            if (lru == cuda_ctx->cuda_graphs.end() || it->second->last_used_time < lru->second->last_used_time) {
+                lru = it;
+            }
+        }
+        if (n_keys < max_keys) {
+            return;
+        }
+        cuda_ctx->cuda_graphs.erase(lru);
+        ggml_cuda_graph_evicted++;
+    }
