+// LLAMA_MOE_INPLACE: sets the per-expert byte offsets (n of them, 0 = read the copy) that the MMQ MUL_MAT_ID `node` adds to the
+// base of its weights `w`, a compute-buffer copy of host experts that the caller fills only where the offset is 0.
+// delta == nullptr clears the offsets of w. Returns false if node does not run the MMQ kernel: the caller then fills all of w.
+static bool ggml_backend_cuda_mmid_inplace(ggml_backend_t backend, const ggml_tensor * node, const ggml_tensor * w, const int64_t * delta, int64_t n) {
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    auto it = cuda_ctx->mmid_inplace.find(w->data);
+    bool ok = delta != nullptr && n <= ggml_backend_cuda_context::mmid_inplace_max;
+    if (ok) {
+        const int cc = ggml_cuda_info().devices[cuda_ctx->device].cc;
+        ok = node->op == GGML_OP_MUL_MAT_ID && node->src[0] == w && node->type == GGML_TYPE_F32 && node->src[1]->type == GGML_TYPE_F32 &&
+            node->ne[2] > MMVQ_MAX_BATCH_SIZE && ggml_cuda_should_use_mmq(w->type, cc, node->src[1]->ne[2], w->ne[2]);
+    }
+    if (!ok && (it == cuda_ctx->mmid_inplace.end() || it->second.n_set == 0)) {
+        return false; // nothing to clear
+    }
+    ggml_cuda_set_device(cuda_ctx->device);
+    if (it == cuda_ctx->mmid_inplace.end()) {
+        it = cuda_ctx->mmid_inplace.emplace(w->data, ggml_backend_cuda_context::mmid_inplace_entry()).first;
+        CUDA_CHECK(cudaMalloc(&it->second.delta, ggml_backend_cuda_context::mmid_inplace_max*sizeof(int64_t)));
+    }
+    if (ok) {
+        // pageable memory: the copy is staged before the call returns
+        CUDA_CHECK(cudaMemcpyAsync(it->second.delta, delta, n*sizeof(int64_t), cudaMemcpyHostToDevice, cuda_ctx->stream()));
+        it->second.n_set = n;
+    } else {
+        CUDA_CHECK(cudaMemsetAsync(it->second.delta, 0, it->second.n_set*sizeof(int64_t), cuda_ctx->stream()));
+        it->second.n_set = 0;
+    }
+    return ok;
+}
