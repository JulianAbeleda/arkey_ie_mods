+                ++ckpt_chk_n_restore, cur.n_tokens, new_tgt.size(), new_dft.size(), d_tgt, d_dft, d_blob);
+        if (d_tgt || d_dft) {
+            GGML_ABORT("LLAMA_CKPT_PINNED_CHECK: restored state differs from the stock restore\n");
+        }
+    }
