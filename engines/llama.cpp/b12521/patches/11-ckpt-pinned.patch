+    // LOCAL (ckpt-pinned): LLAMA_CKPT_PINNED_CHECK=1 - every checkpoint save is also taken through the stock pageable
+    // path and compared; every restore loads the stock copy and the pooled copy and compares the two restored states
+    const bool ckpt_pinned_check = [] { const char * e = getenv("LLAMA_CKPT_PINNED_CHECK"); return e && atoi(e) != 0; }();
+    size_t ckpt_chk_n_save = 0, ckpt_chk_n_restore = 0;
+
+    static std::vector<uint8_t> ckpt_chk_read(llama_context * ctx, llama_seq_id id) {
+        std::vector<uint8_t> res(ctx ? llama_state_seq_get_size_ext(ctx, id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) : 0);
+        if (ctx) {
+            GGML_ASSERT(llama_state_seq_get_data_ext(ctx, res.data(), res.size(), id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) == res.size());
+        }
+        return res;
+    }
+
+    static size_t ckpt_chk_diff(const uint8_t * a, size_t na, const uint8_t * b, size_t nb) {
+        size_t n = na > nb ? na - nb : nb - na;
+        for (size_t i = 0; i < std::min(na, nb); i++) {
+            n += a[i] != b[i];
+        }
+        return n;
+    }
+
+    void ckpt_chk_save(server_slot & slot, common_prompt_checkpoint & cur) {
+        cur.chk_tgt = ckpt_chk_read(ctx_tgt, slot.id);
+        cur.chk_dft = ckpt_chk_read(ctx_dft, slot.id);
+        const size_t d_tgt = ckpt_chk_diff(cur.chk_tgt.data(), cur.chk_tgt.size(), cur.data_tgt.data(), cur.data_tgt.size());
+        const size_t d_dft = ckpt_chk_diff(cur.chk_dft.data(), cur.chk_dft.size(), cur.data_dft.data(), cur.data_dft.size());
+        SLT_INF(slot, "ckpt_pinned check: save %zu n_tokens = %" PRId64 ", tgt %zu bytes, dft %zu bytes, differing bytes vs stock save: tgt %zu, dft %zu\n",
+                ++ckpt_chk_n_save, cur.n_tokens, cur.data_tgt.size(), cur.data_dft.size(), d_tgt, d_dft);
+        if (d_tgt || d_dft) {
+            GGML_ABORT("LLAMA_CKPT_PINNED_CHECK: saved checkpoint differs from the stock save\n");
+        }
+    }
+
+    // called after the checkpoint was restored from its own (pooled) buffers
+    void ckpt_chk_restore(server_slot & slot, const common_prompt_checkpoint & cur) {
+        if (cur.chk_tgt.size() != cur.data_tgt.size()) {
+            return; // not created under the check (e.g. loaded from a slot file)
+        }
+        const auto new_tgt = ckpt_chk_read(ctx_tgt, slot.id);
+        const auto new_dft = ckpt_chk_read(ctx_dft, slot.id);
+        GGML_ASSERT(llama_state_seq_set_data_ext(ctx_tgt, cur.chk_tgt.data(), cur.chk_tgt.size(), slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) == cur.chk_tgt.size());
+        if (ctx_dft && !cur.chk_dft.empty()) {
+            GGML_ASSERT(llama_state_seq_set_data_ext(ctx_dft, cur.chk_dft.data(), cur.chk_dft.size(), slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) == cur.chk_dft.size());
+        }
+        const auto old_tgt = ckpt_chk_read(ctx_tgt, slot.id);
+        const auto old_dft = ckpt_chk_read(ctx_dft, slot.id);
+        const size_t d_tgt = ckpt_chk_diff(old_tgt.data(), old_tgt.size(), new_tgt.data(), new_tgt.size());
+        const size_t d_dft = ckpt_chk_diff(old_dft.data(), old_dft.size(), new_dft.data(), new_dft.size());
+        const size_t d_blob = ckpt_chk_diff(new_tgt.data(), new_tgt.size(), cur.data_tgt.data(), cur.data_tgt.size());
+        // leave the context as the pooled restore left it
+        GGML_ASSERT(cur.load_tgt(ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) && cur.load_dft(ctx_dft, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY));
