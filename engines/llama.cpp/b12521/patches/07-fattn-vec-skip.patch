+// LLAMA_FATTN_VEC_SKIP=1 (local long-context mod, off by default): calls that take the vector kernel with q8_0 K/V and a
+// selection mask (the graph passes n_kv_max > 0, e.g. the MTP draft's one-token passes) skip the masked K/V rows instead
+// of reading the whole cache. One query only: the 2-column instance with the skips compiled in rounded differently
+// from the stock one (1-4 ulp, check run C3), the 1-column instance matches it bit for bit. Same kernel, same order of the remaining terms: the output is the stock output.
+// LLAMA_FATTN_VEC_SKIP_CHECK=N also runs the stock kernel on every Nth such call (needs GGML_CUDA_DISABLE_GRAPHS=1)
+// and aborts if any output value differs.
+bool ggml_cuda_flash_attn_ext_vec_skip(const ggml_tensor * dst) {
+    static const bool on = sparse_direct_env("LLAMA_FATTN_VEC_SKIP") != 0;
+    if (!on || sparse_direct_off) {
+        return false;
+    }
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+    float max_bias = 0.0f, logit_softcap = 0.0f;
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+    return dst->src[3] != nullptr && max_bias == 0.0f && logit_softcap == 0.0f && Q->ne[0] >= 128 && Q->ne[1] == 1 && Q->ne[3] == 1 &&
+        K->type == GGML_TYPE_Q8_0 && V->type == GGML_TYPE_Q8_0 && ggml_get_op_params_i32(dst, 4) > 0 &&
+        ggml_cuda_get_best_fattn_kernel(ggml_cuda_get_device(), dst) == BEST_FATTN_KERNEL_VEC;
+}
