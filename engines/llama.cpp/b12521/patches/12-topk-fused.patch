-static void top_k_radix_cuda(
+// LLAMA_TOPK_FUSED=1 (local long-context mod, off by default): the radix top-k of a few rows in ONE launch instead of ten.
+// The blocks of a row meet at a barrier after each radix pass (a persistent, self-clearing arrival counter per row), then
+// every block sums the same block histograms and derives the same state, so no select kernel is needed; the bin is found
+// with a parallel suffix sum instead of the serial scan. Same threshold key, same tie count, same gather rule as the
+// stock kernels: picks above the threshold in atomicAdd order (no fixed order, as stock), ties in the last slots in
+// ascending column order. All blocks must be resident at once for the barrier: the caller keeps the grid <= nsm.
+// LLAMA_TOPK_FUSED_CHECK=1 (with GGML_CUDA_DISABLE_GRAPHS=1): stock result stays in the node, the fused result and a host
+// reference are compared with it word for word on every call.
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA) // the fused path is CUDA only (warp size 32, cudaStreamCreate)
+struct alignas(128) top_k_fused_sync {
+    int arrived;
+    int greater_count;
+};
+
+#define GGML_CUDA_TOP_K_FUSED_MAX_ROWS 8
+
+template<int BLOCK_SIZE, int RADIX_BITS>
+static __global__ void top_k_radix_fused(
+        const float * src,
+        int * dst,
+        int * block_histograms,
+        top_k_fused_sync * sync,
+        int ncols,
+        int block_cols,
+        int k,
+        int blocks_per_row) {
+    constexpr int NBINS     = 1 << RADIX_BITS;
+    constexpr int warp_size = 32;
+    constexpr int nwarps    = BLOCK_SIZE / warp_size;
+    static_assert(NBINS == BLOCK_SIZE, "one thread per bin");
+    __shared__ int histogram[NBINS];
+    __shared__ int warp_sums[nwarps];
+    __shared__ int sel_bin;
+    __shared__ int sel_rank;
+
+    ggml_cuda_pdl_lc();
+
+    const int row       = blockIdx.x / blocks_per_row;
+    const int row_block = blockIdx.x % blocks_per_row;
+    const int tid       = threadIdx.x;
+    const int lane      = tid % warp_size;
+    const int warp      = tid / warp_size;
+    const float * row_src = src + (size_t) row * ncols;
+    int *         row_dst = dst + (size_t) row * k;
+    // one histogram buffer per pass: a block that is already in pass p+1 must not overwrite the pass p histogram that a
+    // slower block of the row is still summing. Layout [pass][row][block][bin].
+    constexpr int NPASSES = 32 / RADIX_BITS;
+    const size_t pass_stride = (size_t) gridDim.x * NBINS;
+    int *         my_hist0 = block_histograms + ((size_t) row * blocks_per_row + row_block) * NBINS;
+    // the histograms and the counter are written by other blocks of this grid: volatile loads
+    const volatile int * row_hist0 = block_histograms + (size_t) row * blocks_per_row * NBINS;
+    const volatile int * row_hist  = row_hist0;
+    const volatile int * arrived  = &sync[row].arrived;
+
+    // each warp reads a contiguous part of the contiguous range of the block (as top_k_radix_gather)
+    const int     warp_cols  = block_cols / nwarps;
+    const int64_t warp_begin = (int64_t) row_block * block_cols + warp * warp_cols;
+    const int64_t warp_end   = min(warp_begin + warp_cols, (int64_t) ncols);
+
+    uint32_t prefix      = 0;
+    uint32_t prefix_mask = 0;
+    int      rank        = k;
+
+    ggml_cuda_pdl_sync();
+
+    for (int pass = 0; pass < 32 / RADIX_BITS; ++pass) {
+        const int shift = 32 - RADIX_BITS * (pass + 1);
+        histogram[tid] = 0;
+        __syncthreads();
+        for (int64_t col = warp_begin + lane; col < warp_end; col += warp_size) {
+            const uint32_t key = top_k_float_to_ordered(row_src[col]);
+            if ((key & prefix_mask) == prefix) {
+                atomicAdd(&histogram[(key >> shift) & (NBINS - 1)], 1);
+            }
+        }
+        __syncthreads();
+        row_hist = row_hist0 + pass * pass_stride;
+        my_hist0[pass * pass_stride + tid] = histogram[tid];
+        __threadfence();
+        __syncthreads();
+        if (tid == 0) {
+            atomicAdd(&sync[row].arrived, 1);
+            while (*arrived < (pass + 1) * blocks_per_row) {
+            }
+        }
+        __syncthreads();
+
+        // top_k_radix_select, in every block of the row: the highest bin whose count reaches the rank that is left
+        // after the bins above it, else bin 0
+        int count = 0;
+        for (int b = 0; b < blocks_per_row; ++b) {
+            count += row_hist[b * NBINS + tid];
+        }
+        int above = count; // this bin and the bins above it in the warp
+#pragma unroll
+        for (int d = 1; d < warp_size; d *= 2) {
+            const int v = __shfl_down_sync(0xffffffff, above, d);
+            if (lane + d < warp_size) {
+                above += v;
+            }
+        }
+        if (lane == 0) {
+            warp_sums[warp] = above;
+        }
+        __syncthreads();
+        above -= count;
+        for (int w = warp + 1; w < nwarps; ++w) {
+            above += warp_sums[w];
+        }
+        if ((above < rank && above + count >= rank) || (tid == 0 && above + count < rank)) {
+            sel_bin  = tid;
+            sel_rank = rank - above;
+        }
+        __syncthreads();
+        prefix      |= (uint32_t) sel_bin << shift;
+        prefix_mask |= (uint32_t) (NBINS - 1) << shift;
+        rank         = sel_rank;
+    }
+
+    // top_k_radix_gather
+    const uint32_t threshold = prefix;
+    int nties = 0;
+    for (int64_t col = warp_begin + lane; col < warp_end; col += warp_size) {
+        const uint32_t key = top_k_float_to_ordered(row_src[col]);
+        if (key > threshold) {
+            const int pos = atomicAdd(&sync[row].greater_count, 1);
+            row_dst[pos] = col;
+        } else if (key == threshold) {
+            nties++;
+        }
+    }
+
+    // the ties fill the last rank slots in column order, the lowest columns win.
+    // the histograms of the last pass count the ties of each block in the bin of the threshold.
+    const volatile int * block_ties = row_hist + (threshold & (NBINS - 1));
+    int pos = 0;
+    for (int b = lane; b < row_block; b += warp_size) {
+        pos += block_ties[b * NBINS];
+    }
+    pos = warp_reduce_sum<warp_size>(pos);
+    if (pos < rank && block_ties[row_block * NBINS] != 0) { // the same result in all threads of the block
+        nties = warp_reduce_sum<warp_size>(nties);
+        if (lane == 0) {
+            warp_sums[warp] = nties;
+        }
+        __syncthreads();
+        for (int w = 0; w < warp; ++w) {
+            pos += warp_sums[w];
+        }
+
+        // pos is the same in all lanes of the warp, so the lanes leave the loop together
+        const int pos_end = min(pos + nties, rank);
+        for (int64_t tile = warp_begin; tile < warp_end && pos < pos_end; tile += warp_size) {
+            const int64_t col    = tile + lane;
+            const bool    is_tie = col < warp_end && top_k_float_to_ordered(row_src[col]) == threshold;
+
+            const uint32_t ties    = __ballot_sync(0xffffffff, is_tie);
+            const int      tie_pos = pos + __popc(ties & (((uint32_t) 1 << lane) - 1));
+            if (is_tie && tie_pos < pos_end) {
+                row_dst[k - rank + tie_pos] = col;
+            }
+            pos += __popc(ties);
+        }
+    }
+
+    // the last block of the row to finish clears the row state for the next launch
+    __threadfence();
+    __syncthreads();
+    if (tid == 0 && atomicAdd(&sync[row].arrived, 1) == (NPASSES + 1) * blocks_per_row - 1) {
+        sync[row].greater_count = 0;
+        sync[row].arrived       = 0;
+    }
+}
