+static void top_k_radix_cuda(
+        ggml_cuda_pool & pool,
+        const float * src, int * dst, int ncols, int64_t nrows, int k, cudaStream_t stream) {
+    const int blocks_per_row = (int) std::min<int64_t>(((int64_t) ncols + 1023) / 1024, 64);
+
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+    // LLAMA_TOPK_FUSED: decode-sized calls only, every block of the grid resident at once
+    static const bool fused       = top_k_env("LLAMA_TOPK_FUSED");
+    static const bool fused_check = top_k_env("LLAMA_TOPK_FUSED_CHECK");
+    const int nsm = ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+    if ((fused || fused_check) && nrows <= GGML_CUDA_TOP_K_FUSED_MAX_ROWS && nrows <= nsm) {
+        const int fused_blocks_per_row = std::min<int>(blocks_per_row, nsm / (int) nrows);
+        if (!fused_check) {
+            top_k_radix_fused_cuda(pool, src, dst, ncols, (int) nrows, k, fused_blocks_per_row, stream);
+            return;
+        }
+        ggml_cuda_pool_alloc<int> check_alloc(pool, (size_t) k * nrows);
+        top_k_radix_fused_cuda(pool, src, check_alloc.get(), ncols, (int) nrows, k, fused_blocks_per_row, stream);
+        top_k_radix_stock_cuda(pool, src, dst, ncols, nrows, k, stream);
+        top_k_fused_check(src, dst, check_alloc.get(), ncols, (int) nrows, k, stream);
+        return;
+    }
+#endif // !GGML_USE_HIP && !GGML_USE_MUSA
+    top_k_radix_stock_cuda(pool, src, dst, ncols, nrows, k, stream);
+}
