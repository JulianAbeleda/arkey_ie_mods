+// zeroed row states that live as long as the process, one set per stream (captured CUDA graphs keep the pointer)
+static top_k_fused_sync * top_k_fused_sync_get(cudaStream_t stream) {
+    static std::mutex mutex;
+    static std::unordered_map<cudaStream_t, top_k_fused_sync *> map;
+    std::lock_guard<std::mutex> lock(mutex);
+    auto it = map.find(stream);
+    if (it == map.end()) {
+        // zero on a stream of its own: the caller's stream may be capturing a graph
+        const size_t size = GGML_CUDA_TOP_K_FUSED_MAX_ROWS * sizeof(top_k_fused_sync);
+        void *       ptr  = nullptr;
+        cudaStream_t init = nullptr;
+        CUDA_CHECK(cudaMalloc(&ptr, size));
+        CUDA_CHECK(cudaStreamCreate(&init));
+        CUDA_CHECK(cudaMemsetAsync(ptr, 0, size, init));
+        CUDA_CHECK(cudaStreamSynchronize(init));
+        CUDA_CHECK(cudaStreamDestroy(init));
+        it = map.emplace(stream, (top_k_fused_sync *) ptr).first;
+        GGML_LOG_WARN("top_k_fused: on, row states at %p for stream %p\n", ptr, (void *) stream);
+    }
+    return it->second;
+}
+
+static void top_k_radix_fused_cuda(
+        ggml_cuda_pool & pool,
+        const float * src, int * dst, int ncols, int nrows, int k, int blocks_per_row, cudaStream_t stream) {
+    constexpr int BLOCK_SIZE = 256;
+    constexpr int RADIX_BITS = 8;
+    constexpr int NBINS = 1 << RADIX_BITS;
+    const int block_cols = (int) (((int64_t) ncols + blocks_per_row * BLOCK_SIZE - 1) / (blocks_per_row * BLOCK_SIZE) * BLOCK_SIZE);
+
+    ggml_cuda_pool_alloc<int> histograms_alloc(pool, (size_t) (32 / RADIX_BITS) * nrows * blocks_per_row * NBINS);
+    const ggml_cuda_kernel_launch_params launch_params(dim3(blocks_per_row * nrows), dim3(BLOCK_SIZE), 0, stream);
+    ggml_cuda_kernel_launch(top_k_radix_fused<BLOCK_SIZE, RADIX_BITS>, launch_params,
+        src, dst, histograms_alloc.get(), top_k_fused_sync_get(stream), ncols, block_cols, k, blocks_per_row);
+}
+
+static uint32_t top_k_float_to_ordered_host(float value) {
+    uint32_t bits;
+    memcpy(&bits, &value, sizeof(bits));
+    return bits ^ ((uint32_t) (-(int32_t) (bits >> 31)) | 0x80000000U);
+}
+
+// stock and fused picks against a host reference: sorted picks above the threshold word for word, tie slots word for
+// word in order, and the two sorted rows against each other
+static void top_k_fused_check(
+        const float * src, const int * dst_stock, const int * dst_fused, int ncols, int nrows, int k, cudaStream_t stream) {
+    static int64_t ncalls = 0, total_diff = 0;
+    std::vector<float> s((size_t) ncols * nrows);
+    std::vector<int>   a((size_t) k * nrows), b((size_t) k * nrows);
+    CUDA_CHECK(cudaMemcpyAsync(s.data(), src,       s.size() * sizeof(float), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaMemcpyAsync(a.data(), dst_stock, a.size() * sizeof(int),   cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaMemcpyAsync(b.data(), dst_fused, b.size() * sizeof(int),   cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+
+    int64_t diff = 0;
+    int     rank_last = 0;
+    for (int r = 0; r < nrows; ++r) {
+        std::vector<uint32_t> key(ncols);
+        for (int c = 0; c < ncols; ++c) {
+            key[c] = top_k_float_to_ordered_host(s[(size_t) r * ncols + c]);
+        }
+        std::vector<uint32_t> sorted = key;
+        std::nth_element(sorted.begin(), sorted.begin() + (k - 1), sorted.end(), std::greater<uint32_t>());
+        const uint32_t threshold = sorted[k - 1];
+        std::vector<int> ref; // picks above the threshold ascending, then the lowest tie columns ascending
+        for (int c = 0; c < ncols; ++c) {
+            if (key[c] > threshold) {
+                ref.push_back(c);
+            }
+        }
+        const int ngreater = (int) ref.size();
+        for (int c = 0; c < ncols && (int) ref.size() < k; ++c) {
+            if (key[c] == threshold) {
+                ref.push_back(c);
+            }
+        }
+        rank_last = k - ngreater;
+        std::vector<int> ra(a.begin() + (size_t) r * k, a.begin() + (size_t) (r + 1) * k);
+        std::vector<int> rb(b.begin() + (size_t) r * k, b.begin() + (size_t) (r + 1) * k);
+        std::sort(ra.begin(), ra.begin() + ngreater);
+        std::sort(rb.begin(), rb.begin() + ngreater);
+        for (int i = 0; i < k; ++i) {
+            diff += (ra[i] != ref[i]) + (rb[i] != ref[i]); // head sorted, tie slots as written
+        }
+        std::sort(ra.begin(), ra.end());
+        std::sort(rb.begin(), rb.end());
+        for (int i = 0; i < k; ++i) {
+            diff += ra[i] != rb[i];
+        }
+    }
+    total_diff += diff;
+    ncalls++;
+    if (diff != 0 || ncalls <= 4 || ncalls % 1000 == 0) {
+        GGML_LOG_WARN("topk_fused check: call %lld rows %d ncols %d k %d ties(last row) %d words %lld diff %lld total diff %lld\n",
+            (long long) ncalls, nrows, ncols, k, rank_last, (long long) 3 * k * nrows, (long long) diff, (long long) total_diff);
+    }
+    GGML_ASSERT(diff == 0 && "topk_fused check: fused picks differ from stock / host reference");
+}
