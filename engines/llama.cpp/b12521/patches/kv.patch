+// LLAMA_SPARSE_DIRECT=1 (local long-context mod, off by default): calls that take the sparse MMA gather read q8_0 K/V
+// rows by index and dequantize them in registers, so the whole-cache f16 copy and its buffer go away.
+// LLAMA_SPARSE_DIRECT_CHECK=N also runs the stock path on every Nth such call (needs GGML_CUDA_DISABLE_GRAPHS=1)
+// and aborts if the outputs differ beyond tolerance.
+static int sparse_direct_env(const char * name) {
+    const char * e = getenv(name);
+    return e ? atoi(e) : 0;
+}
+static thread_local bool sparse_direct_off = false;
+
+bool ggml_cuda_flash_attn_ext_sparse_direct(const ggml_tensor * dst) {
+    static const bool on = sparse_direct_env("LLAMA_SPARSE_DIRECT") != 0;
+    if (!on || sparse_direct_off) {
+        return false;
+    }
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+    const int device = ggml_cuda_get_device();
+    const int cc = ggml_cuda_info().devices[device].cc;
+    // the (256, 256, ncols1, 8) sparse variants load K and V in one batch each (no column offset), as the q8_0 rows need
+    if (K->type != GGML_TYPE_Q8_0 || V->type != GGML_TYPE_Q8_0 || Q->ne[0] != 256 || V->ne[0] != 256 ||
+            Q->ne[2] / K->ne[2] <= 4 || K->nb[1] % 4 != 0 || V->nb[1] % 4 != 0 || V->view_src == K ||
+            (V->view_src && V->view_src == K->view_src && V->view_offs == K->view_offs) || dst->src[5] != nullptr ||
+            ggml_cuda_get_best_fattn_kernel(device, dst) != BEST_FATTN_KERNEL_MMA_F16) {
+        return false;
+    }
+    // as ggml_cuda_flash_attn_ext_mma_f16_switch_ncols1 picks it: one query per list up to 4 queries, 8 above
+    return Q->ne[1] <= 4 ? ggml_cuda_flash_attn_ext_mma_f16_shall_use_sparse(cc, dst, 1, 8) :
+                           ggml_cuda_flash_attn_ext_mma_f16_shall_use_sparse(cc, dst, 8, 8);
+}
