+++ b/src/llama-kv-stream.h
@@ -0,0 +1,39 @@
+#pragma once
+
+// LLAMA_KV_STREAM (local long-context mod, off by default): where a KV cache layer keeps its K/V.
+// The extension point of llama_kv_cache's storage: plan() decides once per cache, streams() per layer, and the cache
+// asks add_layer() for the VRAM side of a streamed layer and register_layers() once its buffers exist.
+// A streamed layer: full q8_0 K/V in pinned host memory under the CUDA buffer type family (every op still runs on
+// the GPU), plus `n_slot_cells` cells of VRAM pages that flash attention reads through a page map (ggml-cuda/kv-stream.cu).
+//   LLAMA_KV_STREAM=N        resident cells per target attention layer (multiple of 4, >= 4096); 0 or unset = stock
+//   LLAMA_KV_STREAM_CHECK=1  every streamed read is compared with the host copy, abort on a differing byte
+//                            (synchronizes: run with GGML_CUDA_DISABLE_GRAPHS=1)
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <cstdint>
+#include <vector>
+
+struct llama_model;
+struct llama_hparams;
+
+struct llama_kv_stream {
+    int64_t n_main  = 0;                // VRAM cells per target attention layer (LLAMA_KV_STREAM); 0: off
+    ggml_backend_buffer_type_t host_buft = nullptr;
+    ggml_backend_reg_t         reg       = nullptr;
+
+    struct layer { int il; ggml_tensor * k, * v, * ks, * vs; int64_t n_slot_cells; };
+    std::vector<layer> layers;
+    ggml_tensor * gk = nullptr;         // one staging pool for all layers (calls on one stream are serial)
+    ggml_tensor * gv = nullptr;
+    int64_t kv_size = 0;
+
+    static llama_kv_stream plan(const llama_model & model, const llama_hparams & hparams, bool main_attn_cache,
+                                ggml_type type_k, ggml_type type_v, uint32_t kv_size, uint32_t n_stream, bool offload);
+
+    int64_t slot_cells(const llama_hparams & hparams, uint32_t il) const;
+    bool streams(const llama_hparams & hparams, uint32_t il, bool has_v) const;
+    void add_layer(ggml_context * ctx_dev, const llama_hparams & hparams, int il, ggml_tensor * k, ggml_tensor * v);
+    void register_layers();
+};
