+bool llama_memory_hybrid_idx::idx_pooled_wanted(const llama_model & model, uint32_t n_seq_max, uint32_t n_ubatch) {
+    static const bool env = getenv("LLAMA_IDX_POOLED") && atoi(getenv("LLAMA_IDX_POOLED")) != 0;
+    if (!env) {
+        return false;
+    }
+    const bool ok = model.hparams.indexer_kpool > 0 && model.hparams.indexer_kpool_by_order && n_seq_max == 1 && n_ubatch > 0;
+    if (!ok) {
+        LLAMA_LOG_WARN("%s: LLAMA_IDX_POOLED ignored: needs an order k-pool indexer, one sequence and a known n_ubatch "
+                "(kpool %u, by_order %d, n_seq_max %u, n_ubatch %u): stock indexer cache\n", __func__,
+                model.hparams.indexer_kpool, (int) model.hparams.indexer_kpool_by_order, n_seq_max, n_ubatch);
+    }
+    return ok;
+}
+
+ggml_tensor * llama_memory_hybrid_idx::pooled_ring(int32_t il) const {
+    auto it = pooled_layers.find(il);
+    GGML_ASSERT(it != pooled_layers.end());
+    return it->second.first;
+}
+
+ggml_tensor * llama_memory_hybrid_idx::pooled_pool(int32_t il) const {
+    auto it = pooled_layers.find(il);
+    GGML_ASSERT(it != pooled_layers.end());
+    return it->second.second;
+}
+
+void llama_memory_hybrid_idx::ring_note_write(int64_t rank) {
+    GGML_ASSERT(rank >= 0);
+    ring_owner[(size_t) (rank % ring_size)] = rank;
+}
+
+int64_t llama_memory_hybrid_idx::ring_slot_checked(int64_t rank) const {
+    const int64_t slot = rank % ring_size;
+    if (rank < 0 || ring_owner[(size_t) slot] != rank) {
+        GGML_ABORT("LLAMA_IDX_POOLED: raw indexer key of rank %lld is no longer in the ring (slot %lld holds %lld); "
+                "a re-pool reached further back than the ring keeps - run without LLAMA_IDX_POOLED",
+                (long long) rank, (long long) slot, (long long) (rank < 0 ? -1 : ring_owner[(size_t) slot]));
+    }
+    ++n_ring_reads;
+    return slot;
+}
 
