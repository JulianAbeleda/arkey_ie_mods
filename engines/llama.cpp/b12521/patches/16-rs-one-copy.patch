+        io.read(&valid[c], sizeof(valid[c]));
+        if (valid[c] > K) {
+            LLAMA_LOG_ERROR("%s: rs_one_copy: kept count %u > K %u\n", __func__, valid[c], K);
+            return false;
+        }
+    }
