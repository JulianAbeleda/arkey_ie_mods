+// LLAMA_RS_ONE_COPY: lagging base + in-graph replay.
+// A verify step never modifies the stored state; the inputs of the accepted tokens are kept and folded into it at
+// the start of the next graph (inside that graph: no extra kernel launch, no extra sync).
+// s is the base gathered from the single S plane (the state before the last small ubatch). The kept inputs of that
+// ubatch (k, v, g, beta per token, x_l) are replayed with K = 1; tokens past the accepted count get g*0 and beta*0 from
+// the replay mask (exp(0) = 1, delta*0 = 0: identity), so the graph never depends on the accepted count. This ubatch
+// then runs from the replayed state.
+//   small ubatch (n <= K): the replayed state goes to the plane (the cpy fuses into the replay kernel on CUDA) and this
+//                          ubatch's inputs are kept; the main op's own final state is not stored.
+//   long ubatch  (n >  K): the main op's final state goes to the plane (fused) and nothing is kept (n_saved = 0).
+// Check mode (s_ref != nullptr): the stock K-snapshot op still writes the stock planes from s_ref, and
+// sum |replayed - s_ref| is added to res->t_rs_check; the output (logits) comes from the one-copy path.
+ggml_tensor * llm_build_delta_net_base::build_recurrent_attn_one_copy(
+        llm_graph_input_rs * inp,
+        ggml_tensor *        ssm_states_all,
+        ggml_tensor *        q,
+        ggml_tensor *        k,
+        ggml_tensor *        v,
+        ggml_tensor *        g,
+        ggml_tensor *        b,
+        ggml_tensor *        s,
+        int                  il,
+        ggml_tensor *        s_ref) {
+    const auto * mctx_cur   = inp->mctx;
+    const auto   kv_head    = mctx_cur->get_head();
+    const uint32_t mem_size = mctx_cur->get_size();
+
+    const int64_t S_v          = s->ne[0];
+    const int64_t H_v          = s->ne[2];
+    const int64_t n_seqs       = s->ne[3];
+    const int64_t n_seq_tokens = q->ne[2];
+    const int64_t S_k          = k->ne[0];
+    const int64_t H_k          = k->ne[1];
+
+    const int64_t D = S_v * S_v * H_v;
+    const int64_t K = cparams.n_rs_seq + 1;
+
+    GGML_ASSERT(n_seqs == 1 && mem_size == 1 && "rs_one_copy requires -np 1");
+    GGML_ASSERT(g->ne[0] == 1 && "rs_one_copy keeps a scalar gate per head");
+    GGML_ASSERT((int64_t) hparams.n_embd_s() == D);
+    GGML_ASSERT(inp->replay_mask != nullptr && inp->replay_mask->ne[2] == K);
+
+    ggml_tensor * plane = mctx_cur->get_o_l(il);
+    ggml_tensor * x     = mctx_cur->get_x_l(il);
+    GGML_ASSERT(plane != nullptr && x != nullptr && plane->type == GGML_TYPE_F32 && x->type == GGML_TYPE_F32);
+
+    // x row: k [S_k, H_k, K] | v [S_v, H_v, K] | g [1, H_v, K] | beta [1, H_v, K]
+    const int64_t n_k = S_k * H_k;
+    const int64_t n_v = S_v * H_v;
+    GGML_ASSERT(x->ne[0] == K * (n_k + n_v + 2*H_v) && "rs_one_copy: replay row does not match the delta-net shapes");
+
+    const size_t es     = ggml_element_size(x);
+    const size_t x_offs = (size_t) kv_head * x->nb[1];
+    auto x_view = [&](int64_t ne0, int64_t ne1, int64_t n_tok, int64_t offs_el) {
+        return ggml_view_4d(ctx0, x, ne0, ne1, n_tok, 1, ne0*es, ne0*ne1*es, ne0*ne1*n_tok*es, x_offs + (size_t) offs_el*es);
+    };
+    const int64_t off_k = 0;
+    const int64_t off_v = K * n_k;
+    const int64_t off_g = K * (n_k + n_v);
+    const int64_t off_b = K * (n_k + n_v + H_v);
+
+    // the plane row of this cell, as the [D, n_seqs, 1] view the CUDA gdn -> cpy fusion matches
+    ggml_tensor * plane_dst = ggml_view_3d(ctx0, plane,
+            D, n_seqs, 1,
+            plane->nb[1], (size_t) mem_size * plane->nb[1],
+            (size_t) kv_head * plane->nb[1]);
+
+    // replay: q is not needed for the state, k stands in for it
+    ggml_tensor * xk = x_view(S_k, H_k, K, off_k);
+    ggml_tensor * xv = x_view(S_v, H_v, K, off_v);
+    ggml_tensor * xg = ggml_mul(ctx0, x_view(1, H_v, K, off_g), inp->replay_mask);
+    ggml_tensor * xb = ggml_mul(ctx0, x_view(1, H_v, K, off_b), inp->replay_mask);
+    cb(xg, "rs_replay_g", il);
+    cb(xb, "rs_replay_beta", il);
+
+    ggml_tensor * rep = ggml_gated_delta_net(ctx0, xk, xk, xv, xg, xb, s, 1);
+    cb(rep, "rs_replay", il);
+
+    const size_t  rep_tail_offs = ggml_row_size(rep->type, S_v * H_v * K * n_seqs);
+    ggml_tensor * rep_tail      = ggml_view_3d(ctx0, rep, D, n_seqs, 1,
+            ggml_row_size(rep->type, D), ggml_row_size(rep->type, D * n_seqs), rep_tail_offs);
+
+    const bool small = n_seq_tokens <= K;
+
+    ggml_tensor * state_r = nullptr; // the logical state before this ubatch
+    if (small) {
+        // the replayed state is the new base: first real node after the replay op, so it fuses into its kernel
+        state_r = ggml_cpy(ctx0, rep_tail, plane_dst);
+        ggml_build_forward_expand(gf, state_r);
+    } else {
+        state_r = rep_tail;
+    }
+    state_r = ggml_reshape_4d(ctx0, state_r, S_v, S_v, H_v, n_seqs);
+    cb(state_r, "rs_state_replayed", il);
+
+    if (s_ref != nullptr) {
+        // check: the stock path, exactly as the keep branch of build_recurrent_attn writes the stock planes
+        const int64_t attn_score_elems    = S_v * H_v * n_seq_tokens * n_seqs;
+        const int64_t state_size_per_snap = S_v * S_v * H_v * n_seqs;
+        const int64_t n_written           = std::min<int64_t>(n_seq_tokens, K);
+        const size_t  row_size            = hparams.n_embd_s() * ggml_element_size(ssm_states_all);
+
+        ggml_tensor * gdn_ref = ggml_gated_delta_net(ctx0, q, k, v, g, b, s_ref, K);
+        cb(gdn_ref, "rs_check_stock", il);
+        ggml_tensor * src = ggml_view_3d(ctx0, gdn_ref,
+            D, n_seqs, n_written,
+            ggml_row_size(gdn_ref->type, D),
+            ggml_row_size(gdn_ref->type, state_size_per_snap),
+            ggml_row_size(gdn_ref->type, attn_score_elems));
+        ggml_tensor * dst = ggml_view_3d(ctx0, ssm_states_all,
+            D, n_seqs, n_written,
+            ssm_states_all->nb[1],
+            (size_t) mem_size * row_size,
+            (size_t) kv_head * row_size);
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, src, dst));
+
+        ggml_tensor * diff = ggml_sum(ctx0, ggml_abs(ctx0, ggml_sub(ctx0, state_r, s_ref)));
+        cb(diff, "rs_check_diff", il);
+        res->t_rs_check = res->t_rs_check ? ggml_add(ctx0, res->t_rs_check, diff) : diff;
+        ggml_build_forward_expand(gf, res->t_rs_check);
+    }
+
+    // this ubatch from the replayed state; K = 1, its final state is stored only for a long ubatch
+    ggml_tensor * gdn_out = ggml_gated_delta_net(ctx0, q, k, v, g, b, state_r, 1);
+    cb(gdn_out, "rs_main", il);
+
+    ggml_tensor * output = ggml_view_4d(ctx0, gdn_out,
+        S_v, H_v, n_seq_tokens, n_seqs,
+        ggml_row_size(gdn_out->type, S_v),
+        ggml_row_size(gdn_out->type, S_v * H_v),
+        ggml_row_size(gdn_out->type, S_v * H_v * n_seq_tokens),
+        0);
+    cb(output, "attn_output", il);
+
+    if (!small) {
+        ggml_tensor * main_tail = ggml_view_3d(ctx0, gdn_out, D, n_seqs, 1,
+                ggml_row_size(gdn_out->type, D), ggml_row_size(gdn_out->type, D * n_seqs),
+                ggml_row_size(gdn_out->type, S_v * H_v * n_seq_tokens * n_seqs));
+        // first real node after the main op: fuses into its kernel on CUDA
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, main_tail, plane_dst));
+    } else {
+        // the kept inputs are overwritten only after the replay read them: the replay is an ancestor of the main op,
+        // which is placed in the graph before these copies (node order is kept by the scheduler; the CUDA stream
+        // reordering of GGML_CUDA_GRAPH_OPT=1 is refused at init with rs_one_copy)
+        ggml_build_forward_expand(gf, gdn_out);
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, k, x_view(S_k, H_k, n_seq_tokens, off_k)));
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, v, x_view(S_v, H_v, n_seq_tokens, off_v)));
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, g, x_view(1,   H_v, n_seq_tokens, off_g)));
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, b, x_view(1,   H_v, n_seq_tokens, off_b)));
+    }
+
+    return output;
+}
