+void llama_memory_recurrent_context::set_input_one_copy(ggml_tensor * s_copy_base, ggml_tensor * replay_mask) const {
+    // either tensor stays unallocated if no layer of this graph reads it
+    if (s_copy_base != nullptr && s_copy_base->buffer != nullptr) {
+        GGML_ASSERT(ggml_backend_buffer_is_host(s_copy_base->buffer));
+        int32_t * data = (int32_t *) s_copy_base->data;
+        for (int64_t i = 0; i < s_copy_base->ne[0]; ++i) {
+            data[i] = mem->cells[i + get_head()].src0;
+        }
+    }
+
+    if (replay_mask != nullptr && replay_mask->buffer != nullptr) {
+        GGML_ASSERT(ggml_backend_buffer_is_host(replay_mask->buffer));
+        GGML_ASSERT(mem->size == 1); // -np 1: one cell, one mask
+        const auto & cell = mem->cells[get_head()];
+
+        uint32_t idx = 0;
+        if (!cell.seq_id.empty()) {
+            const llama_seq_id seq = *cell.seq_id.begin();
+            if (seq >= 0 && (size_t) seq < mem->rs_idx.size()) {
+                idx = mem->rs_idx[seq]; // not consumed here: s_copy() resets it right after
+            }
+        }
+        // seq_rm allows a rollback only up to rs_max = n_saved - 1 of the last ubatch, so at least one kept token stays
+        GGML_ASSERT(idx <= cell.n_replay);
+        const int64_t valid = (int64_t) cell.n_replay - idx;
+
+        float * data = (float *) replay_mask->data;
+        const int64_t K = ggml_nelements(replay_mask);
+        for (int64_t t = 0; t < K; ++t) {
+            data[t] = t < valid ? 1.0f : 0.0f;
+        }
+    }
