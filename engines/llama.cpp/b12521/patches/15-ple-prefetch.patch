index 9688a7e..dcc60b6 100644
--- a/src/llama-mmap.cpp
+++ b/src/llama-mmap.cpp
@@ -10,6 +10,10 @@
 #include <stdexcept>
 #include <cerrno>
 #include <algorithm>
+#include <condition_variable> // LLAMA_PLE_PREFETCH_TURN: llama_prefetch_async
+#include <deque>
+#include <mutex>
+#include <thread>
 
 #ifdef __has_include
     #if __has_include(<unistd.h>)
@@ -1141,6 +1145,36 @@ void llama_prefetch(llama_memory_ranges mr) {
 #endif
 }
 
+// LLAMA_PLE_PREFETCH_TURN (caller: llama_model::prefetch_inputs overrides): the same hint as llama_prefetch, on one background
+// thread, so the caller does not wait for the madvise calls. A hint changes no byte that is read later.
+void llama_prefetch_async(llama_memory_ranges mr) {
+    // heap objects that are never destroyed: the detached worker may still wait on them while static destructors run at exit
+    // (function-local statics here hung the process at exit)
+    static std::mutex & mtx = *new std::mutex;
+    static std::condition_variable & cv = *new std::condition_variable;
+    static std::deque<llama_memory_ranges> & q = *new std::deque<llama_memory_ranges>;
+    static std::once_flag once;
+    std::call_once(once, [] {
+        std::thread([] {
+            for (;;) {
+                llama_memory_ranges job;
+                {
+                    std::unique_lock<std::mutex> lock(mtx);
+                    cv.wait(lock, [] { return !q.empty(); });
+                    job = std::move(q.front());
+                    q.pop_front();
+                }
+                llama_prefetch(std::move(job));
+            }
+        }).detach();
+    });
+    {
+        std::lock_guard<std::mutex> lock(mtx);
+        q.push_back(std::move(mr));
+    }
+    cv.notify_one();
+}
+
 size_t llama_path_max() {
     return PATH_MAX;
 }
