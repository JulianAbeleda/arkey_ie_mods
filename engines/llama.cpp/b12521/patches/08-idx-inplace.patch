@@ -1,3 +1,4 @@
+#include <vector>
 #include "common.cuh"
 #include "lightning-indexer.cuh"
 #include "fattn-common.cuh"
@@ -550,6 +551,37 @@ void ggml_cuda_lightning_indexer(ggml_backend_cuda_context & ctx, ggml_tensor *
     const int device = ggml_cuda_get_device();
     const int cc     = ggml_cuda_info().devices[device].cc;
 
+    // LLAMA_IDX_INPLACE_CHECK: src[4] is the stock score (f32 copy of the keys), already computed; this node read q8_0 in place
+    struct idx_inplace_check {
+        ggml_backend_cuda_context & ctx;
+        const ggml_tensor * dst;
+        ~idx_inplace_check() {
+            const ggml_tensor * ref = dst->src[4];
+            if (ref == nullptr) {
+                return;
+            }
+            static uint64_t n_check = 0, n_values = 0;
+            const size_t n = ggml_nbytes(dst);
+            GGML_ASSERT(n == ggml_nbytes(ref) && dst->src[1]->type == GGML_TYPE_Q8_0 && ref->src[1]->type == GGML_TYPE_F32);
+            std::vector<uint32_t> a(n/4), b(n/4);
+            CUDA_CHECK(cudaMemcpyAsync(a.data(), dst->data, n, cudaMemcpyDeviceToHost, ctx.stream()));
+            CUDA_CHECK(cudaMemcpyAsync(b.data(), ref->data, n, cudaMemcpyDeviceToHost, ctx.stream()));
+            CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+            size_t n_diff = 0;
+            for (size_t i = 0; i < n/4; ++i) {
+                n_diff += a[i] != b[i]; // bit patterns: -inf, zero signs and NaN payloads count
+            }
+            n_values += n/4;
+            if (++n_check <= 3 || n_check % 2000 == 0 || n_diff != 0) {
+                GGML_LOG_WARN("idx_inplace check %llu (%s, q %lld, n_pool %lld): %zu of %zu score bit patterns differ; %llu scores checked\n",
+                    (unsigned long long) n_check, dst->name, (long long) dst->ne[1], (long long) dst->ne[0], n_diff, n/4, (unsigned long long) n_values);
+            }
+            if (n_diff != 0) {
+                GGML_ABORT("LLAMA_IDX_INPLACE_CHECK: in-place and stock indexer scores differ");
+            }
+        }
+    } idx_check{ctx, dst};
+
     if (n_embd == 128 && n_head == 64) {
         if ((turing_mma_available(cc) || amd_mfma_available(cc) || amd_wmma_available(cc)) && k->type != GGML_TYPE_F32 && k->type != GGML_TYPE_BF16) {
             constexpr int K_VECS_PER_BLOCK = 32;
