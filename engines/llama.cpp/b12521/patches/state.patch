+    uint32_t K     = 0;
+    uint32_t n     = 0;
+    io.read(&magic, sizeof(magic));
+    io.read(&K,     sizeof(K));
+    io.read(&n,     sizeof(n));
+    if (magic != LLAMA_RS_ONE_COPY_MAGIC || K != 1 + n_rs_seq || n != cell_count || head + n > size) {
+        LLAMA_LOG_ERROR("%s: rs_one_copy: state has no matching one-copy section (magic %08x, K %u, cells %u/%u)\n",
+                __func__, magic, K, n, cell_count);
+        return false;
+    }
+
+    std::vector<uint32_t> valid(n);
+    for (uint32_t c = 0; c < n; ++c) {
+        io.read(&valid[c], sizeof(valid[c]));
+        if (valid[c] > K) {
