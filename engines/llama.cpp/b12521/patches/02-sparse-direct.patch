+// LLAMA_SPARSE_DIRECT: a negative stride marks q8_0 K/V rows of -stride half2 units (bytes/4), the gather
+// dequantizes chunk k (8 values) in registers with the same math as dequantize_block_q8_0_f16
+static __device__ __forceinline__ void flash_attn_ext_q8_0_chunk(void * dst, const half2 * KV, const int64_t index, const int stride_KV, const int k) {
+    const block_q8_0 * b = (const block_q8_0 *) ((const char *) KV + index*(-4*(int64_t) stride_KV)) + k/4;
+    const half2 d = __half2half2(b->d);
+    const int8_t * qs = b->qs + 8*(k % 4);
+    half2 v[4];
+#pragma unroll
+    for (int l = 0; l < 4; ++l) {
+        v[l] = __hmul2(make_half2(__int2half_rn(qs[2*l]), __int2half_rn(qs[2*l + 1])), d);
+    }
+    ggml_cuda_memcpy_1<16>(dst, v);
+}
