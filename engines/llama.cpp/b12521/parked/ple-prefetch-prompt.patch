+// LOCAL (ple-prefetch-prompt): LLAMA_PLE_PREFETCH_TURN=2 - the turn hint of host/ple-prefetch issued earlier: the HTTP thread hints
+// the input rows of the prompt's new tokens on the same background queue as soon as it has tokenized them, before the task reaches
+// the slot, so the first prompt pass finds them on the way instead of reading them behind its own synchronous hint. New = after the
+// longest common prefix with the previous hinted prompt (the conversation the cache holds). At the slot (n_past final) mode 2 hints
+// only what the early hint left out ([n_past, start) when the cache kept less, or the whole tail for a prompt not hinted early).
+// Mode 1 = the slot-start hint alone (host/ple-prefetch-turn). A hint changes no byte that is read later. Unset = stock.
+static int ple_turn_mode() {
+    static const int m = getenv("LLAMA_PLE_PREFETCH_TURN") != nullptr ? atoi(getenv("LLAMA_PLE_PREFETCH_TURN")) : 0;
+    return m;
+}
+static std::mutex   ple_hint_mtx;
+static llama_tokens ple_hint_last;      // the last prompt hinted early (one conversation: -np 1)
+static size_t       ple_hint_start = 0; // its first hinted token
+static void ple_hint_early(const llama_model * model, const llama_tokens & toks) {
+    std::lock_guard<std::mutex> lock(ple_hint_mtx);
+    const size_t n = std::min(toks.size(), ple_hint_last.size());
+    size_t lcp = 0;
+    while (lcp < n && toks[lcp] == ple_hint_last[lcp]) {
+        lcp++;
+    }
+    if (lcp < toks.size()) {
+        llama_model_prefetch_inputs(model, toks.data(), (int32_t) toks.size(), (int32_t) lcp);
+    }
+    ple_hint_last  = toks;
+    ple_hint_start = lcp;
+}
+static void ple_hint_slot(const llama_model * model, const llama_tokens & toks, int32_t n_past) {
+    if (ple_turn_mode() != 2) {
+        llama_model_prefetch_inputs(model, toks.data(), (int32_t) toks.size(), n_past);
+        return;
+    }
+    std::lock_guard<std::mutex> lock(ple_hint_mtx);
+    if (toks != ple_hint_last) {
+        llama_model_prefetch_inputs(model, toks.data(), (int32_t) toks.size(), n_past);
+        ple_hint_last  = toks;
+        ple_hint_start = (size_t) std::max(n_past, 0);
+        return;
+    }
+    if ((size_t) n_past < ple_hint_start) {
+        llama_model_prefetch_inputs(model, toks.data(), (int32_t) ple_hint_start, n_past); // the n-grams look back only: a cut list is exact
+        ple_hint_start = (size_t) n_past;
+    }
+}
