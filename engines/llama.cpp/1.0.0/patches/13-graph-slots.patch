+void llama_context::gslot_select(int i) {
+    if (i == gslot_cur) {
+        return;
+    }
+    // park the loaded slot, then load slot i (created on first use, its compute buffers sized by its first graph)
+    auto & cur = gslots[gslot_cur];
+    std::swap(sched, cur.sched);
+    std::swap(gf_res_prev, cur.res);
+    cur.active = gf_res_prev_active;
+    auto & nxt = gslots[i];
+    if (!nxt.sched) {
+        nxt.sched.reset(ggml_backend_sched_new(backend_ptrs.data(), backend_buft.data(), backend_ptrs.size(),
+                sched_params_cur.max_nodes, sched_params_cur.parallel, sched_params_cur.op_offload));
+        ggml_backend_sched_set_copy_callback(nxt.sched.get(), sched_copy_experts, this);
+        ggml_backend_sched_set_realloc_callback(nxt.sched.get(), sched_graph_realloc, this);
+        for (auto & res : nxt.res) {
+            res = std::make_unique<llm_graph_result>(graph_max_nodes());
+        }
+        nxt.active = nullptr;
+    }
+    std::swap(sched, nxt.sched);
+    std::swap(gf_res_prev, nxt.res);
+    gf_res_prev_active = nxt.active;
+    gslot_cur = i;
+}
+
+void llama_context::gslot_invalidate() {
+    for (int i = 0; i < (int) gslots.size(); ++i) {
+        if (i != gslot_cur) {
+            for (auto & res : gslots[i].res) {
+                if (res) {
+                    res->reset();
+                }
+            }
+            gslots[i].active = nullptr;
+        }
+    }
+}
