+            continue;
+        }
+
+        const auto & cells = mem_idx->get_cells(unified ? 0 : s);
+        const auto & sp    = cells.seq_pos_get(s);
+
+        const uint32_t strm_old = sq.strm;
+        sq.strm = unified ? 0 : mem_idx->get_stream(s);
+
+        const bool stale = mem_idx_stale[s] != POS_CLEAN;
+        const bool inc   = incr && stale && truncate(sq, sp, mem_idx_stale[s], strm_old);
+        if (incr && stale) {
+            ++(inc ? n_incr : n_fall);
+        }
+
+        if (!inc) {
+            if (mem_idx_stale[s] == POS_CLEAN && !sq.cells.empty() && !sp.empty() &&
+                    sq.pos_min == sp.begin()->first) {
+                for (auto it = sp.upper_bound(sq.cells.back()); it != sp.end(); ++it) {
+                    sq.cells.push_back(*it);
+                }
+            }
+
+            // the appended tail accounts for every cell only if nothing before it was dropped, but an edit can
+            // regroup a sequence without changing its cell count, so a stale sequence must rebuild regardless
+            if (sq.cells.size() != sp.size() || mem_idx_stale[s] != POS_CLEAN) {
+                sq.cells.assign(sp.begin(), sp.end());
+                sq.pools.clear();
+                sq.j_next  = 0;
+                sq.pos_min = sp.empty() ? 0 : sp.begin()->first;
+            }
+        }
+
+        scan(sq);
+
+        if (inc && check) {
+            kpool_layout::seq ref;
+            ref.strm    = sq.strm;
+            ref.cells.assign(sp.begin(), sp.end());
+            ref.pos_min = sp.empty() ? 0 : sp.begin()->first;
+            scan(ref);
+            if (ref.cells != sq.cells || ref.pools != sq.pools || ref.j_next != sq.j_next || ref.pos_min != sq.pos_min) {
+                GGML_ABORT("LLAMA_KPOOL_CHECK: incremental kpool layout differs from the full rebuild: seq %d stale %d "
+                        "cells %zu/%zu pools %zu/%zu j_next %zu/%zu pos_min %d/%d", s, mem_idx_stale[s],
+                        sq.cells.size(), ref.cells.size(), sq.pools.size(), ref.pools.size(), sq.j_next, ref.j_next,
+                        sq.pos_min, ref.pos_min);
+            }
+            if ((n_incr & (n_incr - 1)) == 0 || n_incr % 10000 == 0) {
+                LLAMA_LOG_WARN("%s: LLAMA_KPOOL_CHECK ok: %llu incremental updates verified, %llu full rebuilds\n",
+                        __func__, (unsigned long long) n_incr, (unsigned long long) n_fall);
+            }
+        }
 
         lay.n_pool_real += (uint32_t) sq.pools.size();
