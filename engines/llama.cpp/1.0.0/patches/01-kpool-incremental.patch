+    // An edit at p (> pos_min) leaves the cells below p and every pool ending below them as they were (the same
+    // invariant kpool_build_state relies on): truncate there, append the set from p on, and resume the scan after the
+    // last kept pool. Any inconsistency returns false and the caller rebuilds in full.
+    auto truncate = [&](kpool_layout::seq & sq, const std::set<std::pair<llama_pos, uint32_t>> & sp, llama_pos p, uint32_t strm_old) {
+        if (sq.cells.empty() || sp.empty() || sq.strm != strm_old || sq.pos_min != sp.begin()->first || p <= sq.pos_min) {
+            return false;
+        }
+        const auto   key = std::make_pair(p, 0u);
+        const size_t t   = std::lower_bound(sq.cells.begin(), sq.cells.end(), key) - sq.cells.begin();
+        const auto   it  = sp.lower_bound(key);
+        if (t == 0 || it == sp.begin() || *std::prev(it) != sq.cells[t - 1]) {
+            return false;
+        }
+        sq.cells.resize(t);
+        sq.cells.insert(sq.cells.end(), it, sp.end());
+        if (sq.cells.size() != sp.size()) {
+            return false;
+        }
+        sq.pools.erase(std::lower_bound(sq.pools.begin(), sq.pools.end(), t,
+                [&](uint32_t j, size_t tt) { return j + kpool <= tt; }), sq.pools.end());
+        sq.j_next = sq.pools.empty() ? 0 : sq.pools.back() + kpool;
+        return true;
+    };
