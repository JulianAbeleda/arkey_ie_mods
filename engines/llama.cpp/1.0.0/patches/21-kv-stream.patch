diff --git a/ggml/src/ggml-cuda/kv-stream.cu b/ggml/src/ggml-cuda/kv-stream.cu
new file mode 100644
index 0000000..1591c65
--- /dev/null
+++ b/ggml/src/ggml-cuda/kv-stream.cu
@@ -0,0 +1,557 @@
+// LLAMA_KV_STREAM: see kv-stream.cuh.
+#include "kv-stream.cuh"
+#include "set-rows.cuh"
+
+#include <cstdlib>
+#include <mutex>
+#include <vector>
+
+static constexpr int KVS_PAGE  = 4;    // cells per page = the indexer pool
+static constexpr int KVS_RT    = 1024; // resolve block
+static constexpr int KVS_CTL   = 16;   // [0] epoch [1] hand [2] misses of the last call [3] overflow [4] u64 misses [6] u64 lookups [8] u64 calls [10] check mismatches
+
+struct ggml_cuda_kvs_layer {
+    const char * hk = nullptr; const char * hv = nullptr; // host copies (device-mapped)
+    char * sk = nullptr; char * sv = nullptr;             // slot pools (n_slots pages)
+    char * gk = nullptr; char * gv = nullptr;             // staging pool (n_cells), shared by the cache's layers
+    int32_t * st = nullptr;                               // device state, cudaMalloc'd here (no ggml clear touches it)
+    int64_t n_cells = 0, n_pages = 0, n_slots = 0;
+    size_t rk = 0, rv = 0;
+    int il = -1;
+    __host__ __device__ int32_t * page_table() const { return st; }
+    __host__ __device__ int32_t * slot_page()  const { return st + n_pages; }
+    __host__ __device__ int32_t * slot_stamp() const { return st + n_pages + n_slots; }
+    __host__ __device__ int32_t * slot_ref()   const { return st + n_pages + 2*n_slots; }
+    __host__ __device__ int32_t * miss_page()  const { return st + n_pages + 3*n_slots; }
+    __host__ __device__ int32_t * miss_slot()  const { return st + n_pages + 4*n_slots; }
+    __host__ __device__ int32_t * ctl()        const { return st + n_pages + 5*n_slots; }
+};
+
+static std::vector<ggml_cuda_kvs_layer *> & kvs_layers() {
+    static std::vector<ggml_cuda_kvs_layer *> v;
+    return v;
+}
+
+static int kvs_env(const char * name) {
+    const char * e = getenv(name);
+    return e ? atoi(e) : 0;
+}
+
+ggml_cuda_kvs_layer * ggml_cuda_kvs_find(const void * data, bool * is_v) {
+    const char * p = (const char *) data;
+    for (auto * L : kvs_layers()) {
+        if (p >= L->hk && p < L->hk + L->n_cells*L->rk) { *is_v = false; return L; }
+        if (p >= L->hv && p < L->hv + L->n_cells*L->rv) { *is_v = true;  return L; }
+    }
+    return nullptr;
+}
+
+// ---------------------------------------------------------------------------------------------------- kernels
+
+// every page out, every slot free
+static __global__ void kvs_empty_kernel(ggml_cuda_kvs_layer L) {
+    const int64_t i0 = (int64_t) blockIdx.x*blockDim.x + threadIdx.x, st = (int64_t) gridDim.x*blockDim.x;
+    for (int64_t i = i0; i < L.n_pages; i += st) L.page_table()[i] = -1;
+    for (int64_t i = i0; i < L.n_slots; i += st) { L.slot_page()[i] = -1; L.slot_stamp()[i] = -1; L.slot_ref()[i] = 0; }
+}
+
+// copy whole pages host -> slot, 16 B per thread; pages/slots from two int arrays (or identity when null)
+static __device__ __forceinline__ void kvs_copy_page(const ggml_cuda_kvs_layer & L, int64_t page, int64_t slot) {
+    const int64_t bk = KVS_PAGE*(int64_t) L.rk, bv = KVS_PAGE*(int64_t) L.rv;
+    const uint4 * sk = (const uint4 *) (L.hk + page*bk); uint4 * dk = (uint4 *) (L.sk + slot*bk);
+    const uint4 * sv = (const uint4 *) (L.hv + page*bv); uint4 * dv = (uint4 *) (L.sv + slot*bv);
+    for (int64_t i = threadIdx.x; i < bk/16; i += blockDim.x) dk[i] = sk[i];
+    for (int64_t i = threadIdx.x; i < bv/16; i += blockDim.x) dv[i] = sv[i];
+}
+
+static __global__ void kvs_copy_misses_kernel(ggml_cuda_kvs_layer L) {
+    const int need = L.ctl()[2];
+    for (int k = blockIdx.x; k < need; k += gridDim.x) {
+        kvs_copy_page(L, L.miss_page()[k], L.miss_slot()[k]);
+    }
+}
+
+// identity pass A (per slot s < P): a slot holding another page gives it up
+static __global__ void kvs_identity_a_kernel(ggml_cuda_kvs_layer L, int64_t P) {
+    const int64_t s = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (s >= P) return;
+    const int32_t q = L.slot_page()[s];
+    if (q >= 0 && q != s) { L.page_table()[q] = -1; L.slot_page()[s] = -1; }
+}
+// identity pass B (per page p < P): a page resident elsewhere (in a slot >= P) frees it; flag the page for a copy
+static __global__ void kvs_identity_b_kernel(ggml_cuda_kvs_layer L, int64_t P) {
+    const int64_t p = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (p >= P) return;
+    const int32_t s = L.page_table()[p];
+    if (s == p) return;
+    if (s >= 0) { L.slot_page()[s] = -1; L.slot_stamp()[s] = -1; L.slot_ref()[s] = 0; }
+    L.page_table()[p] = -3; // to copy
+}
+// identity pass C: one block per flagged page copies it into slot p
+static __global__ void kvs_identity_c_kernel(ggml_cuda_kvs_layer L, int64_t P) {
+    for (int64_t p = blockIdx.x; p < P; p += gridDim.x) {
+        if (L.page_table()[p] != -3) continue;
+        kvs_copy_page(L, p, p);
+        __syncthreads();
+        if (threadIdx.x == 0) { L.page_table()[p] = (int32_t) p; L.slot_page()[p] = (int32_t) p; L.slot_ref()[p] = 1; }
+    }
+}
+
+// block-wide exclusive scan of one int per thread (KVS_RT threads)
+static __device__ int kvs_block_scan(int v, int * warp_sums, int & total) {
+    const int lane = threadIdx.x & 31, w = threadIdx.x >> 5;
+    int x = v;
+#pragma unroll
+    for (int o = 1; o < 32; o <<= 1) { const int y = __shfl_up_sync(0xffffffffu, x, o); if (lane >= o) x += y; }
+    if (lane == 31) warp_sums[w] = x;
+    __syncthreads();
+    if (w == 0) {
+        int t = warp_sums[lane];
+#pragma unroll
+        for (int o = 1; o < 32; o <<= 1) { const int y = __shfl_up_sync(0xffffffffu, t, o); if (lane >= o) t += y; }
+        warp_sums[lane] = t;
+    }
+    __syncthreads();
+    total = warp_sums[31];
+    const int excl = x - v + (w > 0 ? warp_sums[w - 1] : 0);
+    __syncthreads();
+    return excl;
+}
+
+// make every page the lists name resident (one block): hits take the epoch and a reference bit, a missing page is
+// claimed once (-1 -> -2), then one CLOCK victim per miss that no page of this call uses, then the table is re-pointed
+static __global__ void __launch_bounds__(KVS_RT) kvs_resolve_kernel(ggml_cuda_kvs_layer L, const int32_t * __restrict__ idx,
+        const int32_t * __restrict__ counts, int n_lists, int n_kv_max) {
+    __shared__ int s_nmiss, s_lookups, s_cut;
+    __shared__ int warp_sums[32];
+    int32_t * ctl = L.ctl();
+    const int epoch = ctl[0] + 1;
+    if (threadIdx.x == 0) { s_nmiss = 0; s_lookups = 0; }
+    __syncthreads();
+    int lookups = 0;
+    for (int l = 0; l < n_lists; ++l) {
+        const int32_t * li = idx + (int64_t) l*n_kv_max;
+        const int n = counts[l];
+        for (int i = threadIdx.x; i < n; i += KVS_RT) {
+            const int c = li[i];
+            if (c < 0) continue;
+            const int b = c / KVS_PAGE;
+            if (i > 0 && li[i - 1] >= 0 && li[i - 1] / KVS_PAGE == b) continue; // ascending: one lookup per page
+            ++lookups;
+            const int sl = L.page_table()[b];
+            if (sl >= 0) {
+                L.slot_stamp()[sl] = epoch;
+                L.slot_ref()[sl] = 1;
+            } else if (sl == -1 && atomicCAS(&L.page_table()[b], -1, -2) == -1) {
+                const int k = atomicAdd(&s_nmiss, 1);
+                if (k < L.n_slots) L.miss_page()[k] = b; // more distinct misses than slots: overflow below
+            }
+        }
+    }
+    if (lookups > 0) atomicAdd(&s_lookups, lookups);
+    __syncthreads();
+    const int need = min(s_nmiss, (int) L.n_slots), n = (int) L.n_slots;
+    if (threadIdx.x == 0 && s_nmiss > n) ctl[3] = 1;
+    int hand = ctl[1], got = 0;
+    for (int scanned = 0; got < need && scanned < 3*n; scanned += KVS_RT) {
+        const int j = (int) (((int64_t) hand + threadIdx.x) % n);
+        const bool mine = L.slot_stamp()[j] == epoch;
+        const bool cand = !mine && (L.slot_page()[j] < 0 || L.slot_ref()[j] == 0);
+        int total = 0;
+        const int rank = kvs_block_scan(cand ? 1 : 0, warp_sums, total);
+        const int want = need - got;
+        if (threadIdx.x == 0) s_cut = KVS_RT;
+        __syncthreads();
+        if (cand && rank == want - 1) s_cut = threadIdx.x + 1;
+        __syncthreads();
+        const int cut = s_cut;
+        if (cand && rank < want) {
+            L.miss_slot()[got + rank] = j;
+            L.slot_stamp()[j] = epoch;
+        } else if (threadIdx.x < cut && !mine) {
+            L.slot_ref()[j] = 0;
+        }
+        got += total < want ? total : want;
+        hand = (int) (((int64_t) hand + cut) % n);
+        __syncthreads();
+    }
+    const int placed = got < need ? got : need;
+    for (int k = threadIdx.x; k < need; k += KVS_RT) {
+        const int b = L.miss_page()[k];
+        if (k >= placed) { L.page_table()[b] = -1; continue; }
+        const int sl = L.miss_slot()[k];
+        const int old = L.slot_page()[sl];
+        if (old >= 0) L.page_table()[old] = -1;
+        L.slot_page()[sl] = b;
+        L.slot_stamp()[sl] = epoch;
+        L.slot_ref()[sl] = 1;
+        L.page_table()[b] = sl;
+    }
+    if (threadIdx.x == 0) {
+        ctl[0] = epoch;
+        ctl[1] = hand;
+        ctl[2] = placed;
+        if (placed < need || ctl[3]) {
+            // a page the call needs is not resident: the attention would drop it. Never silent: the stream faults.
+            __trap();
+        }
+        unsigned long long * c = (unsigned long long *) (ctl + 4);
+        c[0] += (unsigned long long) placed;
+        c[1] += (unsigned long long) s_lookups;
+        c[2] += 1ull;
+    }
+}
+
+// cell -> slot row, in place (an unresolved page cannot reach here: the resolve traps on overflow)
+static __global__ void kvs_translate_kernel(ggml_cuda_kvs_layer L, int32_t * idx, const int32_t * counts, int n_kv_max) {
+    const int l = blockIdx.y;
+    const int n = counts[l];
+    int32_t * li = idx + (int64_t) l*n_kv_max;
+    for (int i = blockIdx.x*blockDim.x + threadIdx.x; i < n; i += gridDim.x*blockDim.x) {
+        const int c = li[i];
+        if (c < 0) continue;
+        const int sl = L.page_table()[c / KVS_PAGE];
+        li[i] = sl >= 0 ? sl*KVS_PAGE + c % KVS_PAGE : -1;
+    }
+}
+
+// check: every listed slot row equals its host row (lists hold slot rows, `orig` the cells)
+static __global__ void kvs_check_lists_kernel(ggml_cuda_kvs_layer L, const int32_t * slots, const int32_t * cells, const int32_t * counts, int n_kv_max) {
+    const int l = blockIdx.y;
+    const int n = counts[l];
+    for (int i = blockIdx.x; i < n; i += gridDim.x) {
+        const int c = cells[(int64_t) l*n_kv_max + i], s = slots[(int64_t) l*n_kv_max + i];
+        if (c < 0) continue;
+        bool bad = s < 0;
+        if (!bad) {
+            for (size_t j = threadIdx.x; j < L.rk; j += blockDim.x) bad |= L.sk[(int64_t) s*L.rk + j] != L.hk[(int64_t) c*L.rk + j];
+            for (size_t j = threadIdx.x; j < L.rv; j += blockDim.x) bad |= L.sv[(int64_t) s*L.rv + j] != L.hv[(int64_t) c*L.rv + j];
+        }
+        if (bad) atomicAdd(&L.ctl()[10], 1);
+    }
+}
+static __global__ void kvs_check_dense_kernel(ggml_cuda_kvs_layer L, const char * k, const char * v, int64_t n_kv) {
+    for (int64_t c = blockIdx.x; c < n_kv; c += gridDim.x) {
+        bool bad = false;
+        for (size_t j = threadIdx.x; j < L.rk; j += blockDim.x) bad |= k[c*L.rk + j] != L.hk[c*L.rk + j];
+        for (size_t j = threadIdx.x; j < L.rv; j += blockDim.x) bad |= v[c*L.rv + j] != L.hv[c*L.rv + j];
+        if (bad) atomicAdd(&L.ctl()[10], 1);
+    }
+}
+
+// the call's mask at slot-row columns, for the rows of each list's query tile
+static __global__ void kvs_mask_scatter_kernel(const half * mask, int64_t stride, half * ms, int64_t stride_s,
+        const int32_t * cells, const int32_t * slots, const int32_t * counts, int n_kv_max, int ncols1, int64_t ne01) {
+    const int l = blockIdx.y;
+    const int n = counts[l];
+    for (int i = blockIdx.x*blockDim.x + threadIdx.x; i < n; i += gridDim.x*blockDim.x) {
+        const int c = cells[(int64_t) l*n_kv_max + i], s = slots[(int64_t) l*n_kv_max + i];
+        if (c < 0 || s < 0) continue;
+        for (int64_t j = (int64_t) l*ncols1; j < (int64_t) (l + 1)*ncols1 && j < ne01; ++j) {
+            ms[j*stride_s + s] = mask[j*stride + c];
+        }
+    }
+}
+
+// prompt calls past N: mark the pages the lists name, then stage only those (from the slot when resident, else the host
+// copy) into the staging pool at their identity rows. Lists and mask are untouched: the stock read of the staging pool.
+static __global__ void kvs_mark_kernel(const int32_t * idx, const int32_t * counts, int n_kv_max, uint32_t * bits) {
+    const int l = blockIdx.y;
+    const int n = counts[l];
+    for (int i = blockIdx.x*blockDim.x + threadIdx.x; i < n; i += gridDim.x*blockDim.x) {
+        const int c = idx[(int64_t) l*n_kv_max + i];
+        if (c < 0) continue;
+        const int b = c / KVS_PAGE;
+        atomicOr(&bits[b >> 5], 1u << (b & 31));
+    }
+}
+static __global__ void kvs_stage_marked_kernel(ggml_cuda_kvs_layer L, const uint32_t * bits, int64_t P) {
+    const int64_t p = (int64_t) blockIdx.x*(blockDim.x/32) + threadIdx.x/32;
+    if (p >= P || !(bits[p >> 5] & (1u << (p & 31)))) return;
+    const int lane = threadIdx.x & 31;
+    const int32_t sl = L.page_table()[p];
+    const int64_t bk = KVS_PAGE*(int64_t) L.rk, bv = KVS_PAGE*(int64_t) L.rv;
+    const uint4 * sk = (const uint4 *) (sl >= 0 ? L.sk + sl*bk : L.hk + p*bk);
+    const uint4 * sv = (const uint4 *) (sl >= 0 ? L.sv + sl*bv : L.hv + p*bv);
+    uint4 * dk = (uint4 *) (L.gk + p*bk);
+    uint4 * dv = (uint4 *) (L.gv + p*bv);
+    for (int64_t i = lane; i < bk/16; i += 32) dk[i] = sk[i];
+    for (int64_t i = lane; i < bv/16; i += 32) dv[i] = sv[i];
+}
+// check for a union-staged call: every listed row of the staging pool equals its host row
+static __global__ void kvs_check_staged_lists_kernel(ggml_cuda_kvs_layer L, const int32_t * cells, const int32_t * counts, int n_kv_max) {
+    const int l = blockIdx.y;
+    const int n = counts[l];
+    for (int i = blockIdx.x; i < n; i += gridDim.x) {
+        const int c = cells[(int64_t) l*n_kv_max + i];
+        if (c < 0) continue;
+        bool bad = false;
+        for (size_t j = threadIdx.x; j < L.rk; j += blockDim.x) bad |= L.gk[(int64_t) c*L.rk + j] != L.hk[(int64_t) c*L.rk + j];
+        for (size_t j = threadIdx.x; j < L.rv; j += blockDim.x) bad |= L.gv[(int64_t) c*L.rv + j] != L.hv[(int64_t) c*L.rv + j];
+        if (bad) atomicAdd(&L.ctl()[10], 1);
+    }
+}
+
+static uint32_t * kvs_bits = nullptr; // one page bitmap for all layers
+static int64_t    kvs_bits_words = 0;
+
+// The staging pool and the bitmap have exactly one user: the target context, one stream, one call at a time. A second
+// user (another context or stream, e.g. a paged drafter) would race on them: it fails here instead.
+static cudaStream_t kvs_stage_stream = nullptr;
+static void kvs_one_user(cudaStream_t s) {
+    if (kvs_stage_stream == nullptr) kvs_stage_stream = s;
+    GGML_ASSERT(kvs_stage_stream == s && "kv_stream: the staging pool has one user stream; a second one needs an ordering protocol");
+}
+
+// ---------------------------------------------------------------------------------------------------- host side
+
+static thread_local bool kvs_bypass = false;
+void ggml_cuda_kvs_set_bypass(bool on) { kvs_bypass = on; }
+bool ggml_cuda_kvs_streamed(const ggml_tensor * K) {
+    bool is_v = false;
+    return !kvs_layers().empty() && ggml_cuda_kvs_find(K->data, &is_v) != nullptr;
+}
+
+static bool kvs_resolves(const ggml_cuda_kvs_layer * L, int64_t n_kv, int64_t n_lists, int64_t n_kv_max, int64_t ne01) {
+    const int64_t bound = n_lists*(n_kv_max/KVS_PAGE + 2); // the page bound of one resolve: half the pool for victims
+    return n_kv > L->n_slots*KVS_PAGE && 2*bound <= L->n_slots && ne01 <= 64;
+}
+
+int64_t ggml_cuda_kvs_resolve_cells(const ggml_tensor * K, int64_t n_kv, int64_t n_lists, int64_t n_kv_max, int64_t ne01) {
+    if (kvs_layers().empty() || kvs_bypass) return 0;
+    bool is_v = false;
+    const ggml_cuda_kvs_layer * L = ggml_cuda_kvs_find(K->data, &is_v);
+    return L && kvs_resolves(L, n_kv, n_lists, n_kv_max, ne01) ? L->n_slots*KVS_PAGE : 0;
+}
+
+static void kvs_check_result(const ggml_cuda_kvs_layer * L, cudaStream_t stream, const char * what, int64_t n_kv) {
+    static uint64_t n_checks = 0;
+    int32_t c[KVS_CTL];
+    CUDA_CHECK(cudaMemcpyAsync(c, L->ctl(), sizeof(c), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    ++n_checks;
+    const unsigned long long * u = (const unsigned long long *) (c + 4);
+    if (c[10] != 0 || c[3] != 0) {
+        GGML_LOG_ERROR("LLAMA_KV_STREAM_CHECK: layer %d, %s call, n_kv %lld: %d rows differ from the host copy, overflow %d\n",
+            L->il, what, (long long) n_kv, c[10], c[3]);
+        GGML_ABORT("LLAMA_KV_STREAM_CHECK: a streamed K/V row differs from the host copy");
+    }
+    if (n_checks <= 3 || n_checks % 2000 == 0) {
+        GGML_LOG_WARN("kv_stream check %llu ok (layer %d, %s, n_kv %lld): misses %llu of %llu page lookups in %llu resolves\n",
+            (unsigned long long) n_checks, L->il, what, (long long) n_kv, u[0], u[1], u[2]);
+    }
+}
+
+static __global__ void kvs_arange_kernel(int64_t * x, int64_t n) {
+    const int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i < n) x[i] = i;
+}
+
+// rows quantized in VRAM, then whole rows to the host copy (and the resident slot): 16 B stores over PCIe instead of the
+// quantize kernel's byte stores into host memory
+template <typename idx_t>
+static __global__ void kvs_rows_out_kernel(ggml_cuda_kvs_layer L, bool is_v, const char * rows_q, const idx_t * rows,
+                                           int64_t n_rows, int64_t row_off) {
+    const int64_t r = blockIdx.x;
+    if (r >= n_rows) return;
+    const int64_t c = (int64_t) rows[r] + row_off;
+    if (c < 0 || c >= L.n_cells) return;
+    const size_t rb = is_v ? L.rv : L.rk;
+    const uint4 * src = (const uint4 *) (rows_q + r*rb);
+    uint4 * host = (uint4 *) ((is_v ? L.hv : L.hk) + c*rb);
+    const int32_t sl = L.page_table()[c / KVS_PAGE];
+    uint4 * slot = sl < 0 ? nullptr : (uint4 *) ((is_v ? L.sv : L.sk) + ((int64_t) sl*KVS_PAGE + c % KVS_PAGE)*rb);
+    for (size_t i = threadIdx.x; i < rb/16; i += blockDim.x) {
+        const uint4 v = src[i];
+        host[i] = v;
+        if (slot) slot[i] = v;
+    }
+}
+
+bool ggml_cuda_kvs_set_rows(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    if (kvs_layers().empty()) return false;
+    bool is_v = false;
+    ggml_cuda_kvs_layer * L = ggml_cuda_kvs_find(dst->data, &is_v);
+    if (!L) return false;
+    const ggml_tensor * rows = dst->src[1];
+    const size_t rb = is_v ? L->rv : L->rk;
+    GGML_ASSERT(dst->nb[1] == rb && ggml_nelements(rows) == rows->ne[0] && dst->src[0]->ne[1] == rows->ne[0] &&
+                "kv_stream: one row index per K/V row");
+    const char * base = is_v ? L->hv : L->hk;
+    GGML_ASSERT(((const char *) dst->data - base) % rb == 0);
+    const int64_t off = ((const char *) dst->data - base) / rb;
+    const int64_t n = rows->ne[0];
+    if (n == 0) return true;
+    cudaStream_t stream = ctx.stream();
+    ggml_cuda_pool_alloc<char>    q(ctx.pool(), n*rb);
+    ggml_cuda_pool_alloc<int64_t> ar(ctx.pool(), n);
+    kvs_arange_kernel<<<(unsigned) ((n + 255)/256), 256, 0, stream>>>(ar.ptr, n);
+    ggml_tensor ix = *rows;
+    ix.type = GGML_TYPE_I64; ix.data = ar.ptr; ix.nb[0] = sizeof(int64_t);
+    for (int d = 1; d < GGML_MAX_DIMS; ++d) ix.nb[d] = ix.nb[d - 1]*ix.ne[d - 1];
+    ggml_tensor tmp = *dst;
+    tmp.data = q.ptr; tmp.view_src = nullptr; tmp.view_offs = 0;
+    tmp.ne[1] = n; tmp.ne[2] = 1; tmp.ne[3] = 1;
+    tmp.nb[2] = tmp.nb[1]*n; tmp.nb[3] = tmp.nb[2];
+    tmp.src[1] = &ix;
+    ggml_cuda_op_set_rows(ctx, &tmp);
+    if (rows->type == GGML_TYPE_I64) {
+        kvs_rows_out_kernel<int64_t><<<(unsigned) n, 64, 0, stream>>>(*L, is_v, q.ptr, (const int64_t *) rows->data, n, off);
+    } else {
+        kvs_rows_out_kernel<int32_t><<<(unsigned) n, 64, 0, stream>>>(*L, is_v, q.ptr, (const int32_t *) rows->data, n, off);
+    }
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
+
+bool ggml_cuda_kvs_attn(cudaStream_t stream, const ggml_tensor * K, const ggml_tensor * V, int64_t n_kv,
+                        bool sparse_direct, int32_t * indices, const int32_t * counts, int64_t n_lists, int64_t n_kv_max,
+                        ggml_cuda_kvs_mask * mask, const char ** K_data, const char ** V_data) {
+    if (kvs_layers().empty() || kvs_bypass) return false;
+    bool is_v = false;
+    ggml_cuda_kvs_layer * L = ggml_cuda_kvs_find(K->data, &is_v);
+    if (!L) return false;
+    bool v_is_v = false;
+    GGML_ASSERT(!is_v && K->data == L->hk && ggml_cuda_kvs_find(V->data, &v_is_v) == L && v_is_v && V->data == L->hv);
+    GGML_ASSERT(K->nb[1] == L->rk && V->nb[1] == L->rv);
+    static const int check = kvs_env("LLAMA_KV_STREAM_CHECK");
+
+    if (sparse_direct && indices != nullptr && mask != nullptr && mask->cells != nullptr && mask->scratch != nullptr &&
+            kvs_resolves(L, n_kv, n_lists, n_kv_max, mask->ne01)) {
+        int32_t * cells = mask->cells;
+        CUDA_CHECK(cudaMemcpyAsync(cells, indices, n_lists*n_kv_max*sizeof(int32_t), cudaMemcpyDeviceToDevice, stream));
+        if (check) {
+            CUDA_CHECK(cudaMemsetAsync(L->ctl() + 10, 0, sizeof(int32_t), stream));
+        }
+        kvs_resolve_kernel<<<1, KVS_RT, 0, stream>>>(*L, indices, counts, (int) n_lists, (int) n_kv_max);
+        kvs_copy_misses_kernel<<<96, 128, 0, stream>>>(*L);
+        const dim3 grid((unsigned) std::min<int64_t>((n_kv_max + 255)/256, 64), (unsigned) n_lists);
+        kvs_translate_kernel<<<grid, 256, 0, stream>>>(*L, indices, counts, (int) n_kv_max);
+        kvs_mask_scatter_kernel<<<grid, 256, 0, stream>>>(mask->data, mask->stride, mask->scratch, L->n_slots*KVS_PAGE,
+            cells, indices, counts, (int) n_kv_max, mask->ncols1, mask->ne01);
+        CUDA_CHECK(cudaGetLastError());
+        mask->swapped    = true;
+        mask->out_stride = L->n_slots*KVS_PAGE;
+        if (check) {
+            kvs_check_lists_kernel<<<dim3(64, (unsigned) n_lists), 128, 0, stream>>>(*L, indices, cells, counts, (int) n_kv_max);
+            kvs_check_result(L, stream, "resolve", n_kv);
+        }
+        *K_data = L->sk;
+        *V_data = L->sv;
+        return true;
+    }
+    if (n_kv <= L->n_slots*KVS_PAGE) {
+        // the first n_kv cells at their identity slots: a scan when they already are
+        const int64_t P = (n_kv + KVS_PAGE - 1)/KVS_PAGE;
+        kvs_identity_a_kernel<<<(unsigned) ((P + 255)/256), 256, 0, stream>>>(*L, P);
+        kvs_identity_b_kernel<<<(unsigned) ((P + 255)/256), 256, 0, stream>>>(*L, P);
+        kvs_identity_c_kernel<<<96, 128, 0, stream>>>(*L, P);
+        CUDA_CHECK(cudaGetLastError());
+        *K_data = L->sk;
+        *V_data = L->sv;
+    } else {
+        if (indices != nullptr && n_lists > 0) {
+            // a prompt ubatch at depth with index lists: stage only the pages they name
+            const int64_t P = (n_kv + KVS_PAGE - 1)/KVS_PAGE;
+            GGML_ASSERT((P + 31)/32 <= kvs_bits_words);
+            kvs_one_user(stream);
+            CUDA_CHECK(cudaMemsetAsync(kvs_bits, 0, (P + 31)/32*sizeof(uint32_t), stream));
+            kvs_mark_kernel<<<dim3(16, (unsigned) n_lists), 256, 0, stream>>>(indices, counts, (int) n_kv_max, kvs_bits);
+            kvs_stage_marked_kernel<<<(unsigned) ((P + 7)/8), 256, 0, stream>>>(*L, kvs_bits, P);
+            CUDA_CHECK(cudaGetLastError());
+            *K_data = L->gk;
+            *V_data = L->gv;
+            if (check) {
+                CUDA_CHECK(cudaMemsetAsync(L->ctl() + 10, 0, sizeof(int32_t), stream));
+                kvs_check_staged_lists_kernel<<<dim3(64, (unsigned) n_lists), 128, 0, stream>>>(*L, indices, counts, (int) n_kv_max);
+                kvs_check_result(L, stream, "union-staged", n_kv);
+            }
+            return true;
+        }
+        // a prompt ubatch at depth without lists: the whole prefix, host -> staging pool, read as stock
+        kvs_one_user(stream);
+        CUDA_CHECK(cudaMemcpyAsync(L->gk, L->hk, n_kv*L->rk, cudaMemcpyDefault, stream));
+        CUDA_CHECK(cudaMemcpyAsync(L->gv, L->hv, n_kv*L->rv, cudaMemcpyDefault, stream));
+        *K_data = L->gk;
+        *V_data = L->gv;
+    }
+    if (check) {
+        CUDA_CHECK(cudaMemsetAsync(L->ctl() + 10, 0, sizeof(int32_t), stream));
+        kvs_check_dense_kernel<<<256, 128, 0, stream>>>(*L, *K_data, *V_data, n_kv);
+        kvs_check_result(L, stream, *K_data == L->sk ? "identity" : "staged", n_kv);
+    }
+    return true;
+}
+
+void ggml_cuda_kvs_forget(const void * ptr, size_t size) {
+    const char * p = (const char *) ptr;
+    auto & v = kvs_layers();
+    for (size_t i = 0; i < v.size();) {
+        ggml_cuda_kvs_layer * L = v[i];
+        if (L->hk >= p && L->hk < p + size) {
+            CUDA_CHECK(cudaFree(L->st));
+            delete L;
+            v.erase(v.begin() + i);
+        } else {
+            ++i;
+        }
+    }
+    if (v.empty()) { // the last cache is gone: the next one may come with another stream and more pages
+        if (kvs_bits) CUDA_CHECK(cudaFree(kvs_bits));
+        kvs_bits = nullptr; kvs_bits_words = 0; kvs_stage_stream = nullptr;
+    }
+}
+
+void ggml_cuda_kvs_gpu_write(cudaStream_t stream, const ggml_tensor * dst) {
+    if (kvs_layers().empty() || dst->op == GGML_OP_SET_ROWS || ggml_is_empty(dst) || dst->op == GGML_OP_NONE ||
+        dst->op == GGML_OP_VIEW || dst->op == GGML_OP_RESHAPE || dst->op == GGML_OP_PERMUTE || dst->op == GGML_OP_TRANSPOSE) return;
+    bool is_v = false;
+    ggml_cuda_kvs_layer * L = ggml_cuda_kvs_find(dst->data, &is_v);
+    if (L) {
+        kvs_empty_kernel<<<64, 256, 0, stream>>>(*L); // an op wrote the host copy without write-through
+        CUDA_CHECK(cudaGetLastError());
+    }
+}
+
+void ggml_cuda_kvs_invalidate(const void * ptr, size_t size) {
+    const char * p = (const char *) ptr;
+    for (auto * L : kvs_layers()) {
+        const bool hit_k = p < L->hk + L->n_cells*L->rk && p + size > L->hk;
+        const bool hit_v = p < L->hv + L->n_cells*L->rv && p + size > L->hv;
+        if (hit_k || hit_v) {
+            kvs_empty_kernel<<<64, 256, 0, cudaStreamPerThread>>>(*L);
+            CUDA_CHECK(cudaGetLastError());
+            CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+        }
+    }
+}
+
+extern "C" void ggml_backend_cuda_kvs_register(void * host_k, void * host_v, void * slot_k, void * slot_v, void * stage_k,
+                                               void * stage_v, int64_t n_cells, int64_t n_slot_cells,
+                                               size_t row_k, size_t row_v, int il) {
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    GGML_ASSERT(n_cells % KVS_PAGE == 0 && n_slot_cells % KVS_PAGE == 0 && n_slot_cells >= KVS_RT*KVS_PAGE);
+    GGML_ASSERT(row_k % 16 == 0 && row_v % 16 == 0);
+    for (auto * o : kvs_layers()) GGML_ASSERT((o->gk != stage_k || (o->rk == row_k && o->rv == row_v)) && "kv_stream: one staging pool, one row size");
+    auto * L = new ggml_cuda_kvs_layer;
+    L->hk = (const char *) host_k; L->hv = (const char *) host_v;
+    L->sk = (char *) slot_k; L->sv = (char *) slot_v;
+    L->gk = (char *) stage_k; L->gv = (char *) stage_v;
+    L->n_cells = n_cells; L->n_pages = n_cells/KVS_PAGE; L->n_slots = n_slot_cells/KVS_PAGE;
+    L->rk = row_k; L->rv = row_v; L->il = il;
+    int32_t * state = nullptr;
+    CUDA_CHECK(cudaMalloc(&state, (L->n_pages + 5*L->n_slots + KVS_CTL)*sizeof(int32_t)));
+    L->st = state;
+    const int64_t words = (L->n_pages + 31)/32;
+    if (words > kvs_bits_words) {
+        if (kvs_bits) CUDA_CHECK(cudaFree(kvs_bits)); // cudaFree waits for the device: no call still reads the old one
+        CUDA_CHECK(cudaMalloc(&kvs_bits, words*sizeof(uint32_t)));
+        kvs_bits_words = words;
+    }
+    CUDA_CHECK(cudaMemset(L->ctl(), 0, KVS_CTL*sizeof(int32_t)));
+    kvs_empty_kernel<<<64, 256>>>(*L);
+    CUDA_CHECK(cudaGetLastError());
+    CUDA_CHECK(cudaDeviceSynchronize());
+    kvs_layers().push_back(L);
+}
