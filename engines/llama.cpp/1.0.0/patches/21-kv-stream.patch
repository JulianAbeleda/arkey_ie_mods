diff --git a/src/llama-kv-stream.cpp b/src/llama-kv-stream.cpp
new file mode 100644
index 0000000..2f0055a
--- /dev/null
+++ b/src/llama-kv-stream.cpp
@@ -0,0 +1,93 @@
+#include "llama-kv-stream.h"
+
+#include "llama-impl.h"
+#include "llama-model.h"
+
+#include <cstdlib>
+
+static int64_t kvs_env(const char * name, int64_t def) {
+    const char * e = getenv(name);
+    return e ? atoll(e) : def;
+}
+
+static const char * kvs_check_n(int64_t n, uint32_t kv_size) {
+    if (n % 4 != 0 || n < 4096) return "N must be a multiple of 4 and >= 4096";
+    if ((int64_t) kv_size <= n) return "the context fits in N cells";
+    return nullptr;
+}
+
+llama_kv_stream llama_kv_stream::plan(const llama_model & model, const llama_hparams & hparams, bool main_attn_cache,
+                                      ggml_type type_k, ggml_type type_v, uint32_t kv_size, uint32_t n_stream, bool offload) {
+    GGML_UNUSED(hparams);
+    llama_kv_stream s;
+    int64_t n_main  = kvs_env("LLAMA_KV_STREAM", 0);
+    if (n_main <= 0 || !main_attn_cache) {
+        return s;
+    }
+    const char * why = nullptr;
+    if (model.arch != LLM_ARCH_QWEN4EXP)                          why = "not a QSA model";
+    else if (type_k != GGML_TYPE_Q8_0 || type_v != GGML_TYPE_Q8_0) why = "K/V are not q8_0";
+    else if (n_stream != 1 || !offload)                           why = "needs one unified stream on the GPU";
+    ggml_backend_dev_t dev = why ? nullptr : model.dev_output();
+    if (!why && !dev) why = "no GPU device";
+    ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    auto * get_buft = reg ? (ggml_backend_buffer_type_t (*)(int)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_kvs_host_buft") : nullptr;
+    if (!why && !get_buft) why = "the backend has no streamed KV (CUDA only)";
+    if (why) {
+        LLAMA_LOG_WARN("%s: LLAMA_KV_STREAM ignored: %s\n", __func__, why);
+        return s;
+    }
+    if (const char * w = kvs_check_n(n_main, kv_size)) {
+        LLAMA_LOG_WARN("%s: LLAMA_KV_STREAM=%lld ignored: %s\n", __func__, (long long) n_main, w);
+        return s;
+    }
+    int dev_idx = 0;
+    for (size_t i = 0; i < ggml_backend_reg_dev_count(reg); ++i) {
+        if (ggml_backend_reg_dev_get(reg, i) == dev) { dev_idx = (int) i; break; }
+    }
+    s.n_main    = n_main;
+    s.host_buft = get_buft(dev_idx);
+    s.reg       = reg;
+    s.kv_size   = kv_size;
+    return s;
+}
+
+// the target's attention layers only: the MTP drafter (il >= n_layer, its own context and stream) is not streamed
+int64_t llama_kv_stream::slot_cells(const llama_hparams & hparams, uint32_t il) const {
+    return il < hparams.n_layer() ? n_main : 0;
+}
+
+bool llama_kv_stream::streams(const llama_hparams & hparams, uint32_t il, bool has_v) const {
+    return host_buft != nullptr && has_v && slot_cells(hparams, il) > 0 && hparams.dsv4_compress_ratios[il] > 0;
+}
+
+void llama_kv_stream::add_layer(ggml_context * ctx_dev, const llama_hparams & hparams, int il, ggml_tensor * k, ggml_tensor * v) {
+    const int64_t n_slot_cells = slot_cells(hparams, il);
+    ggml_tensor * ks = ggml_new_tensor_2d(ctx_dev, k->type, k->ne[0], n_slot_cells);
+    ggml_tensor * vs = ggml_new_tensor_2d(ctx_dev, v->type, v->ne[0], n_slot_cells);
+    ggml_format_name(ks, "cache_k_pages_l%d", il);
+    ggml_format_name(vs, "cache_v_pages_l%d", il);
+    if (gk == nullptr) {
+        gk = ggml_new_tensor_2d(ctx_dev, k->type, k->ne[0], kv_size);
+        gv = ggml_new_tensor_2d(ctx_dev, v->type, v->ne[0], kv_size);
+        ggml_set_name(gk, "cache_k_stage");
+        ggml_set_name(gv, "cache_v_stage");
+    }
+    layers.push_back({ il, k, v, ks, vs, n_slot_cells });
+}
+
+void llama_kv_stream::register_layers() {
+    if (layers.empty()) {
+        return;
+    }
+    using reg_fn = void (*)(void *, void *, void *, void *, void *, void *, int64_t, int64_t, size_t, size_t, int);
+    auto * fn = (reg_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_kvs_register");
+    GGML_ASSERT(fn != nullptr);
+    for (const auto & l : layers) {
+        GGML_ASSERT(l.k->data && l.ks->data);
+        fn(l.k->data, l.v->data, l.ks->data, l.vs->data, gk ? gk->data : nullptr, gv ? gv->data : nullptr,
+           l.k->ne[1], l.n_slot_cells, l.k->nb[1], l.v->nb[1], l.il);
+        LLAMA_LOG_WARN("%s: LLAMA_KV_STREAM: layer %d streamed, %lld of %lld cells in VRAM\n", __func__, l.il,
+            (long long) l.n_slot_cells, (long long) l.k->ne[1]);
+    }
+}
diff --git a/src/llama-kv-stream.h b/src/llama-kv-stream.h
new file mode 100644
index 0000000..a509d19
--- /dev/null
+++ b/src/llama-kv-stream.h
@@ -0,0 +1,39 @@
+#pragma once
+
+// LLAMA_KV_STREAM (local long-context mod, off by default): where a KV cache layer keeps its K/V.
+// The extension point of llama_kv_cache's storage: plan() decides once per cache, streams() per layer, and the cache
+// asks add_layer() for the VRAM side of a streamed layer and register_layers() once its buffers exist.
+// A streamed layer: full q8_0 K/V in pinned host memory under the CUDA buffer type family (every op still runs on
+// the GPU), plus `n_slot_cells` cells of VRAM pages that flash attention reads through a page map (ggml-cuda/kv-stream.cu).
+//   LLAMA_KV_STREAM=N        resident cells per target attention layer (multiple of 4, >= 4096); 0 or unset = stock
+//   LLAMA_KV_STREAM_CHECK=1  every streamed read is compared with the host copy, abort on a differing byte
+//                            (synchronizes: run with GGML_CUDA_DISABLE_GRAPHS=1)
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <cstdint>
+#include <vector>
+
+struct llama_model;
+struct llama_hparams;
+
+struct llama_kv_stream {
+    int64_t n_main  = 0;                // VRAM cells per target attention layer (LLAMA_KV_STREAM); 0: off
+    ggml_backend_buffer_type_t host_buft = nullptr;
+    ggml_backend_reg_t         reg       = nullptr;
+
+    struct layer { int il; ggml_tensor * k, * v, * ks, * vs; int64_t n_slot_cells; };
+    std::vector<layer> layers;
+    ggml_tensor * gk = nullptr;         // one staging pool for all layers (calls on one stream are serial)
+    ggml_tensor * gv = nullptr;
+    int64_t kv_size = 0;
+
+    static llama_kv_stream plan(const llama_model & model, const llama_hparams & hparams, bool main_attn_cache,
+                                ggml_type type_k, ggml_type type_v, uint32_t kv_size, uint32_t n_stream, bool offload);
+
+    int64_t slot_cells(const llama_hparams & hparams, uint32_t il) const;
+    bool streams(const llama_hparams & hparams, uint32_t il, bool has_v) const;
