@@ -4334,6 +4334,8 @@ static bool ggml_cuda_can_fuse(const struct ggml_cgraph *                cgraph,
     return false;
 }
 
+int ggml_cuda_ext_kernels_run(void * stream, ggml_cgraph * cgraph, int i, bool (*stock)(void *, ggml_tensor *), void * stock_ctx);
+
 // try and fuse nodes and return the number of nodes to skip
 static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
 
@@ -5325,6 +5327,16 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     continue;
                 }
 
+                // opt-in mod: an external kernel from a manifest takes this node (ext-kernels.cpp); unset = stock
+                static const bool ext_kernels = getenv("GGML_CUDA_EXT_KERNELS") != nullptr;
+                if (ext_kernels && ggml_cuda_ext_kernels_run(cuda_ctx->stream(), cgraph, i, [](void * ctx, ggml_tensor * t) {
+                        return ggml_cuda_compute_forward(*(ggml_backend_cuda_context *) ctx, t); }, cuda_ctx) != 0) {
+                    if (!is_concurrent_event_active) {
+                        try_launch_concurrent_event(node);
+                    }
+                    continue;
+                }
+
                 int nodes_to_skip = ggml_cuda_try_fuse(cuda_ctx, cgraph, i);
 
                 if (nodes_to_skip != 0) {
