+        ggml_cuda_kernel_launch(flash_attn_mask_split_count, lp, (const half *) mask->data, chunk_counts, int(mask->ne[0]), s31);
+        ggml_cuda_kernel_launch(flash_attn_mask_split_write, lp, (const half *) mask->data, (const int32_t *) chunk_counts,
+            indices, counts, int(mask->ne[0]), n_kv_max, s31);
+        // LLAMA_SPARSE_SPLIT_CHECK=1 (with GGML_CUDA_DISABLE_GRAPHS=1): the stock kernel beside it, abort on any word
+        static const bool check = getenv("LLAMA_SPARSE_SPLIT_CHECK") && atoi(getenv("LLAMA_SPARSE_SPLIT_CHECK")) != 0;
+        if (check) {
