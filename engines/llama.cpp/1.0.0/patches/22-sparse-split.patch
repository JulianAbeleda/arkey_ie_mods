+
+// LLAMA_SPARSE_SPLIT=1 (local long-context mod, off by default): one-query lists compacted by many blocks. The stock
+// kernel runs one block per list, so a decode verify (4 lists) uses 4 of the GPU's SMs and walks n_kv serially.
+// Pass 1: each block counts the finite cells of its SPLIT_CHUNK-cell chunk. Pass 2: each block sums the counts of the
+// chunks before it and writes its finite cells in ascending order; the last chunk writes the -1 padding and the count.
+// Integer only: the lists and counts are the stock kernel's, word for word.
+#define SPLIT_THREADS 256
+#define SPLIT_CELLS_T 16
+#define SPLIT_CHUNK   (SPLIT_THREADS*SPLIT_CELLS_T)
+
+static __device__ __forceinline__ uint32_t split_finite_bits(const uint16_t * row, const int c0, const int ne30) {
+    uint32_t bits = 0;
+    if (c0 + SPLIT_CELLS_T <= ne30 && ((uintptr_t) (row + c0) & 15) == 0) {
+        const uint4 a = ((const uint4 *) (row + c0))[0];
+        const uint4 b = ((const uint4 *) (row + c0))[1];
+        const uint32_t w[8] = {a.x, a.y, a.z, a.w, b.x, b.y, b.z, b.w};
+#pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            bits |= uint32_t(((w[j]      ) & 0x7C00u) != 0x7C00u) << (2*j);
+            bits |= uint32_t(((w[j] >> 16) & 0x7C00u) != 0x7C00u) << (2*j + 1);
+        }
+    } else {
+        for (int j = 0; j < SPLIT_CELLS_T; ++j) {
+            if (c0 + j < ne30 && (row[c0 + j] & 0x7C00u) != 0x7C00u) {
+                bits |= 1u << j;
+            }
+        }
+    }
+    return bits;
+}
+
+static __device__ __forceinline__ int split_block_sum(int v, int * sh) {
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) {
+        v += __shfl_xor_sync(0xFFFFFFFFu, v, o);
+    }
+    if (threadIdx.x % 32 == 0) {
+        sh[threadIdx.x / 32] = v;
+    }
+    __syncthreads();
+    int t = 0;
+#pragma unroll
+    for (int w = 0; w < SPLIT_THREADS/32; ++w) {
+        t += sh[w];
+    }
+    return t;
+}
+
+__launch_bounds__(SPLIT_THREADS)
+static __global__ void flash_attn_mask_split_count(const half * mask_ptr, int32_t * chunk_counts, const int ne30, const int64_t s31) {
+    ggml_cuda_pdl_sync();
+    __shared__ int sh[SPLIT_THREADS/32];
+    const uint16_t * row = (const uint16_t *) (mask_ptr + blockIdx.y*s31);
+    const int t = split_block_sum(__popc(split_finite_bits(row, blockIdx.x*SPLIT_CHUNK + threadIdx.x*SPLIT_CELLS_T, ne30)), sh);
+    if (threadIdx.x == 0) {
+        chunk_counts[int64_t(blockIdx.y)*gridDim.x + blockIdx.x] = t;
+    }
+    ggml_cuda_pdl_lc();
+}
+
+__launch_bounds__(SPLIT_THREADS)
+static __global__ void flash_attn_mask_split_write(const half * mask_ptr, const int32_t * chunk_counts, int32_t * indices_ptr,
+        int32_t * counts_ptr, const int ne30, const int n_kv_max, const int64_t s31) {
+    ggml_cuda_pdl_sync();
+    __shared__ int sh[SPLIT_THREADS/32];
+    __shared__ int warp_inc[SPLIT_THREADS/32];
+    const int lane = threadIdx.x % 32;
+    const int warp = threadIdx.x / 32;
+    const int32_t * cc = chunk_counts + int64_t(blockIdx.y)*gridDim.x;
+    int pre = 0;
+    for (int j = threadIdx.x; j < (int) blockIdx.x; j += SPLIT_THREADS) {
+        pre += cc[j];
+    }
+    const int base = split_block_sum(pre, sh);
+
+    const uint16_t * row = (const uint16_t *) (mask_ptr + blockIdx.y*s31);
+    const int c0 = blockIdx.x*SPLIT_CHUNK + threadIdx.x*SPLIT_CELLS_T;
+    uint32_t bits = split_finite_bits(row, c0, ne30);
+    const int n = __popc(bits);
+    int inc = n;
+#pragma unroll
+    for (int o = 1; o < 32; o <<= 1) {
+        const int y = __shfl_up_sync(0xFFFFFFFFu, inc, o);
+        inc += lane >= o ? y : 0;
+    }
+    if (lane == 31) {
+        warp_inc[warp] = inc;
+    }
+    __syncthreads();
+    int dst = base + inc - n;
+    int chunk_total = 0;
+#pragma unroll
+    for (int w = 0; w < SPLIT_THREADS/32; ++w) {
+        dst += w < warp ? warp_inc[w] : 0;
+        chunk_total += warp_inc[w];
+    }
+    int32_t * indices = indices_ptr + int64_t(blockIdx.y)*n_kv_max;
+    for (; bits; bits &= bits - 1, ++dst) {
+        if (dst < n_kv_max) {
+            indices[dst] = c0 + __ffs(bits) - 1;
+        }
+    }
+    if (blockIdx.x == gridDim.x - 1) {
+        const int count = min(base + chunk_total, n_kv_max);
+        for (int i = count + threadIdx.x; i < n_kv_max; i += SPLIT_THREADS) {
+            indices[i] = -1;
+        }
+        if (threadIdx.x == 0) {
+            counts_ptr[blockIdx.y] = count;
+        }
+    }
+    __syncthreads();
+    ggml_cuda_pdl_lc();
+}
+
+static bool sparse_split_on(const ggml_tensor * mask, int32_t n_queries, int32_t ncols1) {
+#if defined(GGML_USE_HIP)
+    const bool on = false; // the kernels assume 32-lane warps
+#else
+    static const bool on = getenv("LLAMA_SPARSE_SPLIT") && atoi(getenv("LLAMA_SPARSE_SPLIT")) != 0;
+#endif // defined(GGML_USE_HIP)
+    // only when the stock grid (one block per list) leaves most SMs idle
+    return on && ncols1 == 1 && mask->ne[3] == 1 && n_queries < ggml_cuda_info().devices[ggml_cuda_get_device()].nsm &&
+        mask->ne[0] > SPLIT_CHUNK && mask->nb[1] % 16 == 0 && (uintptr_t) mask->data % 16 == 0;
+}
 #endif // !defined(GGML_USE_MUSA)
 
+size_t ggml_cuda_flash_attn_ext_compact_scratch(const ggml_tensor * mask, int32_t n_queries, int32_t ncols1) {
+#ifdef GGML_USE_MUSA
+    GGML_UNUSED_VARS(mask, n_queries, ncols1);
+    return 0;
+#else
+    return sparse_split_on(mask, n_queries, ncols1) ? size_t(n_queries)*((mask->ne[0] + SPLIT_CHUNK - 1)/SPLIT_CHUNK) : 0;
+#endif // GGML_USE_MUSA
+}
+
