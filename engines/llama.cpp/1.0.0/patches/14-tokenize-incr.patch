     } else {
         auto s = json_prompt.template get<std::string>();
-        prompt_tokens = common_tokenize(vocab, s, add_special, parse_special);
+        prompt_tokens = tokenize_incr(vocab, s, add_special, parse_special); // LOCAL (tokenize-incr): stock unless LLAMA_TOKENIZE_INCR=1
