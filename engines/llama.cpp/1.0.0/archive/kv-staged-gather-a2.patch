+bool ggml_cuda_flash_attn_ext_stage(ggml_backend_cuda_context & ctx, const ggml_tensor * dst, const int32_t * lists,
+        const int64_t n_lists, const int64_t n_kv_max, ggml_cuda_fattn_stage & st) {
+    static const bool on  = sparse_direct_env("LLAMA_KV_STAGE") != 0;
+    static const int  log = sparse_direct_env("LLAMA_KV_STAGE_LOG");
+    const ggml_tensor * Q = dst->src[0], * K = dst->src[1], * V = dst->src[2], * mask = dst->src[3];
+    const int64_t n_kv  = K->ne[1];
+    const int64_t n_max = std::min(n_kv, n_lists*n_kv_max);
+    const size_t  smem  = (n_kv + 31)/32*2*sizeof(uint32_t);
+    // rows hold every K/V head (the kernel's head offset stays valid), 16 byte aligned; one sequence; the bitmap fits
+    if (!on || kv_stage_off || n_lists != Q->ne[1] || mask->ne[3] != 1 || K->ne[3] != 1 || V->ne[3] != 1 || n_max <= 0 ||
+            n_max > 16384 || smem > 40*1024 || K->nb[1] % 16 != 0 || V->nb[1] % 16 != 0 ||
+            (uintptr_t) K->data % 16 != 0 || (uintptr_t) V->data % 16 != 0 ||
+            K->nb[1] < K->nb[2]*K->ne[2] || V->nb[1] < V->nb[2]*V->ne[2]) {
+        return false;
+    }
+    static bool told = false;
+    if (!told) {
+        told = true;
+        GGML_LOG_WARN("%s: LLAMA_KV_STAGE on: sparse K/V rows staged in device scratch (first call: %lld lists x %lld, n_kv %lld)\n",
+            __func__, (long long) n_lists, (long long) n_kv_max, (long long) n_kv);
+    }
+    cudaStream_t stream = ctx.stream();
+    st.n_max = n_max;
+    st.K.alloc(ctx.pool(), n_max*K->nb[1]);
+    st.V.alloc(ctx.pool(), n_max*V->nb[1]);
+    st.mask.alloc(ctx.pool(), n_max*Q->ne[1]);
+    st.slots.alloc(ctx.pool(), n_lists*n_kv_max + n_lists);
+    st.cells.alloc(ctx.pool(), n_max + 1);
+
+    ggml_cuda_kernel_launch(flash_attn_stage_slots, ggml_cuda_kernel_launch_params(dim3(1, 1, 1), dim3(256, 1, 1), smem, stream),
+        lists, st.slots.ptr, st.cells.ptr, int(n_lists), int(n_kv_max), int(n_kv), int(n_max));
+    ggml_cuda_kernel_launch(flash_attn_stage_rows, ggml_cuda_kernel_launch_params(dim3((n_max + 7)/8, 1, 1), dim3(256, 1, 1), 0, stream),
+        (const char *) K->data, (const char *) V->data, (const half *) mask->data, (const int32_t *) st.cells.ptr,
+        st.K.ptr, st.V.ptr, st.mask.ptr, int(n_max), int(Q->ne[1]), int64_t(K->nb[1]), int64_t(V->nb[1]), int64_t(mask->nb[1]/sizeof(half)));
+
+    static uint64_t n_call = 0;
+    cudaStreamCaptureStatus cs = cudaStreamCaptureStatusNone;
+    if (log > 0 && n_call++ % log == 0 && cudaStreamIsCapturing(stream, &cs) == cudaSuccess && cs == cudaStreamCaptureStatusNone) {
+        static const int64_t window = [] { const char * e = getenv("LLAMA_KV_HOST_OLD"); return e ? atoll(e) : 0; }();
+        std::vector<int32_t> c(n_max + 1);
+        CUDA_CHECK(cudaMemcpyAsync(c.data(), st.cells.ptr, c.size()*sizeof(int32_t), cudaMemcpyDeviceToHost, stream));
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+        const int n_union = c[n_max];
+        int n_old = 0;
+        for (int i = 0; i < n_union; ++i) {
+            n_old += c[i] < c[n_union - 1] - window;
+        }
+        GGML_LOG_WARN("kvstage: n_q %lld n_kv %lld lists %lld x %lld union %d old %d (window %lld)\n", (long long) Q->ne[1],
+            (long long) n_kv, (long long) n_lists, (long long) n_kv_max, n_union, window > 0 ? n_old : 0, (long long) window);
+    }
+    return true;
+}
