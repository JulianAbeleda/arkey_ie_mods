+// LLAMA_KV_STAGE (see fattn-common.cuh). LLAMA_KV_STAGE_CHECK=N: every Nth staged call is also run unstaged and the
+// outputs compared bitwise. LLAMA_KV_STAGE_LOG=N: every Nth staged call logs the union size and how many of its rows
+// are more than LLAMA_KV_HOST_OLD cells behind the newest row. Both need GGML_CUDA_DISABLE_GRAPHS=1.
+static thread_local bool kv_stage_off = false;
+
+// one block: the lists' cells set bits of an n_kv bitmap; its rank gives each cell a slot in ascending cell order
+static __global__ void flash_attn_stage_slots(
+        const int32_t * lists, int32_t * slots, int32_t * cells, const int n_lists, const int n_kv_max, const int n_kv, const int n_max) {
+    ggml_cuda_pdl_sync();
+    constexpr int nthreads = 256;
+    extern __shared__ uint32_t stage_smem[];
+    __shared__ int offs[nthreads + 1];
+    const int tid = threadIdx.x;
+    const int nw  = (n_kv + 31) / 32;
+    const int n   = n_lists*n_kv_max;
+    uint32_t * bits = stage_smem;
+    int32_t  * wpre = (int32_t *) (stage_smem + nw);
+
+    for (int i = tid; i < nw; i += nthreads) {
+        bits[i] = 0;
+    }
+    __syncthreads();
+    for (int i = tid; i < n; i += nthreads) {
+        const int32_t c = lists[i];
+        if (c >= 0 && c < n_kv) {
+            atomicOr(&bits[c / 32], 1u << (c % 32));
+        }
+    }
+    __syncthreads();
+    const int wpt = (nw + nthreads - 1) / nthreads;
+    const int w0  = min(tid*wpt, nw);
+    const int w1  = min(w0 + wpt, nw);
+    int cnt = 0;
+    for (int w = w0; w < w1; ++w) {
+        cnt += __popc(bits[w]);
+    }
+    offs[tid + 1] = cnt;
+    __syncthreads();
+    if (tid == 0) {
+        offs[0] = 0;
+        for (int i = 1; i <= nthreads; ++i) {
+            offs[i] += offs[i - 1];
+        }
+    }
+    __syncthreads();
+    int o = offs[tid];
+    for (int w = w0; w < w1; ++w) {
+        wpre[w] = o;
+        for (uint32_t m = bits[w]; m; m &= m - 1) {
+            if (o < n_max) {
+                cells[o] = 32*w + __ffs(m) - 1;
+            }
+            ++o;
+        }
+    }
+    __syncthreads();
+    for (int i = tid; i < n; i += nthreads) {
+        const int32_t c = lists[i];
+        slots[i] = c >= 0 && c < n_kv ? wpre[c / 32] + __popc(bits[c / 32] & ((1u << (c % 32)) - 1)) : -1;
+    }
+    for (int i = tid; i < n_lists; i += nthreads) {
+        slots[n + i] = lists[n + i]; // the live count of each list
+    }
+    if (tid == 0) {
+        cells[n_max] = min(offs[nthreads], n_max);
+    }
+}
+
+// one warp per union row: K and V rows in 16 byte loads, each byte read once; the mask value of each query for the row
+static __global__ void flash_attn_stage_rows(
+        const char * K, const char * V, const half * mask, const int32_t * cells, char * K_st, char * V_st, half * mask_st,
+        const int n_max, const int n_q, const int64_t nb11, const int64_t nb21, const int64_t s31) {
+    ggml_cuda_pdl_sync();
+    const int s    = blockIdx.x*(blockDim.x/32) + threadIdx.x/32;
+    const int lane = threadIdx.x % 32;
+    if (s >= n_max || s >= cells[n_max]) {
+        return;
+    }
+    const int64_t c = cells[s];
+    const uint4 * k_src = (const uint4 *) (K + c*nb11);
+    const uint4 * v_src = (const uint4 *) (V + c*nb21);
+    uint4 * k_dst = (uint4 *) (K_st + s*nb11);
+    uint4 * v_dst = (uint4 *) (V_st + s*nb21);
+    for (int i = lane; i < nb11/16; i += 32) {
+        k_dst[i] = k_src[i];
+    }
+    for (int i = lane; i < nb21/16; i += 32) {
+        v_dst[i] = v_src[i];
+    }
+    for (int q = lane; q < n_q; q += 32) {
+        mask_st[int64_t(q)*n_max + s] = mask[q*s31 + c];
+    }
+}
