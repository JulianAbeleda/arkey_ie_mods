+// LLAMA_SPARSE_DIRECT (local long-context mod, off by default; 1 = both parts, 2 = q8_0 rows only, 3 = lists only):
+// - q8_0 rows: calls that take the sparse MMA gather read q8_0 K/V rows by index and dequantize them in registers,
+//   so the whole-cache f16 copy and its buffer go away;
+// - lists: the sparse index lists come straight from the top-k picks of the mask's GGML_OP_TOP_K_MASK, no n_kv scan.
+// LLAMA_SPARSE_DIRECT_CHECK=N also runs the stock path on every Nth q8_0-rows call (needs GGML_CUDA_DISABLE_GRAPHS=1)
+// and aborts if the outputs differ beyond tolerance.
+static int sparse_direct_env(const char * name) {
+    const char * e = getenv(name);
+    return e ? atoi(e) : 0;
+}
+static thread_local bool sparse_direct_off = false;
+static bool sparse_direct_part(const int part) { // 1 = q8_0 rows, 2 = lists
+    static const int mode = sparse_direct_env("LLAMA_SPARSE_DIRECT");
+    return !sparse_direct_off && (mode == 1 || mode == part + 1);
+}
+
+// LLAMA_SPARSE_DIRECT: one index list per query straight from the picks of a GGML_OP_TOP_K_MASK mask, no n_kv scan.
+// The cells of the live picks and the extra cells set bits of an n_kv bitmap in shared memory, which is then walked in
+// order: the list is the ascending, duplicate-free cell list of the mask scan, at n_kv/32 words instead of n_kv halves.
+static __global__ void flash_attn_top_k_to_sparse_indices(
+        const int32_t * top_k, const float * score, const int32_t * blocks, const int32_t * extra,
+        int32_t * indices, int32_t * counts, const int n_top, const int n_pick, const int n_blk, const int n_extra,
+        const int n_kv, const int n_kv_max, const int64_t sk1, const int64_t ss1, const int64_t sb1, const int64_t se1) {
+    constexpr int nthreads = 256;
+    extern __shared__ uint32_t bits[];
+    __shared__ int offs[nthreads + 1];
+
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+    const int nw  = (n_kv + 31) / 32;
+
+    for (int i = tid; i < nw; i += nthreads) {
+        bits[i] = 0;
+    }
+    __syncthreads();
+    auto set = [&](const int32_t c) {
+        if (c >= 0 && c < n_kv) {
+            atomicOr(&bits[c / 32], 1u << (c % 32));
+        }
+    };
+    for (int i = tid; i < n_top*n_blk; i += nthreads) {
+        const int32_t p = top_k[row*sk1 + i / n_blk];
+        if (p >= 0 && p < n_pick && score[row*ss1 + p] > -INFINITY) {
+            set(blocks[i % n_blk + p*sb1]);
+        }
+    }
+    for (int i = tid; i < n_extra; i += nthreads) {
+        set(extra[i + row*se1]);
+    }
+    __syncthreads();
+
+    const int wpt = (nw + nthreads - 1) / nthreads;
+    const int w0  = min(tid*wpt, nw);
+    const int w1  = min(w0 + wpt, nw);
+    int n = 0;
+    for (int w = w0; w < w1; ++w) {
+        n += __popc(bits[w]);
+    }
+    offs[tid + 1] = n;
+    __syncthreads();
+    if (tid == 0) {
+        offs[0] = 0;
+        for (int i = 1; i <= nthreads; ++i) {
+            offs[i] += offs[i - 1];
+        }
+    }
+    __syncthreads();
+
+    int32_t * list = indices + int64_t(row)*n_kv_max;
+    int o = offs[tid];
+    for (int w = w0; w < w1; ++w) {
+        for (uint32_t m = bits[w]; m; m &= m - 1) {
+            if (o < n_kv_max) {
+                list[o] = 32*w + __ffs(m) - 1;
+            }
+            ++o;
+        }
+    }
+    const int count = min(offs[nthreads], n_kv_max);
+    for (int i = count + tid; i < n_kv_max; i += nthreads) {
+        list[i] = -1;
+    }
+    if (tid == 0) {
+        counts[row] = count;
+    }
+}
