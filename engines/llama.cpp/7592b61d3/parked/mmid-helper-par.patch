index 64de4fb27..f42c9139f 100644
--- a/ggml/src/ggml-cuda/mmid.cu
+++ b/ggml/src/ggml-cuda/mmid.cu
@@ -139,6 +139,131 @@ static __global__ void mm_ids_helper(
