diff --git a/ggml/src/ggml-cuda/weight-stream.cu b/ggml/src/ggml-cuda/weight-stream.cu
new file mode 100644
index 000000000..4e92035f9
--- /dev/null
+++ b/ggml/src/ggml-cuda/weight-stream.cu
@@ -0,0 +1,339 @@
+// LOCAL PATCH (llama-pinned-copy-stream): never upstreamed.
+// Weight streamer: uploads host-resident weights (mmap / pageable) into private device slots on a dedicated copy
+// stream, staged through a small pinned ring, so the upload of the next weight overlaps the compute of the current one.
+// The consumer waits on the slot's event on the compute stream and copies slot -> dst (D2D), so the scheduler's dst
+// (whose memory the allocator reuses across splits) is only written in stream order.
+//
+// env:
+//   GGML_CUDA_WS_RING_MIB   pinned staging ring size in MiB      (default 8: stays in the 32 MiB L3, capped at 4096)
+//   GGML_CUDA_WS_CHUNK_KIB  staging chunk size in KiB             (default 1024)
+//   GGML_CUDA_WS_THREADS    memcpy threads per chunk              (default 1)
+//   GGML_CUDA_WS_SLOTS      device slots (prefetch depth)         (default 4)
+//   GGML_CUDA_WS_PAGEABLE   1: no pinned ring; copy-stream uploads straight from the pageable source (default 0)
+
+#include "common.cuh"
+#include "weight-stream.cuh"
+#include "ggml-backend-impl.h"
+
+#include <atomic>
+#include <condition_variable>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+static int ws_env_int(const char * name, int def) {
+    const char * v = getenv(name);
+    return v ? atoi(v) : def;
+}
+
+struct ggml_cuda_ws {
+    enum state_t { FREE, QUEUED, READY };
+    struct slot_t {
+        void *       dev  = nullptr;
+        size_t       cap  = 0;
+        const void * key  = nullptr;
+        const void * host = nullptr;
+        const char * pin  = nullptr;   // pinned copy of host, if any
+        size_t       size = 0;
+        state_t      state = FREE;
+        cudaEvent_t  ready_ev = nullptr;
+        cudaEvent_t  free_ev  = nullptr;
+        bool         free_ev_recorded = false;
+    };
+
+    int device;
+    cudaStream_t copy_stream = nullptr;
+
+    char * pinned = nullptr;
+    size_t chunk  = 0;
+    int    n_chunks = 0;
+    std::vector<cudaEvent_t> chunk_ev;
+    std::vector<bool>        chunk_used;
+    int    next_chunk = 0;
+    int    n_threads  = 1;
+
+    std::vector<slot_t> slots;
+    std::deque<int>     jobs;
+
+    // v2: pinned copies of host weights made once at load (LLAMA_WS_PIN_GIB): host pointer -> pinned copy
+    char * arena = nullptr;
+    size_t arena_size = 0;
+    size_t arena_used = 0;
+    std::unordered_map<const void *, const char *> pinned_copy;
+    std::atomic<uint64_t> bytes_pinned_src{0};
+
+    std::mutex              mtx;
+    std::condition_variable cv;
+    std::thread             worker;
+
+    // stats
+    std::atomic<uint64_t> bytes{0};
+    std::atomic<uint64_t> n_consumed{0};
+    std::atomic<uint64_t> n_miss{0};
+    double wait_s = 0.0;
+    double stage_s = 0.0;
+    double chunkwait_s = 0.0;
+    uint64_t next_report = 0;
+    const bool verbose = getenv("GGML_CUDA_WS_STATS") != nullptr;
+    // GGML_CUDA_WS_PAGEABLE=1: no pinned ring, the copy stream reads the pageable source directly (driver staging)
+    const bool pageable = getenv("GGML_CUDA_WS_PAGEABLE") != nullptr && atoi(getenv("GGML_CUDA_WS_PAGEABLE")) != 0;
+
+    explicit ggml_cuda_ws(int device) : device(device) {
+        ggml_cuda_set_device(device);
+        CUDA_CHECK(cudaStreamCreateWithFlags(&copy_stream, cudaStreamNonBlocking));
+
+        const size_t ring_kib  = (size_t) std::min(4096, std::max(1, ws_env_int("GGML_CUDA_WS_RING_MIB", 8))) << 10;
+        const size_t chunk_kib = (size_t) std::max(64, ws_env_int("GGML_CUDA_WS_CHUNK_KIB", 1024));
+        chunk    = chunk_kib << 10;
+        n_chunks = (int) std::max<size_t>(2, ring_kib / chunk_kib);
+        n_threads = std::max(1, ws_env_int("GGML_CUDA_WS_THREADS", 1));
+        if (pageable) {
+            n_chunks = 0;
+        } else {
+            CUDA_CHECK(cudaHostAlloc((void **) &pinned, chunk*n_chunks, cudaHostAllocPortable));
+        }
+        chunk_ev.resize(n_chunks);
+        chunk_used.assign(n_chunks, false);
+        for (auto & e : chunk_ev) {
+            CUDA_CHECK(cudaEventCreateWithFlags(&e, cudaEventDisableTiming));
+        }
+
+        slots.resize(std::max(1, ws_env_int("GGML_CUDA_WS_SLOTS", 4)));
+        for (auto & s : slots) {
+            CUDA_CHECK(cudaEventCreateWithFlags(&s.ready_ev, cudaEventDisableTiming));
+            CUDA_CHECK(cudaEventCreateWithFlags(&s.free_ev,  cudaEventDisableTiming));
+        }
+
+        GGML_LOG_INFO("%s: weight streamer on device %d: pinned ring %d x %zu KiB, %zu device slots, %d memcpy threads\n",
+            __func__, device, n_chunks, chunk_kib, slots.size(), n_threads);
+
+        worker = std::thread([this] { loop(); });
+        worker.detach(); // lives for the process
+    }
+
+    void stage(char * dst, const char * src, size_t n) {
+        if (n_threads <= 1 || n < ((size_t) 4 << 20)) {
+            memcpy(dst, src, n);
+            return;
+        }
+        std::vector<std::thread> th;
+        const size_t per = ((n + n_threads - 1)/n_threads + 4095) & ~(size_t) 4095;
+        for (int t = 1; t < n_threads; t++) {
+            const size_t a = t*per;
+            if (a >= n) break;
+            const size_t b = std::min(n, a + per);
+            th.emplace_back([=] { memcpy(dst + a, src + a, b - a); });
+        }
+        memcpy(dst, src, std::min(n, per));
+        for (auto & x : th) x.join();
+    }
+
+    void loop() {
+        ggml_cuda_set_device(device);
+        for (;;) {
+            int si;
+            {
+                std::unique_lock<std::mutex> lock(mtx);
+                cv.wait(lock, [this] { return !jobs.empty(); });
+                si = jobs.front();
+                jobs.pop_front();
+            }
+            slot_t & s = slots[si];
+            // the previous consumer's D2D out of this slot must be done before it is overwritten
+            if (s.free_ev_recorded) {
+                CUDA_CHECK(cudaStreamWaitEvent(copy_stream, s.free_ev, 0));
+            }
+            const char * src = (const char *) s.host;
+            if (s.pin) {
+                // pinned copy made at load: DMA straight from it, no staging
+                const size_t piece = (size_t) 64 << 20;
+                for (size_t off = 0; off < s.size; off += piece) {
+                    CUDA_CHECK(cudaMemcpyAsync((char *) s.dev + off, s.pin + off, std::min(piece, s.size - off), cudaMemcpyHostToDevice, copy_stream));
+                }
+                bytes_pinned_src += s.size;
+            } else if (pageable) {
+                // the driver stages pageable memory itself; this thread blocks in it instead of the compute thread
+                const int64_t t0 = ggml_time_us();
+                for (size_t off = 0; off < s.size; off += chunk) {
+                    CUDA_CHECK(cudaMemcpyAsync((char *) s.dev + off, src + off, std::min(chunk, s.size - off), cudaMemcpyHostToDevice, copy_stream));
+                }
+                stage_s += (ggml_time_us() - t0)*1e-6;
+            }
+            for (size_t off = 0; !pageable && !s.pin && off < s.size; off += chunk) {
+                const size_t n = std::min(chunk, s.size - off);
+                const int r = next_chunk;
+                next_chunk = (next_chunk + 1) % n_chunks;
+                if (chunk_used[r]) {
+                    const int64_t t0 = ggml_time_us();
+                    CUDA_CHECK(cudaEventSynchronize(chunk_ev[r]));
+                    chunkwait_s += (ggml_time_us() - t0)*1e-6;
+                }
+                char * stg = pinned + (size_t) r*chunk;
+                const int64_t t0 = ggml_time_us();
+                stage(stg, src + off, n);
+                stage_s += (ggml_time_us() - t0)*1e-6;
+                CUDA_CHECK(cudaMemcpyAsync((char *) s.dev + off, stg, n, cudaMemcpyHostToDevice, copy_stream));
+                CUDA_CHECK(cudaEventRecord(chunk_ev[r], copy_stream));
+                chunk_used[r] = true;
+            }
+            CUDA_CHECK(cudaEventRecord(s.ready_ev, copy_stream));
+            bytes += s.size;
+            if (verbose && bytes >= next_report) {
+                next_report = bytes + (uint64_t) 20e9;
+                fprintf(stderr, "ws_stats: %.1f GB from pinned copy, ", bytes_pinned_src.load()/1e9);
+                fprintf(stderr, "ws_stats: %.1f GB staged, memcpy %.2f s (%.1f GB/s), ring-wait %.2f s, consumer wait %.2f s, consumed %llu, miss %llu\n",
+                    bytes/1e9, stage_s, bytes/1e9/std::max(stage_s, 1e-9), chunkwait_s, wait_s, (unsigned long long) n_consumed.load(), (unsigned long long) n_miss.load());
+            }
+            {
+                std::lock_guard<std::mutex> lock(mtx);
+                s.state = READY;
+            }
+            cv.notify_all();
+        }
+    }
+
+    int find(const void * key) {
+        for (size_t i = 0; i < slots.size(); i++) {
+            if (slots[i].state != FREE && slots[i].key == key) return (int) i;
+        }
+        return -1;
+    }
+
+    // called by the compute thread only
+    bool prefetch(const void * key, const void * host, size_t size) {
+        std::unique_lock<std::mutex> lock(mtx);
+        if (find(key) >= 0) {
+            return true;
+        }
+        int si = -1;
+        for (size_t i = 0; i < slots.size(); i++) {
+            if (slots[i].state == FREE) { si = (int) i; break; }
+        }
+        if (si < 0) {
+            return false;
+        }
+        slot_t & s = slots[si];
+        if (s.cap < size) {
+            // grows only while the first graphs run; cudaFree synchronizes the device
+            lock.unlock();
+            if (s.dev) {
+                if (s.free_ev_recorded) CUDA_CHECK(cudaEventSynchronize(s.free_ev));
+                CUDA_CHECK(cudaFree(s.dev));
+                s.dev = nullptr;
+            }
+            ggml_cuda_set_device(device);
+            cudaError_t err = cudaMalloc(&s.dev, size);
+            if (err != cudaSuccess) {
+                (void) cudaGetLastError();
+                s.dev = nullptr; s.cap = 0;
+                GGML_LOG_WARN("%s: cudaMalloc of a %.1f MiB slot failed, slot disabled\n", __func__, size/1048576.0);
+                return false;
+            }
+            s.cap = size;
+            s.free_ev_recorded = false;
+            lock.lock();
+        }
+        {
+            auto it = pinned_copy.find(host);
+            s.pin = it != pinned_copy.end() ? it->second : nullptr;
+        }
+        s.key = key; s.host = host; s.size = size; s.state = QUEUED;
+        jobs.push_back(si);
+        cv.notify_all();
+        return true;
+    }
+
+    bool consume(const void * key, void * dst, size_t size, cudaStream_t stream) {
+        std::unique_lock<std::mutex> lock(mtx);
+        const int si = find(key);
+        if (si < 0) {
+            n_miss++;
+            return false;
+        }
+        slot_t & s = slots[si];
+        GGML_ASSERT(s.size == size);
+        const int64_t t0 = ggml_time_us();
+        cv.wait(lock, [&s] { return s.state == READY; });
+        wait_s += (ggml_time_us() - t0)*1e-6;
+        CUDA_CHECK(cudaStreamWaitEvent(stream, s.ready_ev, 0));
+        CUDA_CHECK(cudaMemcpyAsync(dst, s.dev, size, cudaMemcpyDeviceToDevice, stream));
+        CUDA_CHECK(cudaEventRecord(s.free_ev, stream));
+        s.free_ev_recorded = true;
+        s.state = FREE;
+        s.key = nullptr;
+        n_consumed++;
+        return true;
+    }
+};
+
+// v2: copy a host weight into the pinned arena (allocated on the first call, budget_bytes). Load time only.
+bool ggml_cuda_ws_pin_impl(ggml_cuda_ws * ws, const void * host, size_t size, size_t budget_bytes) {
+    std::lock_guard<std::mutex> lock(ws->mtx);
+    if (ws->pinned_copy.count(host)) {
+        return true;
+    }
+    if (!ws->arena) {
+        ggml_cuda_set_device(ws->device);
+        if (cudaHostAlloc((void **) &ws->arena, budget_bytes, cudaHostAllocPortable) != cudaSuccess) {
+            (void) cudaGetLastError();
+            ws->arena = nullptr;
+            GGML_LOG_WARN("%s: cudaHostAlloc of %.2f GiB failed, no pinned copies\n", __func__, budget_bytes/1073741824.0);
+            return false;
+        }
+        ws->arena_size = budget_bytes;
+    }
+    const size_t aligned = (size + 4095) & ~(size_t) 4095;
+    if (ws->arena_used + aligned > ws->arena_size) {
+        return false;
+    }
+    char * dst = ws->arena + ws->arena_used;
+    // a few threads: at load nothing else runs
+    const int nt = 4;
+    const size_t per = ((size + nt - 1)/nt + 4095) & ~(size_t) 4095;
+    std::vector<std::thread> th;
+    for (int t = 0; t < nt; t++) {
+        const size_t a = t*per;
+        if (a >= size) break;
+        const size_t b = std::min(size, a + per);
+        th.emplace_back([=] { memcpy(dst + a, (const char *) host + a, b - a); });
+    }
+    for (auto & x : th) x.join();
+    ws->arena_used += aligned;
+    ws->pinned_copy[host] = dst;
+    return true;
+}
+
+static ggml_cuda_ws * ws_get(int device) {
+    static std::mutex m;
+    static ggml_cuda_ws * ws[GGML_CUDA_MAX_DEVICES] = {};
+    std::lock_guard<std::mutex> lock(m);
+    if (!ws[device]) {
+        ws[device] = new ggml_cuda_ws(device);
+    }
+    return ws[device];
+}
+
+bool ggml_backend_cuda_ws_prefetch(ggml_backend_t backend, const void * key, const void * host, size_t size) {
+    auto * ctx = (ggml_backend_cuda_context *) backend->context;
+    return ws_get(ctx->device)->prefetch(key, host, size);
+}
+
+bool ggml_backend_cuda_ws_consume(ggml_backend_t backend, const void * key, struct ggml_tensor * dst) {
+    auto * ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(ctx->device);
+    return ws_get(ctx->device)->consume(key, dst->data, ggml_nbytes(dst), ctx->stream());
+}
+
+void ggml_backend_cuda_ws_stats(ggml_backend_t backend, double * gb, double * wait_s, uint64_t * n_consumed, uint64_t * n_miss) {
+    auto * ctx = (ggml_backend_cuda_context *) backend->context;
+    auto * ws = ws_get(ctx->device);
+    *gb = ws->bytes.load()/1e9; *wait_s = ws->wait_s; *n_consumed = ws->n_consumed.load(); *n_miss = ws->n_miss.load();
+}
+
+bool ggml_backend_cuda_ws_pin(ggml_backend_t backend, const void * host, size_t size, size_t budget_bytes) {
+    auto * ctx = (ggml_backend_cuda_context *) backend->context;
+    return ggml_cuda_ws_pin_impl(ws_get(ctx->device), host, size, budget_bytes);
+}
