+// LOCAL PATCH (llama-moe-prefill): a grow-only pinned+mapped staging buffer that replaces the per-call
+// cudaHostRegister of the destination span. Registering a fresh pageable span (e.g. a 112 MiB server context
+// checkpoint) costs ~40 ms of host time while the GPU idles; copying the staged payload out costs a few ms.
+// GGML_CUDA_BATCH_GET_STAGING=0 restores the register path. It holds the largest staged span pinned (e.g. 448 MiB
+// after a 401 MiB llama-server --cache-ram prompt save), capped by GGML_CUDA_BATCH_GET_STAGING_MAX_MIB.
+struct ggml_cuda_batch_get_staging {
+    std::mutex      mutex;
+    void          * host   = nullptr;
+    unsigned char * device = nullptr;
+    size_t          size   = 0;
+
+    bool reserve(size_t need) {
+        if (need <= size) {
+            return true;
+        }
+        if (host) {
+            CUDA_CHECK(cudaFreeHost(host));
+            host = nullptr; device = nullptr; size = 0;
+        }
+        const size_t granule = 64u << 20;
+        const size_t want = (need + granule - 1) / granule * granule;
+        if (cudaHostAlloc(&host, want, cudaHostAllocMapped | cudaHostAllocPortable) != cudaSuccess) {
+            (void) cudaGetLastError();
+            host = nullptr;
+            return false;
+        }
+        if (cudaHostGetDevicePointer((void **) &device, host, 0) != cudaSuccess) {
+            (void) cudaGetLastError();
+            CUDA_CHECK(cudaFreeHost(host));
+            host = nullptr; device = nullptr;
+            return false;
+        }
+        size = want;
+        return true;
+    }
+};
+
+static ggml_cuda_batch_get_staging & ggml_cuda_batch_get_staging_get() {
+    static ggml_cuda_batch_get_staging staging;
+    return staging;
+}
+
+// largest span staged (GGML_CUDA_BATCH_GET_STAGING_MAX_MIB, default 1024); larger spans use the register path
+static size_t ggml_cuda_batch_get_staging_max() {
+    static const size_t v = [] {
+        const char * e = getenv("GGML_CUDA_BATCH_GET_STAGING_MAX_MIB");
+        return (size_t) (e ? atoll(e) : 1024) << 20;
+    }();
+    return v;
+}
+
+static bool ggml_cuda_batch_get_staging_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_CUDA_BATCH_GET_STAGING");
+        return !e || atoi(e) != 0;
+    }();
+    return enabled;
+}
+
+// copy the merged destination ranges out of the staging buffer, in parallel for large payloads
+static void ggml_cuda_batch_get_unstage(const std::vector<std::pair<uintptr_t, uintptr_t>> & ranges, uintptr_t begin,
+        const unsigned char * stage, size_t payload_bytes) {
+    std::vector<std::pair<uintptr_t, uintptr_t>> merged;
+    for (const auto & r : ranges) {
+        if (!merged.empty() && merged.back().second == r.first) {
+            merged.back().second = r.second;
+        } else {
+            merged.push_back(r);
+        }
+    }
+    const size_t chunk = 8u << 20;
+    std::vector<std::pair<uintptr_t, size_t>> work; // (dst, bytes) pieces of at most chunk bytes
+    for (const auto & r : merged) {
+        for (uintptr_t a = r.first; a < r.second; a += chunk) {
+            work.emplace_back(a, std::min<size_t>(chunk, r.second - a));
+        }
+    }
+    auto run = [&](size_t i0, size_t step) {
+        for (size_t i = i0; i < work.size(); i += step) {
+            memcpy((void *) work[i].first, stage + (work[i].first - begin), work[i].second);
+        }
+    };
+    const size_t n_threads = payload_bytes >= (32u << 20) ? std::min<size_t>(8, work.size()) : 1;
+    if (n_threads <= 1) {
+        run(0, 1);
+        return;
+    }
+    std::vector<std::thread> threads;
+    for (size_t t = 1; t < n_threads; ++t) {
+        threads.emplace_back(run, t, n_threads);
+    }
+    run(0, n_threads);
+    for (auto & th : threads) {
+        th.join();
+    }
+}
 #endif
 
