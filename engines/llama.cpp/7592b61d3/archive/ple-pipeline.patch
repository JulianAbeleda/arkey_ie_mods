+    if (raw) {
+        // gather the raw rows: token i's heads are contiguous, in the order of idx (i * n_heads + h)
+        const ggml_tensor * ple = model.per_layer_tok_embd;
+        const size_t row_bytes = ggml_row_size(ple->type, ple->ne[0]);
+        const char * base = (const char *) ple->data;
+        const size_t nb1 = ple->nb[1];
+        raw_buf.resize(idx.size() * row_bytes);
+        uint8_t * dst = raw_buf.data();
+        const int64_t n = (int64_t) idx.size();
+        static const int n_thr = [] { const char * e = getenv("LLAMA_PLE_PIPELINE_THREADS"); return e ? std::max(1, atoi(e)) : 8; }();
+        auto work = [&](int t, int stride) {
+            for (int64_t k = t; k < n; k += stride) {
+                memcpy(dst + k * row_bytes, base + (size_t) idx[k] * nb1, row_bytes);
+            }
+        };
+        if (n >= 4096 && n_thr > 1) {
+            std::vector<std::thread> th;
+            for (int t = 1; t < n_thr; ++t) th.emplace_back(work, t, n_thr);
+            work(0, n_thr);
+            for (auto & x : th) x.join();
+        } else {
+            work(0, 1);
+        }
+        ggml_backend_tensor_set(raw, raw_buf.data(), 0, raw_buf.size());
+        std::vector<int32_t> io(n_tokens);
+        for (int64_t i = 0; i < n_tokens; ++i) io[i] = (int32_t) i;
+        ggml_backend_tensor_set(iota, io.data(), 0, io.size() * sizeof(int32_t));
